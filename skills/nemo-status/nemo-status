#!/usr/bin/env bash
#
# nemo-status — Unified workspace dashboard
# Mission control for the Nemo ecosystem
# Brings together ci-tracker, skill-mastery, and health-monitor
#
# Rams Test: Innovative ✓ Useful ✓ Aesthetic ✓ Understandable ✓ 
#           Unobtrusive ✓ Honest ✓ Long-lasting ✓ Thorough ✓ 
#           Environmentally friendly ✓ Less design ✓
#

set -euo pipefail

#───────────────────────────────────────────────────────────────────────────────
# Configuration
#───────────────────────────────────────────────────────────────────────────────

readonly WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/.openclaw/workspace}"
readonly DATA_DIR="${DATA_DIR:-$HOME/.local/share/nemo-status}"

QUIET=false
JSON=false
WATCH=false
REFRESH=5

# Colors
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly CYAN='\033[0;36m'
    readonly PURPLE='\033[0;35m'
    readonly ORANGE='\033[0;33m'
    readonly GRAY='\033[0;90m'
    readonly BOLD='\033[1m'
    readonly DIM='\033[2m'
    readonly NC='\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' BLUE='' CYAN='' PURPLE='' ORANGE='' GRAY='' BOLD='' DIM='' NC=''
fi

# Activity emojis (match ci-tracker)
readonly ACTIVITY_EMOJIS=("📚" "🎨" "🔧" "✍️" "🏗️")

# Proficiency emojis (match skill-mastery)
readonly LEVEL_EMOJIS=("🌱" "🌿" "🌲" "⭐" "🌟" "👑")

#───────────────────────────────────────────────────────────────────────────────
# Helpers
#───────────────────────────────────────────────────────────────────────────────

error() {
    echo -e "${RED}✗${NC} $1" >&2
    exit 1
}

info() {
    $QUIET || echo -e "$1"
}

#───────────────────────────────────────────────────────────────────────────────
# Data Collection
#───────────────────────────────────────────────────────────────────────────────

collect_ci_data() {
    local state_file="$HOME/.local/share/ci-tracker/state.json"
    if [[ -f "$state_file" ]]; then
        cat "$state_file"
    else
        echo '{"total_cycles":0,"activities":{"research":0,"create":0,"refactor":0,"write":0,"build":0},"streak":{"current":0,"longest":0}}'
    fi
}

collect_skill_data() {
    local state_file="$HOME/.local/share/skill-mastery/mastery.json"
    if [[ -f "$state_file" ]]; then
        cat "$state_file"
    else
        echo '{"skills":{},"stats":{"total_invocations":0,"unique_skills_used":0}}'
    fi
}

collect_health_data() {
    # Quick health check - just the essentials
    local disk_usage="unknown"
    local memory_usage="unknown"
    local git_status="unknown"
    
    # Disk usage
    if command -v df &>/dev/null; then
        disk_usage=$(df -h / 2>/dev/null | tail -1 | awk '{print $5}' | sed 's/%//' || echo "?")
    fi
    
    # Memory usage
    if command -v free &>/dev/null; then
        memory_usage=$(free 2>/dev/null | grep Mem | awk '{printf "%.0f", ($3/$2) * 100}' || echo "?")
    fi
    
    # Git status
    if [[ -d "$WORKSPACE_ROOT/.git" ]]; then
        local uncommitted=$(cd "$WORKSPACE_ROOT" && git status --porcelain 2>/dev/null | wc -l)
        if [[ "$uncommitted" == "0" ]]; then
            git_status="clean"
        else
            git_status="$uncommitted uncommitted"
        fi
    fi
    
    cat << EOF
{
  "disk": $disk_usage,
  "memory": $memory_usage,
  "git": "$git_status"
}
EOF
}

collect_portfolio_data() {
    local portfolio_dir="$WORKSPACE_ROOT/nemo-portfolio/my-app/lib/art"
    local count=0
    if [[ -d "$portfolio_dir" ]]; then
        count=$(find "$portfolio_dir" -name "*.ts" -type f 2>/dev/null | wc -l)
    fi
    
    # Count skills
    local skills_count=0
    if [[ -d "$WORKSPACE_ROOT/skills" ]]; then
        skills_count=$(find "$WORKSPACE_ROOT/skills" -name "SKILL.md" -type f 2>/dev/null | wc -l)
    fi
    
    cat << EOF
{
  "algorithms": $count,
  "skills": $skills_count
}
EOF
}

#───────────────────────────────────────────────────────────────────────────────
# Visualization Helpers
#───────────────────────────────────────────────────────────────────────────────

print_mini_bar() {
    local value=$1
    local max=${2:-100}
    local width=${3:-10}
    
    if [[ "$value" == "unknown" ]] || ! [[ "$value" =~ ^[0-9]+$ ]]; then
        printf "${GRAY}%${width}s${NC}" | tr ' ' '?'
        return
    fi
    
    local filled=$(( value * width / max ))
    local empty=$(( width - filled ))
    
    local color="$GREEN"
    [[ $value -gt 70 ]] && color="$YELLOW"
    [[ $value -gt 85 ]] && color="$RED"
    
    printf "%b" "$color"
    printf '%*s' "$filled" | tr ' ' '#'
    printf '%*s' "$empty" | tr ' ' '-'
    printf "%b" "$NC"
}

print_activity_spark() {
    local values=($1)
    local blocks=("▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
    
    local max=0
    for v in "${values[@]}"; do
        (( v > max )) && max=$v
    done
    
    for v in "${values[@]}"; do
        if (( max == 0 )); then
            printf "▁"
        else
            local idx=$(( v * 7 / max ))
            idx=$(( idx > 7 ? 7 : idx ))
            printf "%s" "${blocks[$idx]}"
        fi
    done
}

#───────────────────────────────────────────────────────────────────────────────
# Dashboard Rendering
#───────────────────────────────────────────────────────────────────────────────

render_dashboard() {
    local ci_data=$(collect_ci_data)
    local skill_data=$(collect_skill_data)
    local health_data=$(collect_health_data)
    local portfolio_data=$(collect_portfolio_data)
    
    local total_cycles=$(echo "$ci_data" | grep -o '"total_cycles": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local current_streak=$(echo "$ci_data" | grep -o '"current": [0-9]*' | grep -o '[0-9]*' | head -1 || echo 0)
    local longest_streak=$(echo "$ci_data" | grep -o '"longest": [0-9]*' | grep -o '[0-9]*' | head -1 || echo 0)
    
    local total_invocations=$(echo "$skill_data" | grep -o '"total_invocations": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local unique_skills=$(echo "$skill_data" | grep -o '"unique_skills_used": [0-9]*' | grep -o '[0-9]*' || echo 0)
    
    local disk=$(echo "$health_data" | grep -o '"disk": [0-9]*' | grep -o '[0-9]*' || echo "?")
    local memory=$(echo "$health_data" | grep -o '"memory": [0-9]*' | grep -o '[0-9]*' || echo "?")
    local git=$(echo "$health_data" | grep -o '"git": "[^"]*"' | cut -d'"' -f4 || echo "?")
    
    local algorithms=$(echo "$portfolio_data" | grep -o '"algorithms": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local skills_count=$(echo "$portfolio_data" | grep -o '"skills": [0-9]*' | grep -o '[0-9]*' || echo 0)
    
    # Activity distribution for sparkline
    local research=$(echo "$ci_data" | grep -o '"research": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local create=$(echo "$ci_data" | grep -o '"create": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local refactor=$(echo "$ci_data" | grep -o '"refactor": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local write=$(echo "$ci_data" | grep -o '"write": [0-9]*' | grep -o '[0-9]*' || echo 0)
    local build=$(echo "$ci_data" | grep -o '"build": [0-9]*' | grep -o '[0-9]*' || echo 0)
    
    # Header
    echo ""
    echo -e "  ${BOLD}NEMO WORKSPACE DASHBOARD${NC} ${GRAY}$(date '+%H:%M:%S')${NC}"
    echo ""
    
    # Top row: Key metrics
    echo -e "  ${CYAN}┌─────────────┐ ┌─────────────┐ ┌─────────────┐ ┌─────────────┐${NC}"
    printf "  ${CYAN}│${NC} ${BOLD}%3d${NC} %-7s ${CYAN}│${NC} ${BOLD}%3d${NC} %-7s ${CYAN}│${NC} ${BOLD}%3d${NC} %-7s ${CYAN}│${NC} ${BOLD}%3d${NC} %-7s ${CYAN}│${NC}\n" \
        "$total_cycles" "cycles" \
        "$current_streak" "streak" \
        "$unique_skills" "skills" \
        "$algorithms" "art"
    echo -e "  ${CYAN}└─────────────┘ └─────────────┘ └─────────────┘ └─────────────┘${NC}"
    echo ""
    
    # Middle row: Activity distribution and Health
    echo -e "  ${BOLD}Activity Distribution${NC}          ${BOLD}System Health${NC}"
    echo ""
    
    # Activity bars
    local max_act=$research
    [[ $create -gt $max_act ]] && max_act=$create
    [[ $refactor -gt $max_act ]] && max_act=$refactor
    [[ $write -gt $max_act ]] && max_act=$write
    [[ $build -gt $max_act ]] && max_act=$build
    [[ $max_act -eq 0 ]] && max_act=1
    
    printf "  📚 research   "
    print_mini_bar "$research" "$max_act" 8
    printf " %3d    " "$research"
    
    # Health: Disk
    printf "  Disk "
    print_mini_bar "$disk" 100 8
    printf " %3s%%\n" "$disk"
    
    printf "  🎨 create     "
    print_mini_bar "$create" "$max_act" 8
    printf " %3d    " "$create"
    
    # Health: Memory
    printf "  Mem  "
    print_mini_bar "$memory" 100 8
    printf " %3s%%\n" "$memory"
    
    printf "  🔧 refactor   "
    print_mini_bar "$refactor" "$max_act" 8
    printf " %3d    " "$refactor"
    
    # Health: Git
    if [[ "$git" == "clean" ]]; then
        printf "  Git  ${GREEN}✓ clean${NC}\n"
    else
        printf "  Git  ${YELLOW}%s${NC}\n" "$git"
    fi
    
    printf "  ✍️  write      "
    print_mini_bar "$write" "$max_act" 8
    printf " %3d\n" "$write"
    
    printf "  🏗️  build      "
    print_mini_bar "$build" "$max_act" 8
    printf " %3d\n" "$build"
    
    echo ""
    
    # Bottom: Recent activity sparkline and insights
    if [[ $total_cycles -gt 0 ]]; then
        echo -e "  ${GRAY}Activity spark:${NC} $(print_activity_spark "$research $create $refactor $write $build")"
        echo ""
    fi
    
    # Quick insights
    local insights=()
    [[ $write -eq 0 ]] && insights+=("📓 Try a 'write' cycle (currently 0%)")
    [[ $current_streak -lt 3 && $total_cycles -gt 5 ]] && insights+=("🔥 Streak at $current_streak — keep it going!")
    [[ "$git" != "clean" ]] && insights+=("💾 Git has uncommitted changes")
    
    if [[ ${#insights[@]} -gt 0 ]]; then
        echo -e "  ${BOLD}Quick Insights${NC}"
        echo ""
        for insight in "${insights[@]}"; do
            echo "  $insight"
        done
        echo ""
    fi
    
    # Footer with commands
    echo -e "  ${GRAY}Commands: ci-tracker | skill-mastery | health | nemo sync${NC}"
    echo ""
}

render_json() {
    local ci_data=$(collect_ci_data)
    local skill_data=$(collect_skill_data)
    local health_data=$(collect_health_data)
    local portfolio_data=$(collect_portfolio_data)
    
    cat << EOF
{
  "timestamp": "$(date -Iseconds)",
  "continuous_improvement": $ci_data,
  "skill_mastery": $skill_data,
  "health": $health_data,
  "portfolio": $portfolio_data
}
EOF
}

#───────────────────────────────────────────────────────────────────────────────
# Watch Mode
#───────────────────────────────────────────────────────────────────────────────

watch_mode() {
    while true; do
        clear
        render_dashboard
        echo -e "  ${GRAY}Refreshing every ${REFRESH}s (Ctrl+C to exit)${NC}"
        sleep "$REFRESH"
    done
}

#───────────────────────────────────────────────────────────────────────────────
# Commands
#───────────────────────────────────────────────────────────────────────────────

cmd_usage() {
    cat << 'EOF'
Usage: nemo-status [command] [options]

Commands:
  (none)              Show full dashboard
  json                Output as JSON
  watch               Auto-refresh every 5 seconds
  help                Show this help

Options:
  -j, --json          Output as JSON
  -w, --watch         Watch mode (auto-refresh)
  -r, --refresh <n>   Refresh interval in seconds (default: 5)
  -q, --quiet         Minimal output

Examples:
  nemo-status              # Full dashboard
  nemo-status json         # JSON output
  nemo-status watch        # Live dashboard
  nemo-status -r 10        # Refresh every 10 seconds

Integrations:
  • ci-tracker      — Improvement cycle stats
  • skill-mastery   — Skill proficiency data
  • health-monitor  — System/workspace health
  • portfolio       — Art algorithm count

EOF
}

#───────────────────────────────────────────────────────────────────────────────
# Main
#───────────────────────────────────────────────────────────────────────────────

main() {
    declare -a ARGS=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cmd_usage
                exit 0
                ;;
            -q|--quiet)
                QUIET=true
                shift
                ;;
            -j|--json)
                JSON=true
                shift
                ;;
            -w|--watch)
                WATCH=true
                shift
                ;;
            -r|--refresh)
                REFRESH="${2:-5}"
                shift 2
                ;;
            -*)
                ARGS+=("$1")
                shift
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done
    
    set -- "${ARGS[@]}"
    
    # Handle explicit commands
    if [[ $# -gt 0 ]]; then
        case "$1" in
            json)
                JSON=true
                ;;
            watch)
                WATCH=true
                ;;
            help)
                cmd_usage
                exit 0
                ;;
        esac
    fi
    
    if $JSON; then
        render_json
    elif $WATCH; then
        watch_mode
    else
        render_dashboard
    fi
}

main "$@"
