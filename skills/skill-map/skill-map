#!/usr/bin/env bash
#
# skill-map — Visualize the skill ecosystem
# 
# Shows relationships, dependencies, and health of all skills
# in a visual tree or graph format.
#
# Usage:
#   skill-map              # Visual tree of all skills
#   skill-map --graph      # DOT format for graphviz
#   skill-map --health     # Health check with status colors
#   skill-map --deps       # Show skill dependencies
#
# Refactored: Uses skill-registry for centralized metadata
#

set -eo pipefail

SKILLS_DIR="${SKILLS_DIR:-$HOME/.openclaw/workspace/skills}"
BIN_DIR="${BIN_DIR:-$HOME/.openclaw/workspace/bin}"

# Source the registry library
REGISTRY_DIR="${REGISTRY_DIR:-$SKILLS_DIR/skill-registry}"
if [[ -f "$REGISTRY_DIR/skill-registry" ]]; then
    source "$REGISTRY_DIR/skill-registry"
fi

# Colors
RESET='\033[0m'
BOLD='\033[1m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
BLUE='\033[34m'
CYAN='\033[36m'
GRAY='\033[90m'

# Fallback if registry not available
_get_category_icon() {
    if type registry::get_category_icon &>/dev/null; then
        registry::get_category_icon "$1"
    else
        case "$1" in
            creative) echo "🎨" ;;
            dev) echo "⚙️" ;;
            system) echo "🔧" ;;
            knowledge) echo "🧠" ;;
            analysis) echo "📊" ;;
            *) echo "📦" ;;
        esac
    fi
}

_get_category_name() {
    if type registry::get_category_name &>/dev/null; then
        registry::get_category_name "$1"
    else
        case "$1" in
            creative) echo "Creative" ;;
            dev) echo "Development" ;;
            system) echo "System" ;;
            knowledge) echo "Knowledge" ;;
            analysis) echo "Analysis" ;;
            *) echo "Other" ;;
        esac
    fi
}

_get_category_color() {
    if type registry::get_category_color &>/dev/null; then
        registry::get_category_color "$1"
    else
        case "$1" in
            creative) echo "lightblue" ;;
            dev) echo "lightgreen" ;;
            system) echo "lightyellow" ;;
            knowledge) echo "lightpink" ;;
            analysis) echo "lightcoral" ;;
            *) echo "gray" ;;
        esac
    fi
}

_get_skill_category() {
    if type registry::get_category &>/dev/null; then
        registry::get_category "$1"
    else
        case "$1" in
            art-*) echo "creative" ;;
            git-*) echo "dev" ;;
            skill-*) echo "dev" ;;
            *-monitor|shell-*|env-*|ci-*) echo "system" ;;
            memory-*) echo "knowledge" ;;
            *-insights|*audit) echo "analysis" ;;
            *) echo "other" ;;
        esac
    fi
}

# Get skill info from SKILL.md
get_skill_info() {
    local skill="$1"
    local field="$2"
    local skill_file="$SKILLS_DIR/$skill/SKILL.md"
    
    [[ -f "$skill_file" ]] || return
    
    case "$field" in
        "description")
            grep -A1 "^description:" "$skill_file" 2>/dev/null | tail -1 | sed 's/.*"\(.*\)".*/\1/' 2>/dev/null || \
            grep -m1 "^# " "$skill_file" 2>/dev/null | sed 's/^# //' || echo ""
            ;;
        "has_executable")
            if [[ -x "$SKILLS_DIR/$skill/$skill" ]] || [[ -L "$BIN_DIR/$skill" ]]; then
                echo "yes"
            else
                echo "no"
            fi
            ;;
        "scripts_count")
            if [[ -d "$SKILLS_DIR/$skill/scripts" ]]; then
                ls "$SKILLS_DIR/$skill/scripts"/*.sh 2>/dev/null | wc -l
            else
                echo "0"
            fi
            ;;
    esac
}

# Discover all skills
discover_skills() {
    for skill_dir in "$SKILLS_DIR"/*/; do
        [[ -d "$skill_dir" ]] || continue
        local skill_name=$(basename "$skill_dir")
        [[ -f "$skill_dir/SKILL.md" ]] && echo "$skill_name"
    done
}

# Count skills by category
count_by_category() {
    local target_category="$1"
    local count=0
    
    while IFS= read -r skill; do
        local cat=$(_get_skill_category "$skill")
        [[ "$cat" == "$target_category" ]] && ((count++)) || true
    done < <(discover_skills)
    
    echo "$count"
}

# Get all unique categories
get_categories() {
    discover_skills | while IFS= read -r skill; do
        _get_skill_category "$skill"
    done | sort -u
}

# Visual tree output
show_tree() {
    echo -e "${BOLD}Skill Ecosystem${RESET}"
    echo -e "${GRAY}$SKILLS_DIR${RESET}\n"
    
    local total=0
    local executable=0
    
    # Get categories in priority order, then others
    local ordered_cats="creative dev system knowledge analysis"
    local all_cats=$(get_categories)
    
    for category in $ordered_cats; do
        # Check if category has skills
        local count=$(count_by_category "$category")
        [[ "$count" -eq 0 ]] && continue
        
        local icon=$(_get_category_icon "$category")
        local name=$(_get_category_name "$category")
        
        echo -e "${BOLD}$icon $name${RESET} ($count skills)"
        
        while IFS= read -r skill; do
            local skill_cat=$(_get_skill_category "$skill")
            [[ "$skill_cat" != "$category" ]] && continue
            
            local raw_desc=$(get_skill_info "$skill" "description")
            local desc=""
            if [[ "$raw_desc" == *" — "* ]]; then
                desc=$(echo "$raw_desc" | sed 's/.* — //' | sed 's/\..*//' | xargs 2>/dev/null || echo "")
            fi
            local has_exe=$(get_skill_info "$skill" "has_executable")
            local scripts=$(get_skill_info "$skill" "scripts_count")
            
            ((total++)) || true
            [[ "$has_exe" == "yes" ]] && ((executable++)) || true
            
            # Status indicator
            local status="${GREEN}✓${RESET}"
            if [[ "$has_exe" != "yes" ]]; then
                status="${RED}✗${RESET}"
            fi
            
            # Scripts indicator
            local scripts_indicator=""
            if [[ "$scripts" -gt 0 ]]; then
                scripts_indicator=" ${GRAY}(${scripts} scripts)${RESET}"
            fi
            
            printf "  %b %-20s %s%b\n" "$status" "$skill" "$desc" "$scripts_indicator" 2>/dev/null || printf "  %s %-20s\n" "$status" "$skill"
        done < <(discover_skills | sort)
        echo
    done
    
    # Handle "other" category if any
    local other_count=$(count_by_category "other")
    if [[ "$other_count" -gt 0 ]]; then
        echo -e "${BOLD}📦 Other${RESET} ($other_count skills)"
        while IFS= read -r skill; do
            local skill_cat=$(_get_skill_category "$skill")
            [[ "$skill_cat" != "other" ]] && continue
            local has_exe=$(get_skill_info "$skill" "has_executable")
            local status="${GREEN}✓${RESET}"
            [[ "$has_exe" != "yes" ]] && status="${RED}✗${RESET}"
            printf "  %b %-20s\n" "$status" "$skill"
            ((total++)) || true
            [[ "$has_exe" == "yes" ]] && ((executable++)) || true
        done < <(discover_skills | sort)
        echo
    fi
    
    # Summary
    echo -e "${GRAY}─────────────────────────${RESET}"
    echo -e "Total: $total skills | Executable: $executable | Missing: $((total - executable))"
}

# Health check with colors
show_health() {
    echo -e "${BOLD}Skill Health Check${RESET}\n"
    
    local issues=0
    
    while IFS= read -r skill; do
        local skill_dir="$SKILLS_DIR/$skill"
        local issues_list=""
        
        # Check SKILL.md exists
        if [[ ! -f "$skill_dir/SKILL.md" ]]; then
            issues_list="$issues_list missing-docs"
        fi
        
        # Check executable exists
        local has_exe="no"
        if [[ -x "$skill_dir/$skill" ]]; then
            has_exe="yes"
        elif [[ -L "$BIN_DIR/$skill" ]]; then
            if [[ -e "$BIN_DIR/$skill" ]]; then
                has_exe="yes"
            else
                issues_list="$issues_list broken-symlink"
            fi
        fi
        
        if [[ "$has_exe" == "no" && -z "$issues_list" ]]; then
            issues_list="$issues_list no-executable"
        fi
        
        # Output
        if [[ -z "$issues_list" ]]; then
            echo -e "${GREEN}✓${RESET} $skill"
        else
            echo -e "${RED}✗${RESET} $skill ${GRAY}—$issues_list${RESET}"
            ((issues++)) || true
        fi
    done < <(discover_skills | sort)
    
    echo
    if [[ $issues -eq 0 ]]; then
        echo -e "${GREEN}All skills healthy!${RESET}"
        return 0
    else
        echo -e "${YELLOW}$issues skill(s) with issues${RESET}"
        return 1
    fi
}

# Show dependencies between skills
show_deps() {
    echo -e "${BOLD}Skill Dependencies${RESET}\n"
    
    # Read from registry config if available
    if [[ -f "$REGISTRY_DIR/config.yaml" ]]; then
        echo -e "${CYAN}From registry:${RESET}"
        grep -A 100 "^dependencies:" "$REGISTRY_DIR/config.yaml" 2>/dev/null | \
            grep "^[[:space:]]*[a-z-]*:" | \
            sed 's/://g' | \
            while IFS= read -r skill; do
                local deps=$(grep -A 10 "^  $skill:" "$REGISTRY_DIR/config.yaml" | grep "^    -" | sed 's/    - //' | tr '\n' ', ' | sed 's/, $//')
                [[ -n "$deps" ]] && echo -e "  ${CYAN}$skill${RESET} → $deps"
            done
        echo
    fi
    
    echo -e "${GRAY}Meta: Skills form a self-referential ecosystem${RESET}"
}

# Graphviz DOT format
show_graph() {
    echo "digraph skills {"
    echo "  rankdir=TB;"
    echo "  node [shape=box, style=rounded];"
    echo
    
    # Category clusters
    local ordered_cats="creative dev system knowledge analysis"
    
    for category in $ordered_cats; do
        local count=$(count_by_category "$category")
        [[ "$count" -eq 0 ]] && continue
        
        local color=$(_get_category_color "$category")
        local name=$(_get_category_name "$category")
        
        echo "  subgraph cluster_$category {"
        echo "    label=\"$name\";"
        echo "    style=filled;"
        echo "    color=$color;"
        
        while IFS= read -r skill; do
            local skill_cat=$(_get_skill_category "$skill")
            [[ "$skill_cat" == "$category" ]] && echo "    \"$skill\";"
        done < <(discover_skills)
        echo "  }"
        echo
    done
    
    # Edges from registry
    if [[ -f "$REGISTRY_DIR/config.yaml" ]]; then
        echo "  // Dependencies from registry"
        local in_deps=false
        local current_skill=""
        
        while IFS= read -r line; do
            if [[ "$line" =~ ^dependencies: ]]; then
                in_deps=true
                continue
            fi
            $in_deps || continue
            [[ "$line" =~ ^[a-z] ]] && break  # End of dependencies section
            
            if [[ "$line" =~ ^[[:space:]]{2}([a-z-]+): ]]; then
                current_skill="${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^[[:space:]]{4}-[[:space:]]+([a-z-]+) ]]; then
                local dep="${BASH_REMATCH[1]}"
                echo "  \"$current_skill\" -> \"$dep\";"
            fi
        done < "$REGISTRY_DIR/config.yaml"
    fi
    
    echo "}"
}

# Main
case "${1:-}" in
    --health|-h)
        show_health
        ;;
    --deps|-d)
        show_deps
        ;;
    --graph|-g)
        show_graph
        ;;
    --help)
        echo "skill-map — Visualize the skill ecosystem"
        echo
        echo "Usage:"
        echo "  skill-map           # Visual tree of all skills"
        echo "  skill-map --health  # Health check with status colors"
        echo "  skill-map --deps    # Show skill dependencies"
        echo "  skill-map --graph   # DOT format for graphviz"
        echo
        echo "Environment:"
        echo "  SKILLS_DIR  # Default: ~/.openclaw/workspace/skills"
        ;;
    *)
        show_tree
        ;;
esac
