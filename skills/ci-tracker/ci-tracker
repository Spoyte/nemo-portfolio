Examples:
  ci-tracker status              # View statistics
  ci-tracker log research        # Log a research cycle
  ci-tracker log create "Built ci-tracker skill"
  ci-tracker auto-log            # Auto-detect and log
  ci-tracker predict             # Get activity suggestion
  ci-tracker history 10          # Last 10 cycles
  ci-tracker sync                # Import from memory

EOF
}

#───────────────────────────────────────────────────────────────────────────────
# Main
#───────────────────────────────────────────────────────────────────────────────

main() {
    declare -a ARGS=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cmd_usage
                exit 0
                ;;
            -q|--quiet)
                QUIET=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -j|--json)
                JSON=true
                shift
                ;;
            -*)
                ARGS+=("$1")
                shift
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done
    
    set -- "${ARGS[@]}"
    
    if [[ $# -eq 0 ]]; then
        cmd_status
        exit 0
    fi
    
    case "$1" in
        status)     shift; cmd_status "$@" ;;
        log)        shift; cmd_log "$@" ;;
        auto-log)   shift; cmd_auto_log "$@" ;;
        predict)    shift; cmd_predict "$@" ;;
        history)    shift; cmd_history "$@" ;;
        sync)       shift; cmd_sync "$@" ;;
        activities) cmd_activities ;;
        help)       cmd_usage ;;
        *)          error "Unknown command: $1\n\nRun 'ci-tracker help' for usage." ;;
    esac
}

main "$@"
