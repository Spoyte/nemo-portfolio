#!/usr/bin/env bash
#
# ci-tracker — Continuous Improvement Cycle Tracker
# Visualize, track, and analyze the nemo-continuous-improvement cron job
#
# Rams Test: Innovative ✓ Useful ✓ Aesthetic ✓ Understandable ✓ 
#           Unobtrusive ✓ Honest ✓ Long-lasting ✓ Thorough ✓ 
#           Environmentally friendly ✓ Less design ✓
#

set -euo pipefail

#───────────────────────────────────────────────────────────────────────────────
# Configuration
#───────────────────────────────────────────────────────────────────────────────

readonly DATA_DIR="${DATA_DIR:-$HOME/.local/share/ci-tracker}"
readonly STATE_FILE="$DATA_DIR/state.json"
readonly HISTORY_FILE="$DATA_DIR/history.jsonl"
readonly MEMORY_DIR="${MEMORY_DIR:-$HOME/.openclaw/workspace/memory}"
readonly WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/.openclaw/workspace}"
readonly CRON_JOB_ID="521b9c4a-085c-48c0-b4be-e85b4f4e0105"

QUIET=false
JSON=false
VERBOSE=false

# Colors
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly CYAN='\033[0;36m'
    readonly PURPLE='\033[0;35m'
    readonly GRAY='\033[0;90m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' BLUE='' CYAN='' PURPLE='' GRAY='' BOLD='' NC=''
fi

# Activity types
readonly ACTIVITIES=("research" "create" "refactor" "write" "build")
readonly ACTIVITY_EMOJIS=("📚" "🎨" "🔧" "✍️" "🏗️")
readonly ACTIVITY_COLORS=("$BLUE" "$PURPLE" "$YELLOW" "$CYAN" "$GREEN")

# Activity detection patterns (keywords for auto-detection)
declare -A ACTIVITY_PATTERNS=(
    ["research"]="research read source article paper blog documentation learn study investigate explore"
    ["create"]="create generative art script poem visualize draw design compose make build-new"
    ["refactor"]="refactor clean improve optimize simplify rewrite restructure reorganize polish enhance"
    ["write"]="write diary reflect journal document essay blog post entry memoir"
    ["build"]="build skill automate tool utility scaffold framework system infrastructure"
)

#───────────────────────────────────────────────────────────────────────────────
# Helpers
#───────────────────────────────────────────────────────────────────────────────

error() {
    echo -e "${RED}✗${NC} $1" >&2
    exit 1
}

info() {
    $QUIET || echo -e "$1"
}

success() {
    $QUIET || echo -e "${GREEN}✓${NC} $1"
}

#───────────────────────────────────────────────────────────────────────────────
# Data Management
#───────────────────────────────────────────────────────────────────────────────

init_data_dir() {
    mkdir -p "$DATA_DIR"
    
    if [[ ! -f "$STATE_FILE" ]]; then
        cat > "$STATE_FILE" << 'EOF'
{
  "total_cycles": 0,
  "activities": {
    "research": 0,
    "create": 0,
    "refactor": 0,
    "write": 0,
    "build": 0
  },
  "streak": {
    "current": 0,
    "longest": 0,
    "last_date": null
  },
  "first_cycle": null,
  "last_cycle": null
}
EOF
    fi
    
    if [[ ! -f "$HISTORY_FILE" ]]; then
        touch "$HISTORY_FILE"
    fi
}

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo '{}'
    fi
}

write_state() {
    echo "$1" > "$STATE_FILE"
}

#───────────────────────────────────────────────────────────────────────────────
# Activity Detection (Enhanced)
#───────────────────────────────────────────────────────────────────────────────

detect_activity_from_memory() {
    local date_str="${1:-$(date +%Y-%m-%d)}"
    local memory_file="$MEMORY_DIR/$date_str.md"
    
    if [[ ! -f "$memory_file" ]]; then
        echo "unknown"
        return
    fi
    
    # Look for continuous improvement entries (capture more lines for context)
    local content
    content=$(grep -A 15 "Continuous Improvement Cycle\|## [0-9]\{2\}:[0-9]\{2\}" "$memory_file" 2>/dev/null | head -50 || true)
    
    if [[ -z "$content" ]]; then
        echo "unknown"
        return
    fi
    
    # Score each activity type based on keyword matches
    declare -A scores
    for activity in "${ACTIVITIES[@]}"; do
        scores[$activity]=0
    done
    
    # Check for explicit Activity line first (newer format with higher weight)
    for activity in "${ACTIVITIES[@]}"; do
        if echo "$content" | grep -qE "Activity:.*\b$activity\b|\*\*$activity\*\*"; then
            scores[$activity]=$((scores[$activity] + 10))
        fi
    done
    
    # Check for keywords in content
    for activity in "${ACTIVITIES[@]}"; do
        local pattern="${ACTIVITY_PATTERNS[$activity]}"
        for keyword in $pattern; do
            local matches
            matches=$(echo "$content" | grep -ci "\b$keyword\b" 2>/dev/null || echo 0)
            # Ensure matches is a number
            matches=$(echo "$matches" | tr -d '\n' | grep -o '[0-9]*' | head -1)
            matches=${matches:-0}
            scores[$activity]=$((scores[$activity] + matches))
        done
    done
    
    # Check for file operations as hints
    if echo "$content" | grep -qE "Created.*\.ts|Created.*\.js|Created.*\.py|generative art|algorithm"; then
        scores[create]=$((scores[create] + 3))
    fi
    
    if echo "$content" | grep -qE "Refactored|reorganized|cleaned up|simplified|optimized"; then
        scores[refactor]=$((scores[refactor] + 3))
    fi
    
    if echo "$content" | grep -qE "Built.*skill|new skill|automated|scaffold"; then
        scores[build]=$((scores[build] + 3))
    fi
    
    if echo "$content" | grep -qE "Read.*article|researched|learned about|studied"; then
        scores[research]=$((scores[research] + 3))
    fi
    
    if echo "$content" | grep -qE "diary|reflected|journal|wrote about"; then
        scores[write]=$((scores[write] + 3))
    fi
    
    # Find highest scoring activity
    local max_score=0
    local detected="unknown"
    for activity in "${ACTIVITIES[@]}"; do
        if [[ ${scores[$activity]} -gt $max_score ]]; then
            max_score=${scores[$activity]}
            detected=$activity
        fi
    done
    
    # Only return if we have some confidence
    if [[ $max_score -ge 2 ]]; then
        echo "$detected"
    else
        echo "unknown"
    fi
}

# Detect activity from git diff (what files were changed)
detect_activity_from_git() {
    local since="${1:-$(date +%Y-%m-%d)}"
    
    if [[ ! -d "$WORKSPACE_ROOT/.git" ]]; then
        echo "unknown"
        return
    fi
    
    cd "$WORKSPACE_ROOT"
    
    # Get files changed today
    local files_changed
    files_changed=$(git diff --name-only HEAD "@{${since} 00:00}" 2>/dev/null || git diff --name-only HEAD~5..HEAD 2>/dev/null || echo "")
    
    if [[ -z "$files_changed" ]]; then
        echo "unknown"
        return
    fi
    
    # Score based on file types and paths
    local create_score=0 refactor_score=0 build_score=0 research_score=0 write_score=0
    
    # Art creation
    if echo "$files_changed" | grep -qE "art/.*\.(ts|js)|generative|canvas|visualization"; then
        create_score=$((create_score + 5))
    fi
    
    # Refactoring (changes to existing skills without new files)
    if echo "$files_changed" | grep -qE "skills/.*/" && ! echo "$files_changed" | grep -q "SKILL.md"; then
        refactor_score=$((refactor_score + 3))
    fi
    
    # New skills
    if echo "$files_changed" | grep -qE "skills/.*/SKILL.md"; then
        build_score=$((build_score + 5))
    fi
    
    # Documentation/research
    if echo "$files_changed" | grep -qE "\.md$|README|docs"; then
        write_score=$((write_score + 3))
    fi
    
    # Determine winner
    declare -A scores=(
        [create]=$create_score
        [refactor]=$refactor_score
        [build]=$build_score
        [research]=$research_score
        [write]=$write_score
    )
    
    local max_score=0
    local detected="unknown"
    for activity in "${ACTIVITIES[@]}"; do
        if [[ ${scores[$activity]} -gt $max_score ]]; then
            max_score=${scores[$activity]}
            detected=$activity
        fi
    done
    
    if [[ $max_score -ge 3 ]]; then
        echo "$detected"
    else
        echo "unknown"
    fi
}

#───────────────────────────────────────────────────────────────────────────────
# Visualization
#───────────────────────────────────────────────────────────────────────────────

print_sparkline() {
    local values=($1)
    local blocks=("▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
    
    # Find max
    local max=0
    for v in "${values[@]}"; do
        (( v > max )) && max=$v
    done
    
    # Normalize and print
    for v in "${values[@]}"; do
        if (( max == 0 )); then
            printf "▁"
        else
            local idx=$(( v * 7 / max ))
            printf "%s" "${blocks[$idx]}"
        fi
    done
}

print_bar() {
    local value=$1
    local max=$2
    local width=${3:-20}
    local color=${4:-$GREEN}
    
    local filled=$(( value * width / max ))
    local empty=$(( width - filled ))
    
    printf "%b" "$color"
    printf "%${filled}s" | tr ' ' '█'
    printf "%${empty}s" | tr ' ' '░'
    printf "%b" "$NC"
}

