#!/usr/bin/env bash
#
# ci-tracker — Continuous Improvement Cycle Tracker
# Visualize, track, and analyze the nemo-continuous-improvement cron job
#
# Rams Test: Innovative ✓ Useful ✓ Aesthetic ✓ Understandable ✓ 
#           Unobtrusive ✓ Honest ✓ Long-lasting ✓ Thorough ✓ 
#           Environmentally friendly ✓ Less design ✓
#

set -euo pipefail

#───────────────────────────────────────────────────────────────────────────────
# Configuration
#───────────────────────────────────────────────────────────────────────────────

readonly DATA_DIR="${DATA_DIR:-$HOME/.local/share/ci-tracker}"
readonly STATE_FILE="$DATA_DIR/state.json"
readonly HISTORY_FILE="$DATA_DIR/history.jsonl"
readonly MEMORY_DIR="${MEMORY_DIR:-$HOME/.openclaw/workspace/memory}"
readonly CRON_JOB_ID="521b9c4a-085c-48c0-b4be-e85b4f4e0105"

QUIET=false
JSON=false
VERBOSE=false

# Colors
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly CYAN='\033[0;36m'
    readonly PURPLE='\033[0;35m'
    readonly GRAY='\033[0;90m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' BLUE='' CYAN='' PURPLE='' GRAY='' BOLD='' NC=''
fi

# Activity types
readonly ACTIVITIES=("research" "create" "refactor" "write" "build")
readonly ACTIVITY_EMOJIS=("📚" "🎨" "🔧" "✍️" "🏗️")
readonly ACTIVITY_COLORS=("$BLUE" "$PURPLE" "$YELLOW" "$CYAN" "$GREEN")

#───────────────────────────────────────────────────────────────────────────────
# Helpers
#───────────────────────────────────────────────────────────────────────────────

error() {
    echo -e "${RED}✗${NC} $1" >&2
    exit 1
}

info() {
    $QUIET || echo -e "$1"
}

success() {
    $QUIET || echo -e "${GREEN}✓${NC} $1"
}

#───────────────────────────────────────────────────────────────────────────────
# Data Management
#───────────────────────────────────────────────────────────────────────────────

init_data_dir() {
    mkdir -p "$DATA_DIR"
    
    if [[ ! -f "$STATE_FILE" ]]; then
        cat > "$STATE_FILE" << 'EOF'
{
  "total_cycles": 0,
  "activities": {
    "research": 0,
    "create": 0,
    "refactor": 0,
    "write": 0,
    "build": 0
  },
  "streak": {
    "current": 0,
    "longest": 0,
    "last_date": null
  },
  "first_cycle": null,
  "last_cycle": null
}
EOF
    fi
    
    if [[ ! -f "$HISTORY_FILE" ]]; then
        touch "$HISTORY_FILE"
    fi
}

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo '{}'
    fi
}

write_state() {
    echo "$1" > "$STATE_FILE"
}

#───────────────────────────────────────────────────────────────────────────────
# Activity Detection
#───────────────────────────────────────────────────────────────────────────────

detect_activity_from_memory() {
    local date_str="${1:-$(date +%Y-%m-%d)}"
    local memory_file="$MEMORY_DIR/$date_str.md"
    
    if [[ ! -f "$memory_file" ]]; then
        echo "unknown"
        return
    fi
    
    # Look for continuous improvement entries
    local content
    content=$(grep -A 5 "Continuous Improvement Cycle" "$memory_file" 2>/dev/null || true)
    
    if [[ -z "$content" ]]; then
        echo "unknown"
        return
    fi
    
    # Detect activity type from the entry
    if echo "$content" | grep -qi "research"; then
        echo "research"
    elif echo "$content" | grep -qi "create"; then
        echo "create"
    elif echo "$content" | grep -qi "refactor"; then
        echo "refactor"
    elif echo "$content" | grep -qi "write"; then
        echo "write"
    elif echo "$content" | grep -qi "build.*skill"; then
        echo "build"
    else
        echo "unknown"
    fi
}

#───────────────────────────────────────────────────────────────────────────────
# Visualization
#───────────────────────────────────────────────────────────────────────────────

print_sparkline() {
    local values=($1)
    local blocks=("▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
    
    # Find max
    local max=0
    for v in "${values[@]}"; do
        (( v > max )) && max=$v
    done
    
    # Normalize and print
    for v in "${values[@]}"; do
        if (( max == 0 )); then
            printf "▁"
        else
            local idx=$(( v * 7 / max ))
            printf "%s" "${blocks[$idx]}"
        fi
    done
}

print_bar() {
    local value=$1
    local max=$2
    local width=${3:-20}
    local color=${4:-$GREEN}
    
    local filled=$(( value * width / max ))
    local empty=$(( width - filled ))
    
    printf "%b" "$color"
    printf "%${filled}s" | tr ' ' '█'
    printf "%${empty}s" | tr ' ' '░'
    printf "%b" "$NC"
}

#───────────────────────────────────────────────────────────────────────────────
# Commands
#───────────────────────────────────────────────────────────────────────────────

cmd_status() {
    init_data_dir
    local state
    state=$(read_state)
    
    if $JSON; then
        echo "$state"
        return
    fi
    
    local total
    total=$(echo "$state" | grep -o '"total_cycles": [0-9]*' | grep -o '[0-9]*')
    total=${total:-0}
    
    local current_streak
    current_streak=$(echo "$state" | grep -o '"current": [0-9]*' | grep -o '[0-9]*' | head -1)
    current_streak=${current_streak:-0}
    
    local longest_streak
    longest_streak=$(echo "$state" | grep -o '"longest": [0-9]*' | grep -o '[0-9]*' | head -1)
    longest_streak=${longest_streak:-0}
    
    local first_cycle
    first_cycle=$(echo "$state" | grep -o '"first_cycle": "[^"]*"' | cut -d'"' -f4)
    first_cycle=${first_cycle:-"never"}
    
    local last_cycle
    last_cycle=$(echo "$state" | grep -o '"last_cycle": "[^"]*"' | cut -d'"' -f4)
    last_cycle=${last_cycle:-"never"}
    
    echo ""
    echo -e "  ${BOLD}Continuous Improvement Cycle${NC}"
    echo ""
    echo -e "  ${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Stats grid
    printf "  %-20s ${BOLD}%s${NC}\n" "Total Cycles:" "$total"
    printf "  %-20s ${GREEN}%s${NC}\n" "Current Streak:" "$current_streak"
    printf "  %-20s ${YELLOW}%s${NC}\n" "Longest Streak:" "$longest_streak"
    echo ""
    printf "  %-20s %s\n" "First Cycle:" "$first_cycle"
    printf "  %-20s %s\n" "Last Cycle:" "$last_cycle"
    
    echo ""
    echo -e "  ${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Activity breakdown
    if [[ $total -gt 0 ]]; then
        echo -e "  ${BOLD}Activity Distribution${NC}"
        echo ""
        
        local max_count=0
        for i in "${!ACTIVITIES[@]}"; do
            local activity="${ACTIVITIES[$i]}"
            local count
            count=$(echo "$state" | grep -o "\"$activity\": [0-9]*" | grep -o '[0-9]*')
            count=${count:-0}
            (( count > max_count )) && max_count=$count
        done
        
        for i in "${!ACTIVITIES[@]}"; do
            local activity="${ACTIVITIES[$i]}"
            local emoji="${ACTIVITY_EMOJIS[$i]}"
            local color="${ACTIVITY_COLORS[$i]}"
            local count
            count=$(echo "$state" | grep -o "\"$activity\": [0-9]*" | grep -o '[0-9]*')
            count=${count:-0}
            
            local pct=0
            (( total > 0 )) && pct=$(( count * 100 / total ))
            
            printf "  %s %-12s " "$emoji" "$activity"
            print_bar "$count" "$max_count" 15 "$color"
            printf " ${BOLD}%3d${NC} (%d%%)\n" "$count" "$pct"
        done
    fi
    
    echo ""
    
    # Today's status
    local today
    today=$(date +%Y-%m-%d)
    local today_activity
    today_activity=$(detect_activity_from_memory "$today")
    
    if [[ "$today_activity" != "unknown" ]]; then
        success "Today's cycle complete: $today_activity"
    else
        echo -e "  ${YELLOW}⚠${NC} No cycle recorded today"
    fi
    
    echo ""
}

cmd_log() {
    local activity="${1:-}"
    local notes="${2:-}"
    
    if [[ -z "$activity" ]]; then
        error "Usage: ci-tracker log <activity> [notes]"
    fi
    
    # Validate activity
    local valid=false
    for a in "${ACTIVITIES[@]}"; do
        [[ "$a" == "$activity" ]] && valid=true
    done
    
    if ! $valid; then
        error "Invalid activity: $activity\nValid: ${ACTIVITIES[*]}"
    fi
    
    init_data_dir
    
    local state
    state=$(read_state)
    local today
    today=$(date +%Y-%m-%d)
    local now
    now=$(date -Iseconds)
    
    # Update state
    local total
    total=$(echo "$state" | grep -o '"total_cycles": [0-9]*' | grep -o '[0-9]*')
    total=${total:-0}
    ((total++))
    
    # Update activity count
    local activity_count
    activity_count=$(echo "$state" | grep -o "\"$activity\": [0-9]*" | grep -o '[0-9]*')
    activity_count=${activity_count:-0}
    ((activity_count++))
    
    # Update streak
    local last_date
    last_date=$(echo "$state" | grep -o '"last_date": "[^"]*"' | cut -d'"' -f4)
    
    local current_streak=1
    local longest_streak
    longest_streak=$(echo "$state" | grep -o '"longest": [0-9]*' | grep -o '[0-9]*' | head -1)
    longest_streak=${longest_streak:-0}
    
    if [[ "$last_date" == "$(date -d 'yesterday' +%Y-%m-%d 2>/dev/null || date -v-1d +%Y-%m-%d)" ]]; then
        current_streak=$(echo "$state" | grep -o '"current": [0-9]*' | grep -o '[0-9]*' | head -1)
        current_streak=${current_streak:-0}
        ((current_streak++))
    fi
    
    (( current_streak > longest_streak )) && longest_streak=$current_streak
    
    # Build new state
    local first_cycle
    first_cycle=$(echo "$state" | grep -o '"first_cycle": "[^"]*"' | cut -d'"' -f4)
    first_cycle=${first_cycle:-$today}
    
    local new_state
    new_state=$(cat << EOF
{
  "total_cycles": $total,
  "activities": {
    "research": $(echo "$state" | grep -o '"research": [0-9]*' | grep -o '[0-9]*' || echo 0),
    "create": $(echo "$state" | grep -o '"create": [0-9]*' | grep -o '[0-9]*' || echo 0),
    "refactor": $(echo "$state" | grep -o '"refactor": [0-9]*' | grep -o '[0-9]*' || echo 0),
    "write": $(echo "$state" | grep -o '"write": [0-9]*' | grep -o '[0-9]*' || echo 0),
    "build": $(echo "$state" | grep -o '"build": [0-9]*' | grep -o '[0-9]*' || echo 0)
  },
  "streak": {
    "current": $current_streak,
    "longest": $longest_streak,
    "last_date": "$today"
  },
  "first_cycle": "$first_cycle",
  "last_cycle": "$today"
}
EOF
)
    
    # Update the activity count in new_state
    new_state=$(echo "$new_state" | sed "s/\"$activity\": [0-9]*/\"$activity\": $activity_count/")
    
    write_state "$new_state"
    
    # Append to history
    echo "{\"timestamp\":\"$now\",\"activity\":\"$activity\",\"notes\":\"${notes//\"/\\\"}\"}" >> "$HISTORY_FILE"
    
    success "Logged: $activity (cycle #$total)"
}

cmd_history() {
    local limit="${1:-20}"
    
    init_data_dir
    
    if [[ ! -f "$HISTORY_FILE" ]] || [[ ! -s "$HISTORY_FILE" ]]; then
        info "No history recorded yet."
        return
    fi
    
    if $JSON; then
        echo "["
        local first=true
        tail -n "$limit" "$HISTORY_FILE" | while read -r line; do
            if $first; then
                first=false
            else
                echo ","
            fi
            echo -n "  $line"
        done
        echo ""
        echo "]"
        return
    fi
    
    echo ""
    echo -e "  ${BOLD}Recent Cycles${NC}"
    echo ""
    
    tail -n "$limit" "$HISTORY_FILE" | while read -r line; do
        local timestamp activity notes
        timestamp=$(echo "$line" | grep -o '"timestamp":"[^"]*"' | cut -d'"' -f4 | cut -d'T' -f1)
        activity=$(echo "$line" | grep -o '"activity":"[^"]*"' | cut -d'"' -f4)
        notes=$(echo "$line" | grep -o '"notes":"[^"]*"' | cut -d'"' -f4)
        
        local emoji=""
        for i in "${!ACTIVITIES[@]}"; do
            [[ "${ACTIVITIES[$i]}" == "$activity" ]] && emoji="${ACTIVITY_EMOJIS[$i]}"
        done
        
        printf "  ${GRAY}%s${NC} %s %-10s" "$timestamp" "$emoji" "$activity"
        [[ -n "$notes" ]] && printf " — %s" "$notes"
        echo ""
    done
    
    echo ""
}

cmd_sync() {
    init_data_dir
    
    info "Syncing cycles from memory files..."
    
    local count=0
    for memory_file in "$MEMORY_DIR"/2026-*.md; do
        [[ -f "$memory_file" ]] || continue
        
        local date_str
        date_str=$(basename "$memory_file" .md)
        
        # Check if already logged
        if grep -q "\"timestamp\":\"$date_str" "$HISTORY_FILE" 2>/dev/null; then
            continue
        fi
        
        local activity
        activity=$(detect_activity_from_memory "$date_str")
        
        if [[ "$activity" != "unknown" ]]; then
            # Log it
            local now="${date_str}T12:00:00+08:00"
            echo "{\"timestamp\":\"$now\",\"activity\":\"$activity\",\"notes\":\"auto-sync\"}" >> "$HISTORY_FILE"
            ((count++))
        fi
    done
    
    # Rebuild state from history
    if [[ $count -gt 0 ]]; then
        local total=0
        declare -A activity_counts
        for a in "${ACTIVITIES[@]}"; do
            activity_counts[$a]=0
        done
        
        while read -r line; do
            ((total++))
            local activity
            activity=$(echo "$line" | grep -o '"activity":"[^"]*"' | cut -d'"' -f4)
            activity_counts[$activity]=$((${activity_counts[$activity]:-0} + 1))
        done < "$HISTORY_FILE"
        
        local new_state
        new_state=$(cat << EOF
{
  "total_cycles": $total,
  "activities": {
    "research": ${activity_counts[research]:-0},
    "create": ${activity_counts[create]:-0},
    "refactor": ${activity_counts[refactor]:-0},
    "write": ${activity_counts[write]:-0},
    "build": ${activity_counts[build]:-0}
  },
  "streak": {
    "current": 0,
    "longest": 0,
    "last_date": null
  },
  "first_cycle": null,
  "last_cycle": null
}
EOF
)
        write_state "$new_state"
    fi
    
    success "Synced $count cycles from memory files"
}

cmd_activities() {
    echo ""
    echo -e "  ${BOLD}The Five Activities${NC}"
    echo ""
    
    for i in "${!ACTIVITIES[@]}"; do
        local activity="${ACTIVITIES[$i]}"
        local emoji="${ACTIVITY_EMOJIS[$i]}"
        local color="${ACTIVITY_COLORS[$i]}"
        
        printf "  %b%s %-12s${NC}" "$color" "$emoji" "$activity"
        
        case "$activity" in
            research)
                echo "Read multiple sources, synthesize insights"
                ;;
            create)
                echo "Generative art, utility script, documentation, poem"
                ;;
            refactor)
                echo "Make it cleaner, more elegant, more Rams-like"
                ;;
            write)
                echo "Reflect on recent work, questions, discoveries"
                ;;
            build)
                echo "Identify a pattern, automate it"
                ;;
        esac
    done
    
    echo ""
}

cmd_usage() {
    cat << 'EOF'
Usage: ci-tracker <command> [options]

Commands:
  status              Show current cycle statistics
  log <activity>      Log a completed cycle
  history [n]         Show last n cycles (default: 20)
  sync                Sync cycles from memory files
  activities          Show the five activity types
  help                Show this help message

Options:
  -j, --json          Output as JSON
  -q, --quiet         Minimal output
  -v, --verbose       Verbose output

Activities:
  research    Read multiple sources, synthesize insights
  create      Generative art, utility script, documentation
  refactor    Make it cleaner, more elegant, more Rams-like
  write       Reflect on recent work, questions, discoveries
  build       Identify a pattern, automate it

Examples:
  ci-tracker status              # View statistics
  ci-tracker log research        # Log a research cycle
  ci-tracker log create "Built ci-tracker skill"
  ci-tracker history 10          # Last 10 cycles
  ci-tracker sync                # Import from memory

EOF
}

#───────────────────────────────────────────────────────────────────────────────
# Main
#───────────────────────────────────────────────────────────────────────────────

main() {
    declare -a ARGS=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cmd_usage
                exit 0
                ;;
            -q|--quiet)
                QUIET=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -j|--json)
                JSON=true
                shift
                ;;
            -*)
                ARGS+=("$1")
                shift
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done
    
    set -- "${ARGS[@]}"
    
    if [[ $# -eq 0 ]]; then
        cmd_status
        exit 0
    fi
    
    case "$1" in
        status)     shift; cmd_status "$@" ;;
        log)        shift; cmd_log "$@" ;;
        history)    shift; cmd_history "$@" ;;
        sync)       shift; cmd_sync "$@" ;;
        activities) cmd_activities ;;
        help)       cmd_usage ;;
        *)          error "Unknown command: $1\n\nRun 'ci-tracker help' for usage." ;;
    esac
}

main "$@"
