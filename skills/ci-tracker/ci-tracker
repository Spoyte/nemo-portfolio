    echo ""
    echo -e "  ${BOLD}The Five Activities${NC}"
    echo ""
    
    for i in "${!ACTIVITIES[@]}"; do
        local activity="${ACTIVITIES[$i]}"
        local emoji="${ACTIVITY_EMOJIS[$i]}"
        local color="${ACTIVITY_COLORS[$i]}"
        
        printf "  %b%s %-12s${NC}" "$color" "$emoji" "$activity"
        
        case "$activity" in
            research)
                echo "Read multiple sources, synthesize insights"
                ;;
            create)
                echo "Generative art, utility script, documentation, poem"
                ;;
            refactor)
                echo "Make it cleaner, more elegant, more Rams-like"
                ;;
            write)
                echo "Reflect on recent work, questions, discoveries"
                ;;
            build)
                echo "Identify a pattern, automate it"
                ;;
        esac
    done
    
    echo ""
}

cmd_auto_log() {
    init_data_dir
    
    local today
    today=$(date +%Y-%m-%d)
    
    # Check if already logged today
    if grep -q "\"timestamp\":\"$today" "$HISTORY_FILE" 2>/dev/null; then
        local existing
        existing=$(grep "\"timestamp\":\"$today" "$HISTORY_FILE" | tail -1)
        local existing_activity
        existing_activity=$(echo "$existing" | grep -o '"activity":"[^"]*"' | cut -d'"' -f4)
        info "Already logged today: $existing_activity"
        return 0
    fi
    
    # Detect from memory
    local activity
    activity=$(detect_activity_from_memory "$today")
    local detection_method="memory"
    
    # Fallback to git detection
    if [[ "$activity" == "unknown" ]]; then
        activity=$(detect_activity_from_git "$today")
        detection_method="git"
    fi
    
    if [[ "$activity" == "unknown" ]]; then
        error "Could not detect activity. Use 'ci-tracker log <activity>' to manually log."
    fi
    
    # Log with detection method noted
    cmd_log "$activity" "auto-detected via $detection_method"
}

cmd_predict() {
    # Analyze patterns and suggest next activity
    init_data_dir
    
    local state
    state=$(read_state)
    
    # Find least used activity
    declare -A counts
    local min_count=999
    local suggested=""
    
    for activity in "${ACTIVITIES[@]}"; do
        local count
        count=$(echo "$state" | grep -o "\"$activity\": [0-9]*" | grep -o '[0-9]*')
        count=${count:-0}
        counts[$activity]=$count
        
        if [[ $count -lt $min_count ]]; then
            min_count=$count
            suggested=$activity
        fi
    done
    
    # Check for zero activities (never done)
    local never_done=()
    for activity in "${ACTIVITIES[@]}"; do
        if [[ ${counts[$activity]} -eq 0 ]]; then
            never_done+=("$activity")
        fi
    done
    
    echo ""
    echo -e "  ${BOLD}Activity Prediction${NC}"
    echo ""
    
    if [[ ${#never_done[@]} -gt 0 ]]; then
        echo -e "  ${YELLOW}Never tried:${NC} ${never_done[*]}"
        suggested=${never_done[0]}
    fi
    
    local emoji=""
    for i in "${!ACTIVITIES[@]}"; do
        [[ "${ACTIVITIES[$i]}" == "$suggested" ]] && emoji="${ACTIVITY_EMOJIS[$i]}"
    done
    
    echo -e "  Suggested: $emoji ${BOLD}$suggested${NC} (count: $min_count)"
    echo ""
    
    # Show distribution
    echo -e "  ${GRAY}Current distribution:${NC}"
    for activity in "${ACTIVITIES[@]}"; do
        printf "    %-12s: %d\n" "$activity" "${counts[$activity]}"
    done
    echo ""
}

