def print_gaps(gaps: list) -> None:
    """Print only gaps/opportunities."""
    if not gaps:
        print("\n  No significant gaps found!")
        return
    
    print()
    print("┌" + "─" * 53 + "┐")
    print("│  Portfolio Gaps & Opportunities                     │")
    print("├" + "─" * 53 + "┤")
    
    current_category = None
    for gap in gaps[:10]:
        if gap["category"] != current_category:
            current_category = gap["category"]
            cat_line = f"  {current_category.upper()}"
            padding = 53 - len(cat_line) - 2
            print(f"│{cat_line}{' ' * padding}│")
        
        title = gap["title"][:28]
        score = gap["potential"]
        line = f"    • {title} [P{score}]"
        padding = 53 - len(line) - 2
        print(f"│{line}{' ' * padding}│")
    
    print("└" + "─" * 53 + "┘")
    print()


def print_category_analysis(registry: dict, category: str) -> None:
    """Print analysis for a specific category."""
    categories = registry.get("categories", {})
    count = categories.get(category.lower(), 0)
    
    print(f"\n  Category: {category.upper()}")
    print(f"  Current pieces: {count}")
    print(f"  Target: {CATEGORIES.get(category.lower(), {}).get('expected', '?')}")
    print()
    
    gaps = [g for g in GAPS.get(category.lower(), [])]
    if gaps:
        print("  Suggested additions:")
        for gap in gaps:
            print(f"    • {gap['title']} (potential: {gap['potential']}/10)")
            print(f"      {gap['desc']}")
    print()


def export_json(registry: dict, gaps: list) -> None:
    """Export analysis as JSON."""
    output = {
        "total": registry.get("total", 0),
        "categories": registry.get("categories", {}),
        "gaps": gaps[:10],
        "summary": {
            "total_gaps": len(gaps),
            "underrepresented": [
                cat for cat, info in CATEGORIES.items()
                if registry.get("categories", {}).get(cat, 0) < info["expected"]
            ]
        }
    }
    print(json.dumps(output, indent=2))


def print_help() -> None:
    """Print help message."""
    print(__doc__)


def main():
    args = sys.argv[1:]
    
    if "--help" in args or "-h" in args:
        print_help()
        return
    
    # Parse registry
    registry = parse_registry()
    
    if "error" in registry:
        print(f"Error: {registry['error']}", file=sys.stderr)
        sys.exit(1)
    
    # Calculate gaps
    gaps = calculate_gaps(registry)
    
    # Handle flags
    if "--json" in args:
        export_json(registry, gaps)
    elif "--stats" in args:
        print_stats(registry)
    elif "--gaps" in args:
        print_gaps(gaps)
    elif "--category" in args:
        idx = args.index("--category")
        if idx + 1 < len(args):
            print_category_analysis(registry, args[idx + 1])
        else:
            print("Error: --category requires a category name", file=sys.stderr)
            sys.exit(1)
    else:
        print_full_analysis(registry, gaps)


if __name__ == "__main__":
    main()
