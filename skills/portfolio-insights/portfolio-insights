def parse_registry() -> dict[str, Any]:
    """Parse the TypeScript registry to extract category counts."""
    if not REGISTRY_FILE.exists():
        return {"error": "Registry file not found"}
    
    content = REGISTRY_FILE.read_text()
    
    # Count pieces per category from the import comments
    category_counts = {}
    category_pattern = r'=== ([A-Z]+) \((\d+)\) ==='
    
    for match in re.finditer(category_pattern, content):
        category = match.group(1).lower()
        count = int(match.group(2))
        category_counts[category] = count
    
    # Also count actual files in lib/art/ (excluding non-generator files)
    if ART_DIR.exists():
        all_files = list(ART_DIR.glob("*.ts"))
        # Filter out non-generator files
        exclude = {'core.ts', 'index.ts', 'metadata.ts', 'statistics.ts', 'thumbnails.ts', 
                   'favorites.ts', 'types.ts'}
        generator_files = [f for f in all_files if f.name not in exclude]
        total_files = len(generator_files)
    else:
        total_files = sum(category_counts.values())
    
    return {
        "categories": category_counts,
        "total": total_files,
        "files": total_files,
    }


def calculate_gaps(registry: dict) -> list[dict]:
    """Calculate opportunity gaps based on category counts."""
    gaps = []
    categories = registry.get("categories", {})
    
    for category, info in CATEGORIES.items():
        current = categories.get(category, 0)
        expected = info["expected"]
        
        if current < expected:
            deficit = expected - current
            gap_list = GAPS.get(category, [])
            
            for gap in gap_list[:deficit]:
                gaps.append({
                    "category": category,
                    "category_desc": info["description"],
                    **gap,
                    "priority": gap["potential"] * deficit  # Higher priority for bigger gaps
                })
    
    # Sort by priority (potential * deficit)
    gaps.sort(key=lambda x: x["priority"], reverse=True)
    return gaps


def format_bar(value: int, max_val: int, width: int = 40) -> str:
    """Create an ASCII bar chart."""
    if max_val == 0:
        return ""
    filled = int((value / max_val) * width)
    return "█" * filled + "░" * (width - filled)


def print_stats(registry: dict) -> None:
    """Print quick statistics."""
    categories = registry.get("categories", {})
    total = registry.get("total", 0)
    
    print(f"\n  Total generators: {total}")
    print(f"  Categories: {len(categories)}")
    print()
    
    max_count = max(categories.values()) if categories else 1
    
    for cat, count in sorted(categories.items(), key=lambda x: -x[1]):
        bar = format_bar(count, max_count, 30)
        print(f"  {cat:12} {bar} {count:3}")
    print()


