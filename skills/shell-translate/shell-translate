#!/usr/bin/env bash
#
# shell-translate: Natural language → Shell command
# Usage: shell-translate "description" [options]
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Default options
COPY_TO_CLIPBOARD=false
EXECUTE=false
SHOW_ALTERNATIVES=false
VERBOSE=false

# Show usage
usage() {
    cat << 'EOF'
Usage: shell-translate "description" [options]

Translate natural language descriptions into shell commands.

Arguments:
  description    Natural language description of what you want to do

Options:
  -c, --copy     Copy the command to clipboard
  -x, --execute  Execute the command immediately (use with caution!)
  -a, --alternatives  Show multiple alternative approaches
  -v, --verbose  Show explanations and flag descriptions
  -h, --help     Show this help message

Examples:
  shell-translate "find all Python files modified today"
  shell-translate "show disk usage sorted by size" -c
  shell-translate "kill process on port 3000" -x
  shell-translate "search for TODO in code" -a

EOF
}

# Parse arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--copy)
                COPY_TO_CLIPBOARD=true
                shift
                ;;
            -x|--execute)
                EXECUTE=true
                shift
                ;;
            -a|--alternatives)
                SHOW_ALTERNATIVES=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}" >&2
                usage
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # Remaining arguments form the description
    if [[ $# -eq 0 ]]; then
        echo -e "${RED}Error: No description provided${NC}" >&2
        usage
        exit 1
    fi
    
    DESCRIPTION="$*"
}

# Pattern database - associative array
# Keys are lowercase, space-normalized patterns
# Values are the corresponding commands
declare -A PATTERNS
