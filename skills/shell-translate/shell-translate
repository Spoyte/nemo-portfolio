            echo "  ${PATTERNS[$key]}"
        fi
    done | sort -u
    
    echo ""
    echo -e "${BLUE}Process Operations:${NC}"
    for key in "${!PATTERNS[@]}"; do
        if [[ "$key" == *"process"* ]] || [[ "$key" == *"kill"* ]] || [[ "$key" == *"port"* ]]; then
            echo "  ${PATTERNS[$key]}"
        fi
    done | sort -u
    
    echo ""
    echo -e "${BLUE}Search Operations:${NC}"
    for key in "${!PATTERNS[@]}"; do
        if [[ "$key" == *"search"* ]] || [[ "$key" == *"find"* ]] || [[ "$key" == *"grep"* ]]; then
            echo "  ${PATTERNS[$key]}"
        fi
    done | sort -u
    
    exit 0
fi

main "$@"
