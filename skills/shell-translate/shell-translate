PATTERNS["backup directory with timestamp"]="tar -czvf backup_\$(date +%Y%m%d_%H%M%S).tar.gz directory/"
EXPLANATIONS["backup directory with timestamp"]="Archive with timestamp"

# Docker operations
PATTERNS["list running docker containers"]="docker ps"
EXPLANATIONS["list running docker containers"]="Show active containers"

PATTERNS["list all docker containers"]="docker ps -a"
EXPLANATIONS["list all docker containers"]="Show all containers including stopped"

