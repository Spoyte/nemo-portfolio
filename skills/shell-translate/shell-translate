# Development helpers
PATTERNS["start simple http server"]="python3 -m http.server 8000"
EXPLANATIONS["start simple http server"]="Serve current directory on port 8000"

PATTERNS["start python http server"]="python3 -m http.server 8000"
EXPLANATIONS["start python http server"]="Serve current directory on port 8000"

PATTERNS["format json file"]="cat file.json | python3 -m json.tool"
EXPLANATIONS["format json file"]="Pretty-print JSON file"

PATTERNS["watch file changes"]="watch -n 1 'command'"
EXPLANATIONS["watch file changes"]="Run command every 1 second"

# Normalize description for matching
normalize() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9 ]/ /g' | tr -s ' ' | sed 's/^ *//;s/ *$//'
}

# Calculate simple similarity score (0-100)
similarity() {
    local str1="$1"
    local str2="$2"
    
    # Convert to word arrays
    read -ra words1 <<< "$str1"
    read -ra words2 <<< "$str2"
    
    local matches=0
    for w1 in "${words1[@]}"; do
        for w2 in "${words2[@]}"; do
            if [[ "$w1" == "$w2" ]]; then
                ((matches++))
                break
            fi
        done
    done
    
    local max_len=${#words1[@]}
    if [[ ${#words2[@]} -gt $max_len ]]; then
        max_len=${#words2[@]}
    fi
    
    if [[ $max_len -eq 0 ]]; then
        echo 0
        return
    fi
    
    echo $(( matches * 100 / max_len ))
}

# Find best matching pattern
find_match() {
    local query="$1"
    local best_match=""
    local best_score=0
    local min_threshold=30  # Minimum similarity to consider a match
    
    for pattern in "${!PATTERNS[@]}"; do
        local score=$(similarity "$query" "$pattern")
        if [[ $score -gt $best_score && $score -ge $min_threshold ]]; then
            best_score=$score
            best_match="$pattern"
        fi
    done
    
    echo "$best_match"
}

# Find all matches above threshold
find_all_matches() {
    local query="$1"
    local min_threshold=25
    local matches=()
    
    for pattern in "${!PATTERNS[@]}"; do
        local score=$(similarity "$query" "$pattern")
        if [[ $score -ge $min_threshold ]]; then
            matches+=("$score:$pattern")
        fi
    done
    
    # Sort by score (descending)
    IFS=$'\n' sorted=($(sort -t: -k1 -nr <<< "${matches[*]}"))
    unset IFS
    
    printf '%s\n' "${sorted[@]}"
}

# Copy to clipboard
copy_to_clipboard() {
    local cmd="$1"
    if command -v xclip &> /dev/null; then
        echo -n "$cmd" | xclip -selection clipboard
        return 0
    elif command -v pbcopy &> /dev/null; then
        echo -n "$cmd" | pbcopy
        return 0
    elif command -v wl-copy &> /dev/null; then
        echo -n "$cmd" | wl-copy
        return 0
    fi
    return 1
}

# Check if command is destructive
is_destructive() {
    local cmd="$1"
    if [[ "$cmd" == *"kill"* ]] || [[ "$cmd" == *"rm -"* ]] || [[ "$cmd" == *"delete"* ]] || [[ "$cmd" == *"drop"* ]] || [[ "$cmd" == *"prune"* ]] || [[ "$cmd" == *"reset --hard"* ]]; then
        return 0
    fi
    return 1
}

# Main execution
main() {
    parse_args "$@"
    
    local normalized_query
    normalized_query=$(normalize "$DESCRIPTION")
    
    echo -e "${GRAY}Query: $DESCRIPTION${NC}"
    echo ""
    
    if $SHOW_ALTERNATIVES; then
        # Show multiple matches
        echo -e "${BLUE}Alternative commands:${NC}"
        echo ""
        
        local count=0
        while IFS=: read -r score pattern; do
            [[ -z "$pattern" ]] && continue
            ((count++))
            
            local cmd="${PATTERNS[$pattern]}"
            local expl="${EXPLANATIONS[$pattern]:-}"
            
            echo -e "${GREEN}$count.${NC} $cmd"
            if $VERBOSE && [[ -n "$expl" ]]; then
                echo -e "   ${GRAY}$expl${NC}"
            fi
            echo ""
            
            if [[ $count -ge 5 ]]; then
                break
            fi
        done < <(find_all_matches "$normalized_query")
        
        if [[ $count -eq 0 ]]; then
            echo -e "${YELLOW}No matching patterns found.${NC}"
            echo "Try: shell-translate list  # to see all available patterns"
        fi
    else
        # Show best match
        local match
        match=$(find_match "$normalized_query")
        
        if [[ -z "$match" ]]; then
            echo -e "${YELLOW}No exact match found for: $DESCRIPTION${NC}"
            echo ""
            echo "Similar patterns:"
            local count=0
            while IFS=: read -r score pattern; do
                [[ -z "$pattern" ]] && continue
                ((count++))
                echo -e "  ${GREEN}$count.${NC} ${PATTERNS[$pattern]}"
                if [[ $count -ge 3 ]]; then
                    break
                fi
            done < <(find_all_matches "$normalized_query")
            
            if [[ $count -eq 0 ]]; then
                echo "  (none found)"
                echo ""
                echo "Available categories: files, git, process, search, system, archive, network, backup, docker, dev"
            fi
            exit 1
        fi
        
        local cmd="${PATTERNS[$match]}"
        local expl="${EXPLANATIONS[$match]:-}"
        
        # Output the command
        echo -e "${GREEN}$cmd${NC}"
        
        if $VERBOSE && [[ -n "$expl" ]]; then
            echo ""
            echo -e "${GRAY}$expl${NC}"
        fi
        
        # Copy to clipboard if requested
        if $COPY_TO_CLIPBOARD; then
            if copy_to_clipboard "$cmd"; then
                echo ""
                echo -e "${BLUE}📋 Copied to clipboard${NC}"
            else
                echo ""
                echo -e "${YELLOW}⚠️ No clipboard utility found (install xclip, pbcopy, or wl-copy)${NC}"
            fi
        fi
        
        # Execute if requested
        if $EXECUTE; then
            echo ""
            
            if is_destructive "$cmd"; then
                echo -e "${RED}⚠️ This command may be destructive: $cmd${NC}"
                read -p "Execute anyway? [y/N] " -n 1 -r
                echo ""
                if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                    echo "Aborted."
                    exit 0
                fi
            fi
            
            echo -e "${BLUE}▶ Executing...${NC}"
            echo ""
            eval "$cmd"
        fi
    fi
}

# Handle special "list" command to show all patterns
if [[ "${1:-}" == "list" ]]; then
    echo "Available patterns:"
    echo ""
    
    # Group by category (simple heuristic)
    echo -e "${BLUE}File Operations:${NC}"
    for key in "${!PATTERNS[@]}"; do
        if [[ "$key" == *"file"* ]] || [[ "$key" == *"find"* ]] || [[ "$key" == *"count"* ]] || [[ "$key" == *"size"* ]] || [[ "$key" == *"disk"* ]]; then
            echo "  ${PATTERNS[$key]}"
        fi
    done | sort -u
    
    echo ""
    echo -e "${BLUE}Git Operations:${NC}"
    for key in "${!PATTERNS[@]}"; do
