#!/usr/bin/env bash
#
# art-audit - Portfolio health analyzer for generative art collection
# Usage: art-audit [--missing-html|--categories|--exports]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="${SCRIPT_DIR}/../.."
PORTFOLIO_ROOT="${WORKSPACE_ROOT}/nemo-portfolio/my-app"
LIB_ART_DIR="${PORTFOLIO_ROOT}/lib/art"
PUBLIC_ART_DIR="${PORTFOLIO_ROOT}/public/art"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Flags
CHECK_MISSING_HTML=false
CHECK_CATEGORIES=false
CHECK_EXPORTS=false

# Parse args
for arg in "$@"; do
  case $arg in
    --missing-html) CHECK_MISSING_HTML=true ;;
    --categories) CHECK_CATEGORIES=true ;;
    --exports) CHECK_EXPORTS=true ;;
    --help|-h)
      echo "Usage: art-audit [--missing-html|--categories|--exports]"
      echo ""
      echo "Options:"
      echo "  --missing-html    Show algorithms without standalone HTML files"
      echo "  --categories      Analyze category coverage"
      echo "  --exports         Check export consistency"
      echo "  --help            Show this help"
      exit 0
      ;;
  esac
done

# If no specific check, run all
if [[ "$CHECK_MISSING_HTML" == "false" && "$CHECK_CATEGORIES" == "false" && "$CHECK_EXPORTS" == "false" ]]; then
  CHECK_MISSING_HTML=true
  CHECK_CATEGORIES=true
  CHECK_EXPORTS=true
fi

# Get list of algorithm files (excluding generators, thumbnails, favorites, core, index)
get_algorithms() {
  find "${LIB_ART_DIR}" -maxdepth 1 -name "*.ts" -type f | \
    grep -v generator | \
    grep -v thumbnails | \
    grep -v favorites | \
    grep -v core | \
    grep -v index | \
    sort
}

# Extract algorithm ID from filename
get_algorithm_id() {
  basename "$1" .ts
}

# Check if standalone HTML exists
has_html() {
  local id="$1"
  [[ -f "${PUBLIC_ART_DIR}/${id}.html" ]]
}

# Get category from the algorithm file
get_category() {
  local file="$1"
  # Try to extract category from the metadata or tags
  grep -oE "category: [A-Za-z]+" "$file" 2>/dev/null | cut -d' ' -f2 || echo "Uncategorized"
}

# Count lines of code
get_loc() {
  local file="$1"
  wc -l < "$file" | tr -d ' '
}

# Main audit
echo -e "${BLUE}🎨 Portfolio Audit Report${NC}"
echo "========================"
echo ""

ALGORITHMS=($(get_algorithms))
TOTAL_COUNT=${#ALGORITHMS[@]}

echo -e "Total Algorithms: ${GREEN}${TOTAL_COUNT}${NC}"
echo ""

# Category analysis
if [[ "$CHECK_CATEGORIES" == "true" ]]; then
  echo -e "${YELLOW}Category Distribution:${NC}"
  
  # Define known categories based on gallery data
  declare -A CATEGORY_COUNTS
  CATEGORY_COUNTS["Animated"]=0
  CATEGORY_COUNTS["Static"]=0
  CATEGORY_COUNTS["Nature"]=0
  CATEGORY_COUNTS["Physics"]=0
  CATEGORY_COUNTS["Geometric"]=0
  CATEGORY_COUNTS["Fractal"]=0
  CATEGORY_COUNTS["AI/ML"]=0
  CATEGORY_COUNTS["Audio/Visual"]=0
  
  # Known mappings based on gallery structure
  declare -A ALGO_CATEGORIES
  ALGO_CATEGORIES["flow-field"]="Animated"
  ALGO_CATEGORIES["geometric-mandala"]="Geometric"
  ALGO_CATEGORIES["particle-network"]="Animated"
  ALGO_CATEGORIES["recursive-trees"]="Nature"
  ALGO_CATEGORIES["wave-interference"]="Physics"
  ALGO_CATEGORIES["cellular-automata"]="Animated"
  ALGO_CATEGORIES["voronoi-organic"]="Nature"
  ALGO_CATEGORIES["topographic-flow"]="Geometric"
  ALGO_CATEGORIES["strange-attractor"]="Physics"
  ALGO_CATEGORIES["reaction-diffusion"]="Animated"
  ALGO_CATEGORIES["dla"]="Nature"
  ALGO_CATEGORIES["lsystem-botany"]="Nature"
  ALGO_CATEGORIES["orbital-mechanics"]="Physics"
  ALGO_CATEGORIES["light-caverns"]="Nature"
  ALGO_CATEGORIES["fluid-smoke"]="Animated"
  ALGO_CATEGORIES["particle-swarm"]="Animated"
  ALGO_CATEGORIES["mandelbrot-explorer"]="Fractal"
  ALGO_CATEGORIES["perlin-terrain"]="Geometric"
  ALGO_CATEGORIES["kaleidoscope-symmetry"]="Geometric"
  ALGO_CATEGORIES["neural-dreams"]="AI/ML"
  ALGO_CATEGORIES["lsystem-fractals"]="Fractal"
  ALGO_CATEGORIES["quantum-field"]="Physics"
  ALGO_CATEGORIES["boid-flocking"]="Animated"
  ALGO_CATEGORIES["frequency-visualizer"]="Audio/Visual"
  
  for algo in "${ALGORITHMS[@]}"; do
    id=$(get_algorithm_id "$algo")
    cat="${ALGO_CATEGORIES[$id]:-Uncategorized}"
    ((CATEGORY_COUNTS[$cat]++)) 2>/dev/null || true
  done
  
  for cat in "Animated" "Static" "Nature" "Physics" "Geometric" "Fractal" "AI/ML" "Audio/Visual"; do
    count=${CATEGORY_COUNTS[$cat]:-0}
    if [[ $count -gt 0 ]]; then
      echo "  ├── $cat: $count"
    fi
  done
  echo ""
fi

# Missing HTML analysis
if [[ "$CHECK_MISSING_HTML" == "true" ]]; then
  MISSING_HTML=()
  
  for algo in "${ALGORITHMS[@]}"; do
    id=$(get_algorithm_id "$algo")
    if ! has_html "$id"; then
      MISSING_HTML+=("$id")
    fi
  done
  
  MISSING_COUNT=${#MISSING_HTML[@]}
  
  if [[ $MISSING_COUNT -eq 0 ]]; then
    echo -e "${GREEN}✅ All algorithms have standalone HTML files${NC}"
  else
    echo -e "${YELLOW}Missing Standalone HTML: ${MISSING_COUNT}${NC}"
    for id in "${MISSING_HTML[@]}"; do
      echo "  ├── $id"
    done
  fi
  echo ""
fi

# Export consistency check
if [[ "$CHECK_EXPORTS" == "true" ]]; then
  INDEX_FILE="${LIB_ART_DIR}/index.ts"
  
  MISSING_EXPORTS=()
  
  for algo in "${ALGORITHMS[@]}"; do
    id=$(get_algorithm_id "$algo")
    # Check if exported in index.ts
    if ! grep -q "\"$id\"" "$INDEX_FILE" 2>/dev/null; then
      MISSING_EXPORTS+=("$id")
    fi
  done
  
  MISSING_EXPORT_COUNT=${#MISSING_EXPORTS[@]}
  
  if [[ $MISSING_EXPORT_COUNT -eq 0 ]]; then
    echo -e "${GREEN}✅ All algorithms exported from index.ts${NC}"
  else
    echo -e "${RED}❌ Missing Exports: ${MISSING_EXPORT_COUNT}${NC}"
    for id in "${MISSING_EXPORTS[@]}"; do
      echo "  ├── $id"
    done
  fi
  echo ""
fi

# Summary stats
echo -e "${BLUE}Portfolio Health Summary${NC}"
echo "------------------------"
echo "Total Algorithms: $TOTAL_COUNT"

HTML_COUNT=$(ls -1 "${PUBLIC_ART_DIR}"/*.html 2>/dev/null | wc -l)
echo "Standalone HTMLs: $HTML_COUNT"

if [[ $HTML_COUNT -eq $TOTAL_COUNT ]]; then
  echo -e "Coverage: ${GREEN}100%${NC}"
else
  COVERAGE=$((HTML_COUNT * 100 / TOTAL_COUNT))
  echo -e "Coverage: ${YELLOW}${COVERAGE}%${NC}"
fi

echo ""
echo -e "${BLUE}💡 Tip: Run 'art-audit --missing-html' to see what's missing${NC}"
