#!/usr/bin/env bash
#
# art-audit — Portfolio health analysis (Registry-aware)
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Config
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
PORTFOLIO_DIR="$WORKSPACE_DIR/nemo-portfolio/my-app"
LIB_ART_DIR="$PORTFOLIO_DIR/lib/art"
REGISTRY_FILE="$LIB_ART_DIR/unified-registry.ts"
INDEX_FILE="$LIB_ART_DIR/index.ts"

# Counters
TOTAL_FILES=0
REGISTERED=0
UNREGISTERED=0
ISSUES_FOUND=0

# Parse arguments
QUICK_MODE=false
SHOW_UNREGISTERED=false
SHOW_STATS=true

while [[ $# -gt 0 ]]; do
  case $1 in
    --quick)
      QUICK_MODE=true
      shift
      ;;
    --unregistered)
      SHOW_UNREGISTERED=true
      shift
      ;;
    --no-stats)
      SHOW_STATS=false
      shift
      ;;
    --help|-h)
      echo "Usage: art-audit [options]"
      echo ""
      echo "Options:"
      echo "  --quick          Fast check (counts only)"
      echo "  --unregistered   Show algorithms not in registry"
      echo "  --no-stats       Skip statistics"
      echo "  --help           Show this help"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      echo "Use --help for usage information"
      exit 2
      ;;
  esac
done

# Header
echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}           🎨 Portfolio Health Audit                        ${BLUE}║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Check if portfolio directory exists
if [[ ! -d "$PORTFOLIO_DIR" ]]; then
  echo -e "${RED}Error: Portfolio directory not found at $PORTFOLIO_DIR${NC}"
  exit 2
fi

# Check for registry file
if [[ ! -f "$REGISTRY_FILE" ]]; then
  echo -e "${YELLOW}Warning: unified-registry.ts not found${NC}"
  echo "Falling back to legacy mode (checking index.ts exports)"
  REGISTRY_FILE=""
fi

# Count algorithm files
echo -e "${BLUE}📊 Algorithm Inventory${NC}"
echo "────────────────────────────────────────────────────────────"

if [[ -d "$LIB_ART_DIR" ]]; then
  # Count .ts files excluding index.ts, *-thumb.ts, core.ts, metadata.ts, etc.
  TOTAL_FILES=$(find "$LIB_ART_DIR" -maxdepth 1 -name "*.ts" \
    ! -name "index.ts" \
    ! -name "*-thumb.ts" \
    ! -name "core.ts" \
    ! -name "metadata.ts" \
    ! -name "statistics.ts" \
    ! -name "unified-registry.ts" \
    ! -name "seeded-random.ts" | wc -l)
  echo -e "Algorithm files: ${GREEN}$TOTAL_FILES${NC}"
else
  echo -e "${RED}Error: lib/art directory not found${NC}"
  exit 2
fi

# Quick mode: just count and exit
if [[ "$QUICK_MODE" == true ]]; then
  echo -e "${GREEN}✓ Quick audit complete${NC}"
  exit 0
fi

# Check registry entries
if [[ -n "$REGISTRY_FILE" && -f "$REGISTRY_FILE" ]]; then
  echo ""
  echo -e "${BLUE}📋 Registry Analysis${NC}"
  echo "────────────────────────────────────────────────────────────"
  
  # Count registered generators
  REGISTERED=$(grep -c 'id: "' "$REGISTRY_FILE" 2>/dev/null || echo "0")
  echo -e "Registered in unified-registry.ts: ${GREEN}$REGISTERED${NC}"
  
  # Calculate coverage
  if [[ $TOTAL_FILES -gt 0 ]]; then
    COVERAGE=$((REGISTERED * 100 / TOTAL_FILES))
    if [[ $COVERAGE -ge 90 ]]; then
      echo -e "Registry coverage: ${GREEN}$COVERAGE%${NC}"
    elif [[ $COVERAGE -ge 70 ]]; then
      echo -e "Registry coverage: ${YELLOW}$COVERAGE%${NC}"
    else
      echo -e "Registry coverage: ${RED}$COVERAGE%${NC}"
    fi
  fi
  
  # Show unregistered files if requested
  if [[ "$SHOW_UNREGISTERED" == true ]]; then
    echo ""
    echo -e "${YELLOW}⚠️  Unregistered Algorithms:${NC}"
    while IFS= read -r file; do
      basename=$(basename "$file" .ts)
      # Check if this file is referenced in registry
      if ! grep -q "id: \"$basename\"" "$REGISTRY_FILE" 2>/dev/null; then
        echo -e "  ${CYAN}$basename${NC}"
        UNREGISTERED=$((UNREGISTERED + 1))
      fi
    done < <(find "$LIB_ART_DIR" -maxdepth 1 -name "*.ts" \
      ! -name "index.ts" \
      ! -name "*-thumb.ts" \
      ! -name "core.ts" \
      ! -name "metadata.ts" \
      ! -name "statistics.ts" \
      ! -name "unified-registry.ts" \
      ! -name "seeded-random.ts")
    
    if [[ $UNREGISTERED -eq 0 ]]; then
      echo -e "  ${GREEN}✓ All algorithms registered${NC}"
    else
      ISSUES_FOUND=$((ISSUES_FOUND + UNREGISTERED))
    fi
  fi
fi

# Category statistics - simplified version
if [[ "$SHOW_STATS" == true && -n "$REGISTRY_FILE" && -f "$REGISTRY_FILE" ]]; then
  echo ""
  echo -e "${BLUE}📚 Category Distribution${NC}"
  echo "────────────────────────────────────────────────────────────"
  
  # Count categories using simple grep
  echo -e "  ${CYAN}mathematical:${NC}  $(grep -c 'category: "mathematical"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}natural:${NC}      $(grep -c 'category: "natural"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}physics:${NC}      $(grep -c 'category: "physics"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}geometric:${NC}    $(grep -c 'category: "geometric"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}abstract:${NC}     $(grep -c 'category: "abstract"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}traditional:${NC}  $(grep -c 'category: "traditional"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}text:${NC}         $(grep -c 'category: "text"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}3d:${NC}           $(grep -c 'category: "3d"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
  echo -e "  ${CYAN}interactive:${NC}  $(grep -c 'category: "interactive"' "$REGISTRY_FILE" 2>/dev/null || echo 0)"
fi

# Summary
echo ""
echo -e "${BLUE}📋 Summary${NC}"
echo "────────────────────────────────────────────────────────────"
echo -e "Algorithm files:     $TOTAL_FILES"
if [[ -n "$REGISTRY_FILE" ]]; then
  echo -e "Registered:          $REGISTERED"
  if [[ "$SHOW_UNREGISTERED" == true ]]; then
    echo -e "Unregistered:        $UNREGISTERED"
  fi
fi
echo ""

if [[ $ISSUES_FOUND -eq 0 ]]; then
  if [[ "$SHOW_UNREGISTERED" == true ]]; then
    echo -e "${GREEN}✅ All algorithms registered! Portfolio is healthy.${NC}"
  else
    echo -e "${GREEN}✅ Audit complete. Use --unregistered to see gaps.${NC}"
  fi
  exit 0
else
  echo -e "${YELLOW}⚠️  $ISSUES_FOUND algorithm(s) not in registry.${NC}"
  echo -e "${CYAN}   Run with --unregistered to see the list.${NC}"
  exit 1
fi
