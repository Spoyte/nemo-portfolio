#!/usr/bin/env python3
"""
Unified Health Monitor for OpenClaw Workspace
Plugin-based architecture for extensible health checks.

Usage:
    health                    # Full report
    health --check            # Quick status line (shows issues only)
    health --json             # JSON output
    health --quiet            # Exit codes only (0=healthy, 1=issues, 2=warnings)
    health --fix              # Auto-fix issues where safe
    health --system           # System checks only
    health --workspace        # Workspace checks only
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass, field, asdict
from datetime import datetime, timedelta
from enum import Enum
from pathlib import Path
from typing import Callable, NamedTuple, Optional


# =============================================================================
# CONSTANTS - Thresholds and configuration
# =============================================================================

class Thresholds:
    """Health check thresholds."""
    DISK_WARN = 80
    DISK_CRITICAL = 90
    MEMORY_WARN = 85
    MEMORY_CRITICAL = 95
    LOAD_WARN_MULTIPLIER = 1.0
    LOAD_CRITICAL_MULTIPLIER = 2.0
    BACKUP_WARN_HOURS = 24
    BACKUP_CRITICAL_HOURS = 48
    MEMORY_RECENT_DAYS = 7
    TREND_WINDOW = 5
    HISTORY_LIMIT = 100
    GIT_TIMEOUT = 10
    REPO_TIMEOUT = 5


class SafePatterns:
    """File patterns considered safe for auto-commit."""
    PREFIXES = ['memory/', 'skills/', 'scripts/']
    SUFFIXES = ['.md']


# =============================================================================
# DATA MODELS
# =============================================================================

class Status(Enum):
    """Health check status levels."""
    OK = "ok"
    WARNING = "warning"
    CRITICAL = "critical"
    UNKNOWN = "unknown"


@dataclass(frozen=True, slots=True)
class CheckResult:
    """Result of a single health check."""
    name: str
    status: Status
    message: str
    value: Optional[str] = None
    threshold: Optional[str] = None
    fixable: bool = False
    
    @property
    def is_healthy(self) -> bool:
        return self.status == Status.OK
    
    @property
    def icon(self) -> str:
        return {
            Status.OK: "✅",
            Status.WARNING: "⚠️",
            Status.CRITICAL: "❌",
            Status.UNKNOWN: "❓"
        }.get(self.status, "❓")


@dataclass(slots=True)
class HealthReport:
    """Aggregated health report from all checks."""
    timestamp: str
    timezone: str
    checks: list[CheckResult] = field(default_factory=list)
    fixes_applied: list[str] = field(default_factory=list)
    
    @property
    def critical_count(self) -> int:
        return sum(1 for c in self.checks if c.status == Status.CRITICAL)
    
    @property
    def warning_count(self) -> int:
        return sum(1 for c in self.checks if c.status == Status.WARNING)
    
    @property
    def ok_count(self) -> int:
        return sum(1 for c in self.checks if c.status == Status.OK)
    
    @property
    def fixable_count(self) -> int:
        return sum(1 for c in self.checks if c.fixable)
    
    @property
    def has_critical(self) -> bool:
        return self.critical_count > 0
    
    @property
    def has_warnings(self) -> bool:
        return self.warning_count > 0
    
    @property
    def is_healthy(self) -> bool:
        return not self.has_critical and not self.has_warnings
    
    def by_category(self, prefix: str) -> list[CheckResult]:
        """Get checks matching a name prefix."""
        return [c for c in self.checks if c.name.startswith(prefix)]
    
    def issues(self) -> list[CheckResult]:
        """Get non-healthy checks."""
        return [c for c in self.checks if not c.is_healthy]


# =============================================================================
# PLUGIN REGISTRY
# =============================================================================

class PluginRegistry:
    """Simple plugin registry using decorators."""
    
    def __init__(self):
        self._plugins: list[Callable[[str], CheckResult]] = []
        self._system_plugins: list[Callable[[str], CheckResult]] = []
        self._workspace_plugins: list[Callable[[str], CheckResult]] = []
    
    def system(self, fn: Callable[[str], CheckResult]) -> Callable[[str], CheckResult]:
        """Register a system-level check."""
        self._plugins.append(fn)
        self._system_plugins.append(fn)
        return fn
    
    def workspace(self, fn: Callable[[str], CheckResult]) -> Callable[[str], CheckResult]:
        """Register a workspace-level check."""
        self._plugins.append(fn)
        self._workspace_plugins.append(fn)
        return fn
    
    @property
    def all_plugins(self) -> list[Callable[[str], CheckResult]]:
        return self._plugins
    
    @property
    def system_plugins(self) -> list[Callable[[str], CheckResult]]:
        return self._system_plugins
    
    @property
    def workspace_plugins(self) -> list[Callable[[str], CheckResult]]:
        return self._workspace_plugins


registry = PluginRegistry()


# =============================================================================
# GIT UTILITIES - Shared git operations
# =============================================================================

class GitStatus(NamedTuple):
    """Git repository status."""
    uncommitted: int
    unpushed: int
    is_clean: bool


def get_git_status(repo_path: Path, timeout: int = Thresholds.GIT_TIMEOUT) -> GitStatus:
    """Get git status for a repository. Returns GitStatus on success, raises on failure."""
    # Check for uncommitted changes
    status_result = subprocess.run(
        ["git", "status", "--porcelain"],
        cwd=repo_path,
        capture_output=True,
        text=True,
        timeout=timeout
    )
    
    if status_result.returncode != 0:
        raise RuntimeError(f"git status failed: {status_result.stderr}")
    
    uncommitted = len([l for l in status_result.stdout.splitlines() if l.strip()])
    
    # Check if ahead of remote
    ahead_result = subprocess.run(
        ["git", "rev-list", "--count", "@{u}..HEAD"],
        cwd=repo_path,
        capture_output=True,
        text=True,
        timeout=timeout
    )
    
    unpushed = int(ahead_result.stdout.strip() or 0) if ahead_result.returncode == 0 else 0
    
    return GitStatus(
        uncommitted=uncommitted,
        unpushed=unpushed,
        is_clean=(uncommitted == 0 and unpushed == 0)
    )


def is_safe_to_auto_commit(filename: str) -> bool:
    """Check if a file matches safe auto-commit patterns."""
    return (
        any(filename.startswith(p) for p in SafePatterns.PREFIXES) or
        any(filename.endswith(s) for s in SafePatterns.SUFFIXES)
    )

