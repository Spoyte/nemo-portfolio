def format_check_line(report: HealthReport) -> str:
    """Format a quick one-line status."""
    parts = []
    
    for check in report.checks:
        icon = check.icon
        name = check.name.split('.')[-1]
        if check.status != Status.OK:
            parts.append(f"{icon} {name}")
        else:
            parts.append(f"{icon} {name}")
    
    fix_info = f" | 🔧 {len(report.fixes_applied)} fixes" if report.fixes_applied else ""
    return " | ".join(parts) + fix_info if parts else "No checks run"


def format_full_report(report: HealthReport) -> str:
    """Format a full human-readable report."""
    lines = [
        "=" * 50,
        "🏥 HEALTH MONITOR REPORT",
        f"🕐 {report.timestamp} ({report.timezone})",
        "=" * 50,
    ]
    
    # Group by category
    system_checks = report.by_category("system")
    workspace_checks = report.by_category("workspace")
    
    if system_checks:
        lines.extend(["\n🖥️  SYSTEM", "-" * 30])
        for check in system_checks:
            fixable = " [🔧 fixable]" if check.fixable else ""
            lines.append(f"   {check.icon} {check.name.split('.')[-1]}: {check.message}{fixable}")
    
    if workspace_checks:
        lines.extend(["\n📁 WORKSPACE", "-" * 30])
        for check in workspace_checks:
            fixable = " [🔧 fixable]" if check.fixable else ""
            lines.append(f"   {check.icon} {check.name.split('.')[-1]}: {check.message}{fixable}")
    
    # Fixes applied
    if report.fixes_applied:
        lines.extend(["\n🔧 FIXES APPLIED", "-" * 30])
        for fix in report.fixes_applied:
            lines.append(f"   {fix}")
    
    # Summary
    lines.extend(["\n" + "=" * 50])
    if report.has_critical:
        lines.append(f"🚨 {report.critical_count} critical, {report.warning_count} warnings")
    elif report.has_warnings:
        lines.append(f"⚠️  {report.warning_count} warnings, {report.ok_count} OK")
    else:
        lines.append(f"✅ All {report.ok_count} checks passed")
    lines.append("=" * 50)
    
    return "\n".join(lines)


def format_json(report: HealthReport) -> str:
    """Format as JSON."""
    data = {
        "timestamp": report.timestamp,
        "timezone": report.timezone,
        "summary": {
            "ok": report.ok_count,
            "warnings": report.warning_count,
            "critical": report.critical_count,
            "fixable": report.fixable_count,
            "healthy": report.is_healthy
        },
        "fixes_applied": report.fixes_applied,
        "checks": [
            {
                "name": c.name,
                "status": c.status.value,
                "message": c.message,
                "value": c.value,
                "threshold": c.threshold,
                "fixable": c.fixable
            }
            for c in report.checks
        ]
    }
    return json.dumps(data, indent=2)


# =============================================================================
# MAIN
# =============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="Unified health monitor for OpenClaw workspace",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    health                    # Full report
    health --check            # Quick status line
    health --json             # JSON output
    health --quiet            # Exit codes only (0=healthy, 1=critical, 2=warnings)
    health --fix              # Auto-fix issues where safe
    health --system           # System checks only
    health --workspace        # Workspace checks only
        """
    )
    parser.add_argument("--check", action="store_true", help="Quick one-line status")
    parser.add_argument("--json", action="store_true", help="JSON output")
    parser.add_argument("--quiet", action="store_true", help="Exit codes only")
    parser.add_argument("--fix", action="store_true", help="Auto-fix issues where safe")
    parser.add_argument("--system", action="store_true", help="System checks only")
    parser.add_argument("--workspace", action="store_true", help="Workspace checks only")
    parser.add_argument("--workspace-path", default="/root/.openclaw/workspace", help="Workspace path")
    
    args = parser.parse_args()
    
    # Select plugins
    plugins = registry.all_plugins
    if args.system and not args.workspace:
        plugins = registry.system_plugins
    elif args.workspace and not args.system:
        plugins = registry.workspace_plugins
    
    # Run checks
    checks = [p(args.workspace_path) for p in plugins]
    
    report = HealthReport(
        timestamp=datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        timezone="Asia/Shanghai",
        checks=checks
    )
    
    # Apply fixes if requested
    if args.fix:
        report = apply_fixes(report, args.workspace_path)
        # Re-run checks to get updated status
        checks = [p(args.workspace_path) for p in plugins]
        report.checks = checks

    # Persist state
    save_state(report)

    # Output
    if args.quiet:
        if report.has_critical:
            sys.exit(1)
        elif report.has_warnings:
            sys.exit(2)
        else:
            sys.exit(0)
    elif args.json:
        print(format_json(report))
    elif args.check:
        print(format_check_line(report))
    else:
        print(format_full_report(report))
    
    # Exit code
    if report.has_critical:
        sys.exit(1)
    elif report.has_warnings:
        sys.exit(2)
    else:
        sys.exit(0)


if __name__ == "__main__":
    import os  # Import here to avoid issues with module-level imports
    main()
