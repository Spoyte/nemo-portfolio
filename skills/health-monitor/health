@registry.system
def check_disk(workspace: str) -> CheckResult:
    """Check disk usage."""
    try:
        stat = shutil.disk_usage("/")
        percent = int((stat.used / stat.total) * 100)
        used_gb = stat.used // (1024**3)
        total_gb = stat.total // (1024**3)
        
        if percent >= Thresholds.DISK_CRITICAL:
            status = Status.CRITICAL
        elif percent >= Thresholds.DISK_WARN:
            status = Status.WARNING
        else:
            status = Status.OK
            
        return CheckResult(
            name="system.disk",
            status=status,
            message=f"{used_gb}GB / {total_gb}GB used ({percent}%)",
            value=f"{percent}%",
            threshold=f"{Thresholds.DISK_WARN}%/{Thresholds.DISK_CRITICAL}%",
            fixable=False
        )
    except OSError as e:
        return CheckResult(
            name="system.disk",
            status=Status.UNKNOWN,
            message=f"Could not check disk: {e}"
        )


@registry.system
def check_memory(workspace: str) -> CheckResult:
    """Check memory usage."""
    try:
        with open('/proc/meminfo', 'r') as f:
            lines = f.readlines()
        
        mem_total = mem_available = 0
        
        for line in lines:
            if line.startswith('MemTotal:'):
                mem_total = int(line.split()[1]) * 1024
            elif line.startswith('MemAvailable:'):
                mem_available = int(line.split()[1]) * 1024
        
        if mem_total == 0:
            return CheckResult(
                name="system.memory",
                status=Status.UNKNOWN,
                message="Could not parse memory info"
            )
        
        used = mem_total - mem_available
        percent = int((used / mem_total) * 100)
        
        if percent >= Thresholds.MEMORY_CRITICAL:
            status = Status.CRITICAL
        elif percent >= Thresholds.MEMORY_WARN:
            status = Status.WARNING
        else:
            status = Status.OK
        
        used_gb = used // (1024**3)
        total_gb = mem_total // (1024**3)
        
        return CheckResult(
            name="system.memory",
            status=status,
            message=f"{used_gb}GB / {total_gb}GB used ({percent}%)",
            value=f"{percent}%",
            threshold=f"{Thresholds.MEMORY_WARN}%/{Thresholds.MEMORY_CRITICAL}%",
            fixable=False
        )
    except (OSError, ValueError) as e:
        return CheckResult(
            name="system.memory",
            status=Status.UNKNOWN,
            message=f"Could not check memory: {e}"
        )


@registry.system
def check_load(workspace: str) -> CheckResult:
    """Check system load average."""
    try:
        with open('/proc/loadavg', 'r') as f:
            load = float(f.read().split()[0])
        
        cores = max(1, (os.cpu_count() or 4))
        percent = int((load / cores) * 100)
        
        warn_threshold = cores * Thresholds.LOAD_WARN_MULTIPLIER
        critical_threshold = cores * Thresholds.LOAD_CRITICAL_MULTIPLIER
        
        if load >= critical_threshold:
            status = Status.CRITICAL
        elif load >= warn_threshold:
            status = Status.WARNING
        else:
            status = Status.OK
        
        return CheckResult(
            name="system.load",
            status=status,
            message=f"Load: {load:.2f} ({percent}% of {cores} cores)",
            value=f"{load:.2f}",
            threshold=f"{warn_threshold:.0f}/{critical_threshold:.0f}",
            fixable=False
        )
    except (OSError, ValueError) as e:
        return CheckResult(
            name="system.load",
            status=Status.UNKNOWN,
            message=f"Could not check load: {e}"
        )


