STATE_FILE = Path("/root/.openclaw/workspace/memory/health-state.json")


def load_state() -> dict:
    """Load persisted health state."""
    if STATE_FILE.exists():
        return json.loads(STATE_FILE.read_text())
    return {}


def save_state(report: HealthReport) -> None:
    """Persist health state for tracking trends."""
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    # Load existing history
    state = load_state()
    if "history" not in state:
        state["history"] = []
    
    # Add current run
    entry = {
        "timestamp": report.timestamp,
        "healthy": report.is_healthy,
        "ok": report.ok_count,
        "warnings": report.warning_count,
        "critical": report.critical_count
    }
    state["history"].append(entry)
    
    # Keep last N entries
    state["history"] = state["history"][-Thresholds.HISTORY_LIMIT:]
    
    # Update current status
    state["last_run"] = report.timestamp
    state["last_status"] = "healthy" if report.is_healthy else "issues"
    
    STATE_FILE.write_text(json.dumps(state, indent=2))


@registry.workspace
def check_health_trend(workspace: str) -> CheckResult:
    """Analyze health trend over recent runs (tracks critical issues only)."""
    try:
        state = load_state()
        history = state.get("history", [])
        
        if len(history) < Thresholds.TREND_WINDOW:
            return CheckResult(
                name="workspace.trend",
                status=Status.OK,
                message=f"Building history ({len(history)}/{Thresholds.TREND_WINDOW} runs)"
            )
        
        recent = history[-Thresholds.TREND_WINDOW:]
        runs_with_critical = sum(1 for h in recent if h.get("critical", 0) > 0)
        
        if runs_with_critical == 0:
            return CheckResult(
                name="workspace.trend",
                status=Status.OK,
                message=f"No critical issues in last {Thresholds.TREND_WINDOW} runs 🎉"
            )
        elif runs_with_critical == 1:
            return CheckResult(
                name="workspace.trend",
                status=Status.WARNING,
                message="1 recent run had critical issues (likely transient)"
            )
        elif runs_with_critical <= Thresholds.TREND_WINDOW // 2:
            return CheckResult(
                name="workspace.trend",
                status=Status.WARNING,
                message=f"{runs_with_critical}/{Thresholds.TREND_WINDOW} recent runs had critical issues"
            )
        else:
            return CheckResult(
                name="workspace.trend",
                status=Status.CRITICAL,
                message=f"Declining health: {runs_with_critical}/{Thresholds.TREND_WINDOW} recent runs had critical issues"
            )
    except (OSError, json.JSONDecodeError) as e:
        return CheckResult(
            name="workspace.trend",
            status=Status.UNKNOWN,
            message=f"Could not analyze trend: {e}"
        )


# =============================================================================
# FIXERS - Auto-resolve issues where safe
# =============================================================================

def fix_git(workspace: str) -> tuple[bool, str]:
    """Auto-commit safe changes (memory files, logs, etc.)."""
    try:
        result = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=workspace,
            capture_output=True,
            text=True,
            timeout=Thresholds.GIT_TIMEOUT
        )
        
        if result.returncode != 0:
            return False, "Not a git repository"
        
        files = [l[3:] for l in result.stdout.strip().split('\n') if l.strip()]
        
        # Filter to safe files only
        safe_files = [f for f in files if is_safe_to_auto_commit(f)]
        
        if not safe_files:
            return False, "No safe files to auto-commit"
        
        # Stage and commit safe files
        for f in safe_files:
            subprocess.run(
                ["git", "add", f],
                cwd=workspace,
                capture_output=True,
                timeout=Thresholds.GIT_TIMEOUT
            )
        
        commit_result = subprocess.run(
            ["git", "commit", "-m", f"chore: auto-commit {len(safe_files)} files from health check"],
            cwd=workspace,
            capture_output=True,
            text=True,
            timeout=Thresholds.GIT_TIMEOUT
        )
        
        if commit_result.returncode == 0:
            return True, f"Auto-committed {len(safe_files)} files"
        else:
            return False, f"Commit failed: {commit_result.stderr}"
            
    except subprocess.TimeoutExpired:
        return False, "Git operation timed out"
    except OSError as e:
        return False, f"Error: {e}"


def fix_backup_dir(workspace: str) -> tuple[bool, str]:
    """Create backup directory if missing."""
    try:
        backup_dir = Path(workspace) / "backups"
        backup_dir.mkdir(exist_ok=True)
        return True, f"Created {backup_dir}"
    except OSError as e:
        return False, f"Failed to create backup dir: {e}"


def fix_memory_dir(workspace: str) -> tuple[bool, str]:
    """Create memory directory if missing."""
    try:
        memory_dir = Path(workspace) / "memory"
        memory_dir.mkdir(exist_ok=True)
        return True, f"Created {memory_dir}"
    except OSError as e:
        return False, f"Failed to create memory dir: {e}"


# Map check names to fixer functions
FIXERS: dict[str, Callable[[str], tuple[bool, str]]] = {
    "workspace.git": fix_git,
    "workspace.backup": fix_backup_dir,
    "workspace.memory": fix_memory_dir,
}


def apply_fixes(report: HealthReport, workspace: str) -> HealthReport:
    """Apply auto-fixes for fixable issues."""
    for check in report.checks:
        if check.fixable and check.status != Status.OK:
            fixer = FIXERS.get(check.name)
            if fixer:
                success, message = fixer(workspace)
                report.fixes_applied.append(f"{'✅' if success else '❌'} {check.name}: {message}")
    
    return report


