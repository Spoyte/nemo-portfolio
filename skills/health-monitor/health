@registry.workspace
def check_git_main(workspace: str) -> CheckResult:
    """Check main workspace git status."""
    try:
        status = get_git_status(Path(workspace))
        
        if status.is_clean:
            return CheckResult(
                name="workspace.git",
                status=Status.OK,
                message="Git repository clean"
            )
        
        issues = []
        if status.uncommitted:
            issues.append(f"{status.uncommitted} uncommitted")
        if status.unpushed:
            issues.append(f"{status.unpushed} unpushed")
        
        return CheckResult(
            name="workspace.git",
            status=Status.WARNING,
            message=f"Git: {', '.join(issues)}",
            value=f"{status.uncommitted} files" if status.uncommitted else "clean",
            fixable=True
        )
        
    except RuntimeError as e:
        return CheckResult(
            name="workspace.git",
            status=Status.UNKNOWN,
            message=f"Not a git repository: {e}"
        )
    except subprocess.TimeoutExpired:
        return CheckResult(
            name="workspace.git",
            status=Status.UNKNOWN,
            message="Git check timed out"
        )


@registry.workspace
def check_all_repos(workspace: str) -> CheckResult:
    """Check git status across all repositories in workspace."""
    try:
        repos = list(Path(workspace).rglob(".git"))
        dirty: list[tuple[Path, int, int]] = []
        
        for git_dir in repos:
            repo = git_dir.parent
            # Skip node_modules and other common non-project dirs
            if any(part.startswith(".") or part in ["node_modules", "vendor", "__pycache__"] 
                   for part in repo.parts):
                continue
                
            try:
                status = get_git_status(repo, timeout=Thresholds.REPO_TIMEOUT)
                if not status.is_clean:
                    dirty.append((repo.relative_to(workspace), status.uncommitted, status.unpushed))
            except (RuntimeError, subprocess.TimeoutExpired):
                continue
        
        if not dirty:
            return CheckResult(
                name="workspace.repos",
                status=Status.OK,
                message=f"All {len(repos)} repositories clean"
            )
        
        main_repo_dirty = any(str(d[0]) == "." for d in dirty)
        others = len([d for d in dirty if str(d[0]) != "."])
        
        if main_repo_dirty and others > 0:
            msg = f"Main repo + {others} other(s) need attention"
        elif main_repo_dirty:
            msg = "Main repository needs attention"
        else:
            msg = f"{len(dirty)} repo(s) need attention"
        
        return CheckResult(
            name="workspace.repos",
            status=Status.CRITICAL if main_repo_dirty else Status.WARNING,
            message=msg,
            value=f"{len(dirty)} dirty",
            fixable=False
        )
        
    except OSError as e:
        return CheckResult(
            name="workspace.repos",
            status=Status.UNKNOWN,
            message=f"Could not scan for repos: {e}"
        )


@registry.workspace
def check_memory_files(workspace: str) -> CheckResult:
    """Check memory file maintenance."""
    try:
        memory_dir = Path(workspace) / "memory"
        if not memory_dir.exists():
            return CheckResult(
                name="workspace.memory",
                status=Status.WARNING,
                message="No memory directory found",
                fixable=True
            )
        
        files = list(memory_dir.glob("*.md"))
        
        # Check for recent entries
        week_ago = datetime.now() - timedelta(days=Thresholds.MEMORY_RECENT_DAYS)
        recent = [f for f in files if datetime.fromtimestamp(f.stat().st_mtime) > week_ago]
        
        if not recent:
            return CheckResult(
                name="workspace.memory",
                status=Status.WARNING,
                message=f"No memory entries in last {Thresholds.MEMORY_RECENT_DAYS} days ({len(files)} total)",
                value=f"{len(recent)} recent",
                fixable=False
            )
        
        return CheckResult(
            name="workspace.memory",
            status=Status.OK,
            message=f"{len(recent)} entries in last {Thresholds.MEMORY_RECENT_DAYS} days ({len(files)} total)",
            value=f"{len(recent)} recent"
        )
    except OSError as e:
        return CheckResult(
            name="workspace.memory",
            status=Status.UNKNOWN,
            message=f"Could not check memory files: {e}"
        )


@registry.workspace
def check_backups(workspace: str) -> CheckResult:
    """Check backup freshness."""
    try:
        backup_dir = Path(workspace) / "backups"
        if not backup_dir.exists():
            return CheckResult(
                name="workspace.backup",
                status=Status.WARNING,
                message="No backup directory found",
                fixable=True
            )
        
        backups = sorted(backup_dir.glob("*.zip"), key=lambda x: x.stat().st_mtime, reverse=True)
        
        if not backups:
            return CheckResult(
                name="workspace.backup",
                status=Status.WARNING,
                message="No backups found",
                fixable=False
            )
        
        latest = backups[0]
        age_hours = (datetime.now() - datetime.fromtimestamp(latest.stat().st_mtime)).total_seconds() / 3600
        
        if age_hours >= Thresholds.BACKUP_CRITICAL_HOURS:
            status = Status.CRITICAL
        elif age_hours >= Thresholds.BACKUP_WARN_HOURS:
            status = Status.WARNING
        else:
            status = Status.OK
        
        return CheckResult(
            name="workspace.backup",
            status=status,
            message=f"Latest: {latest.name} ({age_hours:.0f}h ago)",
            value=f"{age_hours:.0f}h",
            threshold=f"{Thresholds.BACKUP_WARN_HOURS}h/{Thresholds.BACKUP_CRITICAL_HOURS}h",
            fixable=False
        )
    except OSError as e:
        return CheckResult(
            name="workspace.backup",
            status=Status.UNKNOWN,
            message=f"Could not check backups: {e}"
        )


@registry.workspace
def check_skills_consistency(workspace: str) -> CheckResult:
    """Check that all skills have SKILL.md files."""
    try:
        skills_dir = Path(workspace) / "skills"
        if not skills_dir.exists():
            return CheckResult(
                name="workspace.skills",
                status=Status.UNKNOWN,
                message="No skills directory found"
            )
        
        skill_dirs = [d for d in skills_dir.iterdir() if d.is_dir()]
        missing_skill_md = [d.name for d in skill_dirs if not (d / "SKILL.md").exists()]
        
        if missing_skill_md:
            return CheckResult(
                name="workspace.skills",
                status=Status.WARNING,
                message=f"{len(missing_skill_md)} skills missing SKILL.md: {', '.join(missing_skill_md[:3])}",
                value=f"{len(missing_skill_md)} missing",
                fixable=False
            )
        
        return CheckResult(
            name="workspace.skills",
            status=Status.OK,
            message=f"All {len(skill_dirs)} skills have SKILL.md"
        )
    except OSError as e:
        return CheckResult(
            name="workspace.skills",
            status=Status.UNKNOWN,
            message=f"Could not check skills: {e}"
        )


@registry.workspace
def check_skill_gaps(workspace: str) -> CheckResult:
    """Check for scripts that could be formalized as skills."""
    # Keywords that suggest skill-worthy scripts
    keywords = {
        "backup": "backup|restore|archive",
        "deploy": "deploy|release|publish",
        "sync": "sync|mirror|replicate",
        "build": "build|compile|bundle",
        "test": "test|check|verify",
        "lint": "lint|format|style",
        "clean": "clean|prune|purge"
    }
    
    try:
        skills_dir = Path(workspace) / "skills"
        skill_names = {d.name.lower() for d in skills_dir.iterdir() if d.is_dir()} if skills_dir.exists() else set()
        
        candidates: list[tuple[str, str]] = []
        for folder in [Path(workspace) / "bin", Path(workspace) / "scripts"]:
            if not folder.exists():
                continue
            for script in folder.iterdir():
                if not script.is_file() or script.name.startswith("."):
                    continue
                name = script.name.lower()
                for skill, pattern in keywords.items():
                    if skill in skill_names:
                        continue  # Already have this skill
                    if any(p in name for p in pattern.split("|")):
                        candidates.append((skill, script.name))
                        break
        
        if len(candidates) > 2:
            return CheckResult(
                name="workspace.skill_gaps",
                status=Status.WARNING,
                message=f"{len(candidates)} scripts could be skills: {', '.join(c[1] for c in candidates[:3])}",
                value=f"{len(candidates)} candidates",
                fixable=False
            )
        elif candidates:
            return CheckResult(
                name="workspace.skill_gaps",
                status=Status.OK,
                message=f"{len(candidates)} potential skill(s): {', '.join(c[1] for c in candidates)}",
                value=f"{len(candidates)} candidates"
            )
        
        return CheckResult(
            name="workspace.skill_gaps",
            status=Status.OK,
            message="No obvious skill gaps detected"
        )
    except OSError as e:
        return CheckResult(
            name="workspace.skill_gaps",
            status=Status.UNKNOWN,
            message=f"Could not check skill gaps: {e}"
        )


