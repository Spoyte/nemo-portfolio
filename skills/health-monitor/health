# FIXERS - Auto-resolve issues where safe
# =============================================================================

def fix_git(workspace: str) -> tuple[bool, str]:
    """Auto-commit safe changes (memory files, logs, etc.)."""
    try:
        # Only auto-commit files in safe patterns
        safe_patterns = ['memory/', '*.md', 'skills/', 'scripts/']
        
        result = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=workspace,
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if result.returncode != 0:
            return False, "Not a git repository"
        
        files = [l[3:] for l in result.stdout.strip().split('\n') if l.strip()]
        
        # Check if all uncommitted files are safe to auto-commit
        safe_files = []
        for f in files:
            if any(f.startswith(p.rstrip('*')) or f.endswith(p.lstrip('*')) 
                   for p in safe_patterns):
                safe_files.append(f)
        
        if not safe_files:
            return False, "No safe files to auto-commit"
        
        # Stage and commit safe files
        for f in safe_files:
            subprocess.run(
                ["git", "add", f],
                cwd=workspace,
                capture_output=True,
                timeout=10
            )
        
        commit_result = subprocess.run(
            ["git", "commit", "-m", f"chore: auto-commit {len(safe_files)} files from health check"],
            cwd=workspace,
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if commit_result.returncode == 0:
            return True, f"Auto-committed {len(safe_files)} files"
        else:
            return False, f"Commit failed: {commit_result.stderr}"
            
    except Exception as e:
        return False, f"Error: {e}"


def fix_backup_dir(workspace: str) -> tuple[bool, str]:
    """Create backup directory if missing."""
    try:
        backup_dir = Path(workspace) / "backups"
        backup_dir.mkdir(exist_ok=True)
        return True, f"Created {backup_dir}"
    except Exception as e:
        return False, f"Failed to create backup dir: {e}"


def fix_memory_dir(workspace: str) -> tuple[bool, str]:
    """Create memory directory if missing."""
    try:
        memory_dir = Path(workspace) / "memory"
        memory_dir.mkdir(exist_ok=True)
        return True, f"Created {memory_dir}"
    except Exception as e:
        return False, f"Failed to create memory dir: {e}"


# Map check names to fixer functions
FIXERS: dict[str, Callable[[str], tuple[bool, str]]] = {
    "workspace.git": fix_git,
    "workspace.backup": fix_backup_dir,
    "workspace.memory": fix_memory_dir,
}


def apply_fixes(report: HealthReport, workspace: str) -> HealthReport:
    """Apply auto-fixes for fixable issues."""
    for check in report.checks:
        if check.fixable and check.status != Status.OK:
            fixer = FIXERS.get(check.name)
            if fixer:
                success, message = fixer(workspace)
                report.fixes_applied.append(f"{'✅' if success else '❌'} {check.name}: {message}")
    
    return report


