#!/usr/bin/env python3
"""
Unified Health Monitor for OpenClaw Workspace
Plugin-based architecture for extensible health checks.

Usage:
    health                    # Full report
    health --check            # Quick status line
    health --json             # JSON output
    health --quiet            # Exit codes only (0=healthy, 1=issues, 2=warnings)
    health --fix              # Auto-fix issues where safe
    health --system           # System checks only
    health --workspace        # Workspace health only
"""

import argparse
import json
import subprocess
import sys
from dataclasses import dataclass, field, asdict
from datetime import datetime, timedelta
from enum import Enum
from pathlib import Path
from typing import Callable, Optional


class Status(Enum):
    OK = "ok"
    WARNING = "warning"
    CRITICAL = "critical"
    UNKNOWN = "unknown"


@dataclass(frozen=True, slots=True)
class CheckResult:
    """Result of a single health check."""
    name: str
    status: Status
    message: str
    value: Optional[str] = None
    threshold: Optional[str] = None
    fixable: bool = False  # Can this be auto-fixed?
    
    @property
    def is_healthy(self) -> bool:
        return self.status == Status.OK
    
    @property
    def icon(self) -> str:
        return {
            Status.OK: "✅",
            Status.WARNING: "⚠️",
            Status.CRITICAL: "❌",
            Status.UNKNOWN: "❓"
        }.get(self.status, "❓")


@dataclass(slots=True)
class HealthReport:
    """Aggregated health report from all checks."""
    timestamp: str
    timezone: str
    checks: list[CheckResult] = field(default_factory=list)
    fixes_applied: list[str] = field(default_factory=list)
    
    @property
    def critical_count(self) -> int:
        return sum(1 for c in self.checks if c.status == Status.CRITICAL)
    
    @property
    def warning_count(self) -> int:
        return sum(1 for c in self.checks if c.status == Status.WARNING)
    
    @property
    def ok_count(self) -> int:
        return sum(1 for c in self.checks if c.status == Status.OK)
    
    @property
    def fixable_count(self) -> int:
        return sum(1 for c in self.checks if c.fixable)
    
    @property
    def has_critical(self) -> bool:
        return self.critical_count > 0
    
    @property
    def has_warnings(self) -> bool:
        return self.warning_count > 0
    
    @property
    def is_healthy(self) -> bool:
        return not self.has_critical and not self.has_warnings
    
    def by_category(self, prefix: str) -> list[CheckResult]:
        """Get checks matching a name prefix."""
        return [c for c in self.checks if c.name.startswith(prefix)]


# =============================================================================
# PLUGIN REGISTRY - Simple decorator pattern, no magic
# =============================================================================

class PluginRegistry:
    """Simple plugin registry using decorators."""
    
    def __init__(self):
        self._plugins: list[Callable[[str], CheckResult]] = []
        self._system_plugins: list[Callable[[str], CheckResult]] = []
        self._workspace_plugins: list[Callable[[str], CheckResult]] = []
    
    def system(self, fn: Callable[[str], CheckResult]) -> Callable[[str], CheckResult]:
        """Register a system-level check."""
        self._plugins.append(fn)
        self._system_plugins.append(fn)
        return fn
    
    def workspace(self, fn: Callable[[str], CheckResult]) -> Callable[[str], CheckResult]:
        """Register a workspace-level check."""
        self._plugins.append(fn)
        self._workspace_plugins.append(fn)
        return fn
    
    @property
    def all_plugins(self) -> list[Callable[[str], CheckResult]]:
        return self._plugins
    
    @property
    def system_plugins(self) -> list[Callable[[str], CheckResult]]:
        return self._system_plugins
    
    @property
    def workspace_plugins(self) -> list[Callable[[str], CheckResult]]:
        return self._workspace_plugins


registry = PluginRegistry()


