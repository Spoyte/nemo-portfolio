STATE_FILE = Path("/root/.openclaw/workspace/memory/health-state.json")


def load_state() -> dict:
    """Load persisted health state."""
    if STATE_FILE.exists():
        return json.loads(STATE_FILE.read_text())
    return {}


def save_state(report: HealthReport) -> None:
    """Persist health state for tracking trends."""
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    # Load existing history
    state = load_state()
    if "history" not in state:
        state["history"] = []
    
    # Add current run
    entry = {
        "timestamp": report.timestamp,
        "healthy": report.is_healthy,
        "ok": report.ok_count,
        "warnings": report.warning_count,
        "critical": report.critical_count
    }
    state["history"].append(entry)
    
    # Keep last 100 entries
    state["history"] = state["history"][-100:]
    
    # Update current status
    state["last_run"] = report.timestamp
    state["last_status"] = "healthy" if report.is_healthy else "issues"
    
    STATE_FILE.write_text(json.dumps(state, indent=2))


@registry.workspace
def check_health_trend(workspace: str) -> CheckResult:
    """Check if health is improving or degrading over time."""
    try:
        state = load_state()
        history = state.get("history", [])
        
        # Need at least 5 runs for meaningful trend analysis
        if len(history) < 5:
            return CheckResult(
                name="workspace.trend",
                status=Status.OK,
                message=f"Building history ({len(history)}/5 runs)"
            )
        
        # Look at last 5 runs
        recent = history[-5:]
        healthy_runs = sum(1 for h in recent if h["healthy"])
        
        if healthy_runs == len(recent):
            return CheckResult(
                name="workspace.trend",
                status=Status.OK,
                message=f"Healthy for last {len(recent)} runs 🎉"
            )
        elif healthy_runs >= len(recent) // 2 + 1:
            return CheckResult(
                name="workspace.trend",
                status=Status.OK,
                message=f"Mostly healthy: {healthy_runs}/{len(recent)} recent runs"
            )
        elif healthy_runs >= len(recent) // 2:
            return CheckResult(
                name="workspace.trend",
                status=Status.WARNING,
                message=f"Mixed health: {healthy_runs}/{len(recent)} recent runs healthy"
            )
        else:
            return CheckResult(
                name="workspace.trend",
                status=Status.CRITICAL,
                message=f"Declining health: only {healthy_runs}/{len(recent)} recent runs healthy"
            )
    except Exception as e:
        return CheckResult(
            name="workspace.trend",
            status=Status.UNKNOWN,
            message=f"Could not analyze trend: {e}"
        )


