#───────────────────────────────────────────────────────────────────────────────
# Main
#───────────────────────────────────────────────────────────────────────────────

main() {
    declare -a ARGS=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cmd_usage
                exit 0
                ;;
            -q|--quiet)
                QUIET=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -j|--json)
                JSON=true
                shift
                ;;
            -*)
                ARGS+=("$1")
                shift
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done
    
    set -- "${ARGS[@]}"
    
    if [[ $# -eq 0 ]]; then
        cmd_status
        exit 0
    fi
    
    case "$1" in
        status)     cmd_status ;;
        list)       cmd_list ;;
        log)        shift; cmd_log "$@" ;;
        insights)   cmd_insights ;;
        sync)       cmd_sync ;;
        compare)    cmd_compare ;;
        help)       cmd_usage ;;
        *)          error "Unknown command: $1\n\nRun 'skill-mastery help' for usage." ;;
    esac
}

main "$@"
