#!/usr/bin/env bash
#
# art-thumbnails — Generate static thumbnail previews for art gallery
#
# Usage: art-thumbnails [options] [art-id]
#
# Examples:
#   art-thumbnails              # Generate all missing thumbnails
#   art-thumbnails flow-field   # Generate specific thumbnail
#   art-thumbnails --regenerate # Force regenerate all

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
NC='\033[0m'

# Configuration
WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/.openclaw/workspace}"
ART_LIB_DIR="$WORKSPACE_DIR/lib/art"
THUMBNAILS_DIR="$WORKSPACE_DIR/public/art-thumbnails"
CANVAS_SIZE=400

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "art-thumbnails — Generate static thumbnail previews for art gallery"
    echo ""
    echo "Usage: art-thumbnails [options] [art-id]"
    echo ""
    echo "Options:"
    echo "  -h, --help        Show this help"
    echo "  -r, --regenerate  Force regenerate all thumbnails"
    echo "  -l, --list        List all art pieces and thumbnail status"
    echo "  -c, --clean       Remove all thumbnails"
    echo "  -q, --quiet       Suppress output"
    echo ""
    echo "Examples:"
    echo "  art-thumbnails              # Generate all missing thumbnails"
    echo "  art-thumbnails flow-field   # Generate specific thumbnail"
    echo "  art-thumbnails --regenerate # Force regenerate all"
    echo "  art-thumbnails --list       # Show status of all pieces"
    exit 0
fi

# Parse arguments
REGENERATE=false
LIST_MODE=false
CLEAN_MODE=false
QUIET=false
TARGET_ART=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--regenerate)
            REGENERATE=true
            shift
            ;;
        -l|--list)
            LIST_MODE=true
            shift
            ;;
        -c|--clean)
            CLEAN_MODE=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}" >&2
            exit 1
            ;;
        *)
            TARGET_ART="$1"
            shift
            ;;
    esac
done

# Logging
log() { [[ "$QUIET" == "true" ]] || echo -e "$@"; }
info() { log "${BLUE}$*${NC}"; }
success() { log "${GREEN}✓ $*${NC}"; }
warn() { log "${YELLOW}⚠ $*${NC}"; }
error() { log "${RED}Error: $*${NC}" >&2; }

# Ensure directories exist
mkdir -p "$THUMBNAILS_DIR"

# Get all art IDs from the art library
get_art_ids() {
    grep -o '"[a-z-]*":' "$ART_LIB_DIR/index.ts" 2>/dev/null | \
        tr -d '":' | \
        sort -u | \
        grep -v '^import$' | \
        grep -v '^rawGenerators$' || true
}

# Get art name from metadata
get_art_name() {
    local art_id="$1"
    # Try to extract from metadata.ts
    grep -A5 "id:.*$art_id" "$ART_LIB_DIR/metadata.ts" 2>/dev/null | \
        grep "name:" | \
        head -1 | \
        sed 's/.*name: *"//;s/".*//' || \
        echo "$art_id"
}

# Get art category from metadata
get_art_category() {
    local art_id="$1"
    grep -A10 "id:.*$art_id" "$ART_LIB_DIR/metadata.ts" 2>/dev/null | \
        grep "category:" | \
        head -1 | \
        sed 's/.*category: *"//;s/".*//' || \
        echo "abstract"
}

# Generate SVG thumbnail for an art piece
generate_thumbnail() {
    local art_id="$1"
    local output_path="$THUMBNAILS_DIR/$art_id.svg"
    
    # Skip if exists and not regenerating
    if [[ "$REGENERATE" == "false" && -f "$output_path" ]]; then
        return 0
    fi
    
    local art_name=$(get_art_name "$art_id")
    local category=$(get_art_category "$art_id")
    
    # Generate category-appropriate SVG pattern
    case "$category" in
        mathematical)
            generate_mathematical_thumbnail "$art_id" "$art_name" > "$output_path"
            ;;
        natural)
            generate_natural_thumbnail "$art_id" "$art_name" > "$output_path"
            ;;
        physics)
            generate_physics_thumbnail "$art_id" "$art_name" > "$output_path"
            ;;
        geometric)
            generate_geometric_thumbnail "$art_id" "$art_name" > "$output_path"
            ;;
        traditional)
            generate_traditional_thumbnail "$art_id" "$art_name" > "$output_path"
            ;;
        *)
            generate_abstract_thumbnail "$art_id" "$art_name" > "$output_path"
            ;;
    esac
    
    success "Generated: $art_id.svg"
}

# Mathematical pattern (fractals, curves)
generate_mathematical_thumbnail() {
    local id="$1"
    local name="$2"
    cat << 'EOF'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
