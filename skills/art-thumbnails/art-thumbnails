}

# Clean mode
if [[ "$CLEAN_MODE" == "true" ]]; then
    info "Removing all thumbnails..."
    rm -rf "$THUMBNAILS_DIR"/*
    success "Thumbnails cleaned"
    exit 0
fi

# List mode
if [[ "$LIST_MODE" == "true" ]]; then
    info "Art Gallery Thumbnail Status"
    log "${GRAY}$(printf '─%.0s' {1..60})${NC}"
    
    total=0
    has_thumb=0
    missing=0
    
    while IFS= read -r art_id; do
        [[ -z "$art_id" ]] && continue
        total=$((total + 1))
        
        thumb_path="$THUMBNAILS_DIR/$art_id.svg"
        name=$(get_art_name "$art_id")
        category=$(get_art_category "$art_id")
        
        if [[ -f "$thumb_path" ]]; then
            log "  ${GREEN}✓${NC} $art_id"
            has_thumb=$((has_thumb + 1))
        else
            log "  ${YELLOW}○${NC} $art_id ${GRAY}($category)${NC}"
            missing=$((missing + 1))
        fi
    done < <(get_art_ids)
    
    log "${GRAY}$(printf '─%.0s' {1..60})${NC}"
    log "Total: $total | With thumbnails: $has_thumb | Missing: $missing"
    exit 0
fi

# Generate thumbnails
if [[ -n "$TARGET_ART" ]]; then
    # Generate specific thumbnail
    info "Generating thumbnail for: $TARGET_ART"
    generate_thumbnail "$TARGET_ART"
else
    # Generate all missing thumbnails
    info "Generating thumbnails..."
    [[ "$REGENERATE" == "true" ]] && warn "Force regenerate mode enabled"
    
    generated=0
    skipped=0
    
    while IFS= read -r art_id; do
        [[ -z "$art_id" ]] && continue
        
        thumb_path="$THUMBNAILS_DIR/$art_id.svg"
        
        if [[ "$REGENERATE" == "false" && -f "$thumb_path" ]]; then
            skipped=$((skipped + 1))
            continue
        fi
        
        generate_thumbnail "$art_id"
        generated=$((generated + 1))
    done < <(get_art_ids)
    
    log ""
    success "Done! Generated: $generated | Skipped: $skipped"
fi

exit 0
