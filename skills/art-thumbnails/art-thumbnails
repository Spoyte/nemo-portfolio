      <stop offset="0%" style="stop-color:#6366f1"/>
      <stop offset="50%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#ec4899"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="#0f0f1a"/>
  <!-- Spiral pattern -->
  <g stroke="url(#mathGrad)" fill="none" stroke-width="1.5" opacity="0.8">
    <path d="M200,150 m0,0 a10,10 0 1,0 20,0 a20,20 0 1,0 -40,0 a30,30 0 1,0 60,0 a40,40 0 1,0 -80,0 a50,50 0 1,0 100,0 a60,60 0 1,0 -120,0"/>
    <path d="M200,150 m0,0 a15,15 0 1,1 30,0 a30,30 0 1,1 -60,0 a45,45 0 1,1 90,0 a60,60 0 1,1 -120,0" transform="rotate(180 200 150)"/>
  </g>
  <!-- Nodes -->
  <circle cx="200" cy="150" r="4" fill="#ec4899"/>
  <circle cx="230" cy="150" r="3" fill="#a855f7" opacity="0.7"/>
  <circle cx="170" cy="150" r="3" fill="#6366f1" opacity="0.7"/>
  <circle cx="200" cy="120" r="3" fill="#a855f7" opacity="0.7"/>
  <circle cx="200" cy="180" r="3" fill="#6366f1" opacity="0.7"/>
  <!-- Label -->
  <text x="200" y="270" text-anchor="middle" fill="#888" font-size="12" font-family="system-ui">Mathematical</text>
</svg>
EOF
}

