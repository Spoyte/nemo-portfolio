# Verify mode - check for orphaned thumbnails and missing pieces
if [[ "$VERIFY_MODE" == "true" ]]; then
    info "Verifying thumbnail consistency..."
    log "${GRAY}$(printf '─%.0s' {1..60})${NC}"
    
    # Get all art IDs
    declare -A ART_IDS
    while IFS= read -r art_id; do
        [[ -n "$art_id" ]] && ART_IDS["$art_id"]=1
    done < <(get_art_ids)
    
    # Check for orphaned thumbnails (no matching art)
    orphaned=0
    while IFS= read -r thumb; do
        thumb_id=$(basename "$thumb" .svg)
        if [[ -z "${ART_IDS[$thumb_id]:-}" ]]; then
            warn "Orphaned: $thumb_id.svg (no matching art piece)"
            orphaned=$((orphaned + 1))
        fi
    done < <(find "$THUMBNAILS_DIR" -name "*.svg" -type f 2>/dev/null)
    
    # Check for missing thumbnails
    missing=0
    for art_id in "${!ART_IDS[@]}"; do
        if [[ ! -f "$THUMBNAILS_DIR/$art_id.svg" ]]; then
            warn "Missing: $art_id.svg"
            missing=$((missing + 1))
        fi
    done
    
    log "${GRAY}$(printf '─%.0s' {1..60})${NC}"
    log "Orphaned: $orphaned | Missing: $missing"
    
    if [[ $orphaned -eq 0 && $missing -eq 0 ]]; then
        success "All thumbnails verified!"
        exit 0
    else
        exit 1
    fi
fi

# Clean mode
if [[ "$CLEAN_MODE" == "true" ]]; then
    info "Removing all thumbnails..."
    rm -rf "$THUMBNAILS_DIR"/*
    success "Thumbnails cleaned"
    exit 0
fi

# List mode
if [[ "$LIST_MODE" == "true" ]]; then
    info "Art Gallery Thumbnail Status"
    log "${GRAY}$(printf '─%.0s' {1..70})${NC}"
    
    total=0
    has_thumb=0
    missing=0
    
    while IFS= read -r art_id; do
        [[ -z "$art_id" ]] && continue
        total=$((total + 1))
        
        thumb_path="$THUMBNAILS_DIR/$art_id.svg"
        name=$(gget_art_name "$art_id")
        category=$(gget_art_category "$art_id")
        
        if [[ -f "$thumb_path" ]]; then
            size=$(stat -c%s "$thumb_path" 2>/dev/null || echo "0")
            size_kb=$(echo "scale=1; $size/1024" | bc)
            printf "  ${GREEN}✓${NC} %-28s ${GRAY}%-12s %5sK${NC}\n" "$art_id" "($category)" "$size_kb"
            has_thumb=$((has_thumb + 1))
        else
            printf "  ${YELLOW}○${NC} %-28s ${GRAY}%-12s${NC}\n" "$art_id" "($category)"
            missing=$((missing + 1))
        fi
    done < <(get_art_ids | sort)
    
    log "${GRAY}$(printf '─%.0s' {1..70})${NC}"
    log "Total: $total | With thumbnails: $has_thumb | Missing: $missing"
    exit 0
fi

# Generate thumbnails
if [[ ${#TARGET_ARTS[@]} -gt 0 ]]; then
    # Generate specific thumbnails
    for art_id in "${TARGET_ARTS[@]}"; do
        info "Generating thumbnail for: $art_id"
        generate_art_thumbnail "$art_id"
    done
else
    # Generate all missing thumbnails
    info "Generating art-specific thumbnails..."
    [[ "$REGENERATE" == "true" ]] && warn "Force regenerate mode enabled"
    
    generated=0
    skipped=0
    
    while IFS= read -r art_id; do
        [[ -z "$art_id" ]] && continue
        
        thumb_path="$THUMBNAILS_DIR/$art_id.svg"
        
        if [[ "$REGENERATE" == "false" && -f "$thumb_path" ]]; then
            skipped=$((skipped + 1))
            continue
        fi
        
        generate_art_thumbnail "$art_id"
        generated=$((generated + 1))
    done < <(get_art_ids)
    
    log ""
    success "Done! Generated: $generated | Skipped: $skipped"
fi

exit 0
