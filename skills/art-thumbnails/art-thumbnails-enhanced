  <text x="200" y="280" text-anchor="middle" fill="#666" font-size="11" font-family="system-ui">${name}</text>
</svg>
EOF
}

# Category-based fallback with custom colors
generate_category_thumbnail() {
    local id="$1" name="$2" category="$3" primary="$4" secondary="$5"
    
    case "$category" in
        mathematical)
            generate_mathematical_thumbnail "$id" "$name" "$primary" "$secondary"
            ;;
        natural)
            generate_natural_thumbnail "$id" "$name" "$primary" "$secondary"
            ;;
        physics)
            generate_physics_thumbnail "$id" "$name" "$primary" "$secondary"
            ;;
        geometric)
            generate_geometric_fallback "$id" "$name" "$primary" "$secondary"
            ;;
        traditional)
            generate_traditional_thumbnail "$id" "$name" "$primary" "$secondary"
            ;;
        *)
            generate_abstract_thumbnail "$id" "$name" "$primary" "$secondary"
            ;;
    esac
}

