#!/usr/bin/env bash
#
# art-thumbnails-enhanced — Generate art-specific SVG thumbnails
#
# Usage: art-thumbnails-enhanced [options] [art-id]
#
# This enhanced version generates unique thumbnails for each art piece
# based on its specific visual characteristics, not just category.

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
NC='\033[0m'

# Configuration
WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/.openclaw/workspace}"
ART_LIB_DIR="$WORKSPACE_DIR/lib/art"
THUMBNAILS_DIR="$WORKSPACE_DIR/public/art-thumbnails"
CANVAS_WIDTH=400
CANVAS_HEIGHT=300

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat << 'EOF'
art-thumbnails-enhanced — Generate art-specific SVG thumbnails

Usage: art-thumbnails-enhanced [options] [art-id]

Options:
  -h, --help        Show this help
  -r, --regenerate  Force regenerate all thumbnails
  -l, --list        List all art pieces and thumbnail status
  -c, --clean       Remove all thumbnails
  -q, --quiet       Suppress output
  -v, --verify      Verify thumbnails match art pieces
  -u, --update      Update missing/outdated thumbnails only

Examples:
  art-thumbnails-enhanced              # Generate all missing thumbnails
  art-thumbnails-enhanced flow-field   # Generate specific thumbnail
  art-thumbnails-enhanced --regenerate # Force regenerate all
  art-thumbnails-enhanced --verify     # Check for orphaned thumbnails
EOF
    exit 0
fi

# Parse arguments
REGENERATE=false
LIST_MODE=false
CLEAN_MODE=false
QUIET=false
VERIFY_MODE=false
UPDATE_MODE=false
declare -a TARGET_ARTS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--regenerate)
            REGENERATE=true
            shift
            ;;
        -l|--list)
            LIST_MODE=true
            shift
            ;;
        -c|--clean)
            CLEAN_MODE=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -v|--verify)
            VERIFY_MODE=true
            shift
            ;;
        -u|--update)
            UPDATE_MODE=true
            shift
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}" >&2
            exit 1
            ;;
        *)
            TARGET_ARTS+=("$1")
            shift
            ;;
    esac
done

# Logging
log() { [[ "$QUIET" == "true" ]] || echo -e "$@"; }
info() { log "${BLUE}$*${NC}"; }
success() { log "${GREEN}✓ $*${NC}"; }
warn() { log "${YELLOW}⚠ $*${NC}"; }
error() { log "${RED}Error: $*${NC}" >&2; }

# Ensure directories exist
mkdir -p "$THUMBNAILS_DIR"

# Get all art IDs from the art library
get_art_ids() {
    grep -o '"[a-z0-9-]*":' "$ART_LIB_DIR/index.ts" 2>/dev/null | \
        tr -d '":' | \
        sort -u | \
        grep -v '^import$' | \
        grep -v '^rawGenerators$' | \
        grep -v '^$' || true
}

# Get art name from metadata.ts
gget_art_name() {
    local art_id="$1"
    # Try metadata.ts first
    local name=$(grep -A5 "\"$art_id\"" "$ART_LIB_DIR/metadata.ts" 2>/dev/null | \
        grep "name:" | \
        head -1 | \
        sed 's/.*name: *"//;s/".*//' || echo "")
    
    # Fallback to the ID with dashes replaced by spaces and title-cased
    if [[ -z "$name" ]]; then
        name=$(echo "$art_id" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')
    fi
    
    echo "$name"
}

# Get art category from metadata
gget_art_category() {
    local art_id="$1"
    grep -A10 "\"$art_id\"" "$ART_LIB_DIR/metadata.ts" 2>/dev/null | \
        grep "category:" | \
        head -1 | \
        sed 's/.*category: *"//;s/".*//' || \
        echo "abstract"
}

# Get tags from metadata
gget_art_tags() {
    local art_id="$1"
    grep -A15 "\"$art_id\"" "$ART_LIB_DIR/metadata.ts" 2>/dev/null | \
        grep "tags:" -A1 | \
        grep -o '"[a-z]*"' | \
        tr -d '"' | \
        tr '\n' ' ' || \
        echo ""
}

# Get primary color based on art characteristics
gget_primary_color() {
    local art_id="$1"
    local tags=$(gget_art_tags "$art_id")
    local category=$(gget_art_category "$art_id")
    
    # Color based on category and tags
    case "$category" in
        mathematical)
            if [[ "$tags" == *"colorful"* ]]; then
                echo "#a855f7"  # Purple
            else
                echo "#6366f1"  # Indigo
            fi
            ;;
        natural)
            if [[ "$tags" == *"colorful"* ]]; then
                echo "#22c55e"  # Green
            else
                echo "#166534"  # Dark green
            fi
            ;;
        physics)
            echo "#0ea5e9"  # Sky blue
            ;;
        geometric)
            if [[ "$tags" == *"colorful"* ]]; then
                echo "#f59e0b"  # Amber
            else
                echo "#f97316"  # Orange
            fi
            ;;
        traditional)
            echo "#d4d4d8"  # Zinc
            ;;
        *)
            if [[ "$tags" == *"colorful"* ]]; then
                echo "#ec4899"  # Pink
            else
                echo "#8b5cf6"  # Violet
            fi
            ;;
    esac
}

# Get secondary color
gget_secondary_color() {
    local art_id="$1"
    local tags=$(gget_art_tags "$art_id")
    
    if [[ "$tags" == *"colorful"* ]]; then
        echo "#f59e0b"  # Amber accent for colorful pieces
    elif [[ "$tags" == *"monochrome"* ]]; then
        echo "#71717a"  # Zinc for monochrome
    else
        echo "#06b6d4"  # Cyan default
    fi
}

# Generate art-specific thumbnail
generate_art_thumbnail() {
    local art_id="$1"
    local output_path="$THUMBNAILS_DIR/$art_id.svg"
    
    # Skip if exists and not regenerating
    if [[ "$REGENERATE" == "false" && -f "$output_path" ]]; then
        return 0
    fi
    
    local art_name=$(gget_art_name "$art_id")
    local category=$(gget_art_category "$art_id")
    local tags=$(gget_art_tags "$art_id")
    local primary=$(gget_primary_color "$art_id")
    local secondary=$(gget_secondary_color "$art_id")
    
    # Generate art-specific pattern based on ID and characteristics
    case "$art_id" in
        flow-field|"flow-field")
            generate_flow_field_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        spirograph|"spirograph")
            generate_spirograph_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        mandelbrot*|"mandelbrot-explorer")
            generate_mandelbrot_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        particle-*|"particle-network"|"particle-swarm")
            generate_particle_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        wave-*|"wave-interference")
            generate_wave_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        *tree*|"recursive-trees"|"lsystem-botany")
            generate_tree_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        *fractal*|"barnsley-fern"|"julia-set"|"lsystem-fractals")
            generate_fractal_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        *geometric*|"geometric-mandala"|"sacred-geometry")
            generate_geometric_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        cellular*|"cellular-automata"|"lenia"|"abelian-sandpile")
            generate_cellular_thumbnail "$art_id" "$art_name" "$primary" "$secondary" > "$output_path"
            ;;
        *)
            # Fallback to category-based with art-specific colors
            generate_category_thumbnail "$art_id" "$art_name" "$category" "$primary" "$secondary" > "$output_path"
            ;;
    esac
    
    success "Generated: $art_id.svg"
}

# Flow field specific thumbnail
generate_flow_field_thumbnail() {
    local id="$1" name="$2" primary="$3" secondary="$4"
    cat << EOF
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="grad${id}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:${primary}"/>
      <stop offset="100%" style="stop-color:${secondary}"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="#0a0a0a"/>
  <!-- Flowing curves representing noise field -->
  <g stroke="url(#grad${id})" fill="none" stroke-width="1.5" opacity="0.6">
    <path d="M50,150 Q100,100 150,150 T250,150 T350,150" />
    <path d="M30,180 Q80,130 130,180 T230,180 T330,180" opacity="0.5"/>
    <path d="M70,120 Q120,70 170,120 T270,120 T370,120" opacity="0.4"/>
    <path d="M40,200 Q90,150 140,200 T240,200 T340,200" opacity="0.5"/>
    <path d="M60,100 Q110,50 160,100 T260,100 T360,100" opacity="0.3"/>
    <path d="M20,220 Q70,170 120,220 T220,220 T320,220" opacity="0.4"/>
  </g>
  <!-- Particle dots -->
  <g fill="${primary}" opacity="0.8">
    <circle cx="100" cy="150" r="2"/>
    <circle cx="200" cy="150" r="2.5"/>
    <circle cx="300" cy="150" r="2"/>
    <circle cx="150" cy="120" r="1.5"/>
    <circle cx="250" cy="180" r="1.5"/>
  </g>
  <text x="200" y="280" text-anchor="middle" fill="#666" font-size="11" font-family="system-ui">${name}</text>
</svg>
EOF
}

# Spirograph specific thumbnail
generate_spirograph_thumbnail() {
    local id="$1" name="$2" primary="$3" secondary="$4"
    cat << EOF
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="grad${id}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:${primary}"/>
      <stop offset="50%" style="stop-color:${secondary}"/>
      <stop offset="100%" style="stop-color:${primary}"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="#0a0a0a"/>
  <!-- Spirograph pattern -->
  <g transform="translate(200,140)" stroke="url(#grad${id})" fill="none" stroke-width="1.2" opacity="0.8">
    <ellipse rx="80" ry="80" opacity="0.3"/>
    <ellipse rx="80" ry="80" transform="rotate(30)" opacity="0.4"/>
    <ellipse rx="80" ry="80" transform="rotate(60)" opacity="0.5"/>
    <ellipse rx="80" ry="80" transform="rotate(90)" opacity="0.6"/>
    <ellipse rx="60" ry="60" opacity="0.4"/>
    <ellipse rx="60" ry="60" transform="rotate(45)" opacity="0.5"/>
    <ellipse rx="40" ry="40" opacity="0.6"/>
    <ellipse rx="40" ry="40" transform="rotate(30)" opacity="0.7"/>
  </g>
  <text x="200" y="280" text-anchor="middle" fill="#666" font-size="11" font-family="system-ui">${name}</text>
</svg>
EOF
}

# Mandelbrot specific thumbnail
generate_mandelbrot_thumbnail() {
    local id="$1" name="$2" primary="$3" secondary="$4"
    cat << EOF
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <radialGradient id="grad${id}" cx="30%" cy="50%">
      <stop offset="0%" style="stop-color:#000"/>
      <stop offset="30%" style="stop-color:${primary}"/>
      <stop offset="60%" style="stop-color:${secondary}"/>
      <stop offset="100%" style="stop-color:#0a0a0a"/>
    </radialGradient>
  </defs>
  <rect width="400" height="300" fill="#0a0a0a"/>
  <!-- Mandelbrot-like cardioid shape -->
  <path d="M200,240 C120,240 80,180 80,140 C80,80 130,40 200,40 C270,40 320,80 320,140 C320,180 280,240 200,240 Z" 
        fill="url(#grad${id})" opacity="0.7"/>
  <!-- Bulb -->
  <circle cx="200" cy="100" r="35" fill="#0a0a0a" opacity="0.9"/>
  <!-- Detail spirals -->
  <g stroke="${secondary}" fill="none" stroke-width="0.8" opacity="0.5">
    <path d="M150,140 Q170,120 190,140"/>
    <path d="M210,140 Q230,120 250,140"/>
    <path d="M180,180 Q200,160 220,180"/>
  </g>
  <text x="200" y="280" text-anchor="middle" fill="#666" font-size="11" font-family="system-ui">${name}</text>
</svg>
EOF
}

