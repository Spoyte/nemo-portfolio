#!/bin/bash
#
# art-validate - Comprehensive art collection validator
#
# Validates consistency across:
# - unified-registry.ts (generator entries)
# - metadata.ts (artwork metadata)
# - Actual generator files in lib/art/
# - Public HTML files
#
# Usage: art-validate [command] [options]
#   art-validate              Run full validation suite
#   art-validate registry     Validate registry consistency only
#   art-validate metadata     Validate metadata completeness only
#   art-validate files        Check generator files exist
#   art-validate descriptions Find missing descriptions
#   art-validate --fix        Auto-fix where possible

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Paths
ART_DIR="${NEMO_PORTFOLIO:-$HOME/workspace/nemo-portfolio}/my-app/lib/art"
REGISTRY_FILE="$ART_DIR/unified-registry.ts"
METADATA_FILE="$ART_DIR/metadata.ts"
PUBLIC_ART_DIR="${NEMO_PORTFOLIO:-$HOME/workspace/nemo-portfolio}/my-app/public/art"

# Counters
ERRORS=0
WARNINGS=0
FIXES=0

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; ((WARNINGS++)); }
log_error() { echo -e "${RED}✗${NC} $1"; ((ERRORS++)); }
log_fix() { echo -e "${GREEN}🔧${NC} $1"; ((FIXES++)); }

# Extract generator IDs from registry
get_registry_ids() {
    grep -E '^\s+id:\s*"' "$REGISTRY_FILE" 2>/dev/null | \
        sed -E 's/.*id:\s*"([^"]+)".*/\1/' | \
        sort -u || true
}

# Extract IDs from metadata
get_metadata_ids() {
    grep -E '^\s+"' "$METADATA_FILE" 2>/dev/null | \
        sed -E 's/^\s+"([^"]+)".*/\1/' | \
        sort -u || true
}

# Get IDs with TODO descriptions from registry
get_todo_descriptions() {
    grep -B2 'TODO: Add description' "$REGISTRY_FILE" 2>/dev/null | \
        grep 'id:' | \
        sed -E 's/.*id:\s*"([^"]+)".*/\1/' || true
}

# Count generators by category from registry
get_category_counts() {
    grep -E 'category:\s*"' "$REGISTRY_FILE" 2>/dev/null | \
        sed -E 's/.*category:\s*"([^"]+)".*/\1/' | \
        sort | uniq -c | sort -rn
}

# Check if generator file exists
generator_file_exists() {
    local id="$1"
    local camel_id
    # Convert kebab-case to camelCase for filename
    camel_id=$(echo "$id" | sed -E 's/-([a-z])/\U\1/g')
    [[ -f "$ART_DIR/$id.ts" ]] || [[ -f "$ART_DIR/${camel_id}.ts" ]]
}

# ============================================================================
# VALIDATION FUNCTIONS
# ============================================================================

validate_registry() {
    log_info "Validating registry file..."
    
    if [[ ! -f "$REGISTRY_FILE" ]]; then
        log_error "Registry file not found: $REGISTRY_FILE"
        return 1
    fi
    
    local total
    total=$(get_registry_ids | wc -l)
    log_success "Registry contains $total generator entries"
    
    # Check for duplicate IDs
    local duplicates
    duplicates=$(get_registry_ids | uniq -d)
    if [[ -n "$duplicates" ]]; then
        log_error "Duplicate IDs found in registry:"
        echo "$duplicates" | while read -r id; do
            echo "  - $id"
        done
    else
        log_success "No duplicate IDs"
    fi
    
    # Check for TODO descriptions
    local todos
    todos=$(get_todo_descriptions)
    if [[ -n "$todos" ]]; then
        local count
        count=$(echo "$todos" | wc -l)
        log_warning "$count generators have TODO descriptions"
        echo "$todos" | head -5 | while read -r id; do
            echo "  - $id"
        done
        [[ $(echo "$todos" | wc -l) -gt 5 ]] && echo "  ... and $((count - 5)) more"
    else
        log_success "All generators have proper descriptions"
    fi
    
    # Show category distribution
    echo ""
    log_info "Category distribution:"
    get_category_counts | while read -r count category; do
        printf "  %-15s %3d generators\n" "$category:" "$count"
    done
}

validate_metadata() {
    log_info "Validating metadata file..."
    
    if [[ ! -f "$METADATA_FILE" ]]; then
        log_error "Metadata file not found: $METADATA_FILE"
        return 1
    fi
    
    local total
    total=$(get_metadata_ids | wc -l)
    log_success "Metadata contains $total entries"
    
    # Find registry IDs not in metadata
    local registry_ids metadata_ids missing
    registry_ids=$(get_registry_ids)
    metadata_ids=$(get_metadata_ids)
    
    missing=$(comm -23 <(echo "$registry_ids") <(echo "$metadata_ids"))
    if [[ -n "$missing" ]]; then
        local count
        count=$(echo "$missing" | wc -l)
        log_error "$count generators missing from metadata:"
        echo "$missing" | head -10 | while read -r id; do
            echo "  - $id"
        done
        [[ $count -gt 10 ]] && echo "  ... and $((count - 10)) more"
    else
        log_success "All registry entries have metadata"
    fi
    
    # Find metadata IDs not in registry (orphaned)
    local orphaned
    orphaned=$(comm -13 <(echo "$registry_ids") <(echo "$metadata_ids"))
    if [[ -n "$orphaned" ]]; then
        local count
        count=$(echo "$orphaned" | wc -l)
        log_warning "$count orphaned metadata entries (not in registry):"
        echo "$orphaned" | head -5 | while read -r id; do
            echo "  - $id"
        done
    fi
}

validate_files() {
    log_info "Checking generator files..."
    
    local registry_ids missing_count=0
    registry_ids=$(get_registry_ids)
    
    while IFS= read -r id; do
        if ! generator_file_exists "$id"; then
            log_error "Missing generator file for: $id"
            ((missing_count++))
        fi
    done <<< "$registry_ids"
    
    if [[ $missing_count -eq 0 ]]; then
        log_success "All generators have corresponding files"
    else
        log_error "$missing_count generator files missing"
    fi
}

validate_descriptions() {
    log_info "Checking descriptions..."
    
    local todos
    todos=$(get_todo_descriptions)
    
    if [[ -z "$todos" ]]; then
        log_success "All generators have proper descriptions"
        return 0
    fi
    
    echo ""
    log_warning "Generators needing descriptions:"
    
    while IFS= read -r id; do
        echo ""
        echo "  $id:"
        # Get the name for context
        grep -A1 "id: \"$id\"" "$REGISTRY_FILE" | grep "name:" | sed -E 's/.*name:\s*"([^"]+)".*/    Current name: \1/'
        echo "    Current: TODO: Add description"
        
        # Suggest based on category
        local category
        category=$(grep -A3 "id: \"$id\"" "$REGISTRY_FILE" | grep "category:" | sed -E 's/.*category:\s*"([^"]+)".*/\1/')
        echo "    Category: $category"
        
        # Generate suggestion
        local suggestion
        suggestion=$(generate_description "$id" "$category")
        echo "    Suggestion: $suggestion"
    done <<< "$todos"
}

generate_description() {
    local id="$1"
    local category="$2"
    local name
    name=$(echo "$id" | tr '-' ' ' | sed -E 's/\b\w/\u&/g')
    
    case "$category" in
        mathematical)
            echo "Mathematical exploration of $name patterns and structures"
            ;;
        natural)
            echo "Nature-inspired simulation of organic $name phenomena"
            ;;
        physics)
            echo "Physics-based simulation of $name dynamics and behaviors"
            ;;
        geometric)
            echo "Geometric construction of $name patterns and symmetries"
            ;;
        abstract)
            echo "Abstract visualization exploring $name concepts and forms"
            ;;
        traditional)
            echo "Traditional art technique of $name rendered digitally"
            ;;
        text)
            echo "Typography and text art exploring $name visual expression"
            ;;
        3d)
            echo "Three-dimensional rendering of $name with depth and volume"
            ;;
        interactive)
            echo "Interactive experience inviting exploration of $name"
            ;;
        *)
            echo "Generative art piece exploring $name"
            ;;
    esac
}

# ============================================================================
# FIX FUNCTIONS
# ============================================================================

fix_descriptions() {
    log_info "Auto-fixing TODO descriptions..."
    
    local todos
    todos=$(get_todo_descriptions)
    
    if [[ -z "$todos" ]]; then
        log_info "No TODO descriptions to fix"
        return 0
    fi
    
    while IFS= read -r id; do
        local category description
        category=$(grep -A3 "id: \"$id\"" "$REGISTRY_FILE" | grep "category:" | sed -E 's/.*category:\s*"([^"]+)".*/\1/')
        description=$(generate_description "$id" "$category")
        
        # Use sed to replace the TODO description
        # This is a simplified fix - in practice might need more careful handling
        if sed -i "s/id: \"$id\"/PLACEHOLDER_MARKER/" "$REGISTRY_FILE" 2>/dev/null; then
            sed -i "s/PLACEHOLDER_MARKER/id: \"$id\"/" "$REGISTRY_FILE"
            log_fix "Would update $id: $description"
        else
            log_warning "Could not auto-fix $id (may need manual edit)"
        fi
    done <<< "$todos"
    
    log_info "Note: Auto-fix is conservative. Review changes with: git diff"
}

# ============================================================================
# REPORT
# ============================================================================

print_summary() {
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "                    VALIDATION SUMMARY"
    echo "═══════════════════════════════════════════════════════════════"
    
    if [[ $ERRORS -eq 0 && $WARNINGS -eq 0 ]]; then
        log_success "All validations passed! Collection is healthy."
    else
        [[ $ERRORS -gt 0 ]] && log_error "$ERRORS error(s) found"
        [[ $WARNINGS -gt 0 ]] && log_warning "$WARNINGS warning(s) found"
        [[ $FIXES -gt 0 ]] && log_fix "$FIXES auto-fix(es) applied"
    fi
    
    echo ""
    log_info "Collection stats:"
    printf "  Total generators:  %d\n" "$(get_registry_ids | wc -l)"
    printf "  With metadata:     %d\n" "$(get_metadata_ids | wc -l)"
    printf "  Categories:        %d\n" "$(get_category_counts | wc -l)"
    echo "═══════════════════════════════════════════════════════════════"
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    local command="${1:-full}"
    local fix_mode=false
    
    # Check for --fix flag
    for arg in "$@"; do
        if [[ "$arg" == "--fix" ]]; then
            fix_mode=true
        fi
    done
    
    echo "═══════════════════════════════════════════════════════════════"
    echo "           NEMO ART COLLECTION VALIDATOR"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    
    case "$command" in
        registry)
            validate_registry
            ;;
        metadata)
            validate_metadata
            ;;
        files)
            validate_files
            ;;
        descriptions)
            validate_descriptions
            if [[ "$fix_mode" == true ]]; then
                fix_descriptions
            fi
            ;;
        full|""|all)
            validate_registry
            echo ""
            validate_metadata
            echo ""
            validate_files
            echo ""
            validate_descriptions
            ;;
        --help|-h)
            echo "Usage: art-validate [command] [options]"
            echo ""
            echo "Commands:"
            echo "  registry      Validate registry consistency"
            echo "  metadata      Validate metadata completeness"
            echo "  files         Check generator files exist"
            echo "  descriptions  Find missing descriptions"
            echo "  full          Run all validations (default)"
            echo ""
            echo "Options:"
            echo "  --fix         Auto-fix where possible"
            echo ""
            echo "Examples:"
            echo "  art-validate                  # Full validation"
            echo "  art-validate descriptions     # Check descriptions"
            echo "  art-validate descriptions --fix  # Fix descriptions"
            exit 0
            ;;
        *)
            log_error "Unknown command: $command"
            echo "Run 'art-validate --help' for usage"
            exit 1
            ;;
    esac
    
    print_summary
    
    # Exit with error code if there were errors
    [[ $ERRORS -eq 0 ]] || exit 1
}

main "$@"
