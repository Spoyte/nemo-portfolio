# FOCUS TIMER
# ─────────────────────────────────────────────────────────────────────────────

def cmd_focus(args: List[str]) -> int:
    """Minimalist focus timer."""
    minutes = 25
    message = "focus"
    
    if len(args) > 0:
        try:
            minutes = int(args[0])
        except ValueError:
            message = args[0]
    
    if len(args) > 1:
        message = args[1]
    
    total_seconds = minutes * 60
    end_time = datetime.now() + timedelta(seconds=total_seconds)
    
    interrupted = False
    
    def on_signal(signum, frame):
        nonlocal interrupted
        interrupted = True
    
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    
    print(f"■ {message} — {minutes} min")
    print(f"  until {end_time.strftime('%H:%M')}")
    print("  ─────────")
    
    start = time.time()
    
    try:
        while not interrupted:
            elapsed = time.time() - start
            remaining = max(0, total_seconds - int(elapsed))
            
            if remaining == 0:
                break
            
            progress = (elapsed / total_seconds) * 100
            bar = "█" * int(progress / 10) + "░" * (10 - int(progress / 10))
            
            print(f"\r  {bar} {remaining // 60:02d}:{remaining % 60:02d}", end="", flush=True)
            time.sleep(0.5)
        
        print(f"\r  {'█' * 10} 00:00 ✓")
        print(f"\n  ■ {message} — complete")
        
    except KeyboardInterrupt:
        print("\n  paused")
        return 130
    
    return 0

