def cmd_diary(args: List[str]) -> int:
    """Quick diary entry."""
    today = datetime.now()
    filename = today.strftime("%Y-%m-%d") + ".md"
    filepath = DIARY_DIR / filename
    
    # Build entry
    entry_text = " ".join(args) if args else ""
    
    timestamp = today.strftime("%H:%M")
    
    if filepath.exists():
        # Append to existing
        with open(filepath, "a") as f:
            f.write(f"\n\n## {timestamp}\n\n{entry_text}\n")
    else:
        # Create new
        with open(filepath, "w") as f:
            f.write(f"# {today.strftime('%A, %B %d, %Y')}\n\n")
            f.write(f"## {timestamp}\n\n{entry_text}\n")
    
    print(f"  ✓ Entry saved to {filepath}")
    return 0

