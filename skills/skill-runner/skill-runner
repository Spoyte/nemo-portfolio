#!/usr/bin/env bash
#
# skill-runner — Unified skill interface
# One command to discover and run all workspace skills
#
# Rams Test: Innovative ✓ Useful ✓ Aesthetic ✓ Understandable ✓ 
#           Unobtrusive ✓ Honest ✓ Long-lasting ✓ Thorough ✓ 
#           Environmentally friendly ✓ Less design ✓
#

set -euo pipefail

#───────────────────────────────────────────────────────────────────────────────
# Configuration & Colors
#───────────────────────────────────────────────────────────────────────────────

readonly SKILLS_DIR="${SKILLS_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
readonly VERSION="2.1.0"

QUIET=false
JSON=false
VERBOSE=false

# Colors (disabled if not tty)
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly CYAN='\033[0;36m'
    readonly GRAY='\033[0;90m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' BLUE='' CYAN='' GRAY='' BOLD='' NC=''
fi

#───────────────────────────────────────────────────────────────────────────────
# Output Helpers
#───────────────────────────────────────────────────────────────────────────────

error() {
    echo -e "${RED}✗${NC} $1" >&2
    exit 1
}

warn() {
    $QUIET || echo -e "${YELLOW}⚠${NC} $1" >&2
}

info() {
    $QUIET || echo -e "$1"
}

success() {
    $QUIET || echo -e "${GREEN}✓${NC} $1"
}

#───────────────────────────────────────────────────────────────────────────────
# Skill Discovery
#───────────────────────────────────────────────────────────────────────────────

# Cache skill list to avoid repeated filesystem scans
declare -a SKILL_CACHE=()
_cache_skills() {
    if [[ ${#SKILL_CACHE[@]} -eq 0 ]]; then
        for skill_dir in "$SKILLS_DIR"/*/; do
            [[ -d "$skill_dir" ]] || continue
            local skill_name=$(basename "$skill_dir")
            [[ -f "$skill_dir/SKILL.md" ]] && SKILL_CACHE+=("$skill_name")
        done
    fi
}

# Check if a skill exists
skill_exists() {
    [[ -d "$SKILLS_DIR/$1" ]] && [[ -f "$SKILLS_DIR/$1/SKILL.md" ]]
}

# Get skill description from SKILL.md
get_skill_desc() {
    local skill_md="$SKILLS_DIR/$1/SKILL.md"
    if [[ -f "$skill_md" ]]; then
        grep -E "^description:" "$skill_md" 2>/dev/null | head -1 | \
            sed 's/description: *"*\([^"]*\)"*/\1/' | cut -d'.' -f1
    fi
}

# Check if skill has executable
skill_has_exe() {
    [[ -x "$SKILLS_DIR/$1/$1" ]]
}

#───────────────────────────────────────────────────────────────────────────────
# Commands
#───────────────────────────────────────────────────────────────────────────────

cmd_usage() {
    cat << 'EOF'
Usage: nemo <command> [options]

Commands:
  list [options]          List all available skills
  info <skill>            Show detailed skill information  
  docs <skill>            Display skill documentation
  search <query>          Find skills matching keyword
  exec <skill> <script>   Run specific script from skill
  sync                    Auto-manage bin/ symlinks
  help <skill>            Show skill help (if available)
  version                 Show version information
  completion -s <shell>   Generate shell completion script

  <skill> [args...]       Run a skill directly

List Options:
  -q, --quiet             Output names only (for scripting)
  -v, --verbose           Include descriptions
  -j, --json              Output as JSON

Global Options:
  -h, --help              Show this help message

Examples:
  nemo list -v                    # List with descriptions
  nemo list -q | xargs -n1        # Process all skills
  nemo art-new flow "Flow Field"  # Run art-new skill
  nemo info backup-restore        # Show skill details
  nemo search git                 # Find git-related skills
  nemo help art-new               # Show art-new help
  nemo sync                       # Update bin/ symlinks

EOF
}

cmd_version() {
    echo "nemo $VERSION"
    echo "Skills directory: $SKILLS_DIR"
    _cache_skills
    echo "Available skills: ${#SKILL_CACHE[@]}"
}

cmd_list() {
    local quiet=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose) VERBOSE=true ;;
            -q|--quiet) quiet=true ;;
            -j|--json) JSON=true ;;
            *) warn "Unknown option: $1" ;;
        esac
        shift
    done
    
    _cache_skills
    
    # JSON output
    if $JSON; then
        local first=true
        echo "["
        for skill_name in "${SKILL_CACHE[@]}"; do
            local desc=$(get_skill_desc "$skill_name")
            local has_exe=$(skill_has_exe "$skill_name" && echo "true" || echo "false")
            
            if $first; then
                first=false
            else
                echo ","
            fi
            printf '  {"name": "%s", "description": "%s", "executable": %s}' \
                "$skill_name" "${desc:-}" "$has_exe"
        done
        echo ""
        echo "]"
        return 0
    fi
    
    # Quiet output (names only)
    if $quiet; then
        printf '%s\n' "${SKILL_CACHE[@]}"
        return 0
    fi
    
    # Normal/Verbose output
    if ! $QUIET; then
        if $VERBOSE; then
            echo -e "${CYAN}Available Skills${NC}"
            echo ""
        fi
    fi
    
    local count=0
    local executable_count=0
    
    for skill_name in "${SKILL_CACHE[@]}"; do
        local desc=$(get_skill_desc "$skill_name")
        local exe_marker
        
        if skill_has_exe "$skill_name"; then
            exe_marker="${GREEN}⚡${NC} "
            ((executable_count++)) || true
        else
            exe_marker="${GRAY}○${NC} "
        fi
        
        if $VERBOSE; then
            printf "  %b%-22s${NC} %s\n" "$exe_marker" "$skill_name" "${desc:-No description}"
        else
            printf "  %b%s${NC}\n" "$exe_marker" "$skill_name"
        fi
        ((count++)) || true
    done
    
    if ! $QUIET; then
        echo ""
        if ! $VERBOSE; then
            echo -e "${GRAY}Run 'nemo list -v' for descriptions${NC}"
            echo -e "${GRAY}Run 'nemo info <skill>' for details${NC}"
        fi
        echo -e "${GRAY}$count skills ($executable_count executable)${NC}"
    fi
}

cmd_info() {
    local skill_name="${1:-}"
    [[ -z "$skill_name" ]] && error "Usage: nemo info <skill>"
    
    skill_exists "$skill_name" || error "Skill '$skill_name' not found"
    
    local skill_dir="$SKILLS_DIR/$skill_name"
    local skill_md="$skill_dir/SKILL.md"
    
    # Parse SKILL.md frontmatter
    local name=$(grep -E "^name:" "$skill_md" 2>/dev/null | head -1 | sed 's/name: *//')
    local desc=$(grep -E "^description:" "$skill_md" 2>/dev/null | head -1 | sed 's/description: *"*\([^"]*\)"*/\1/')
    
    echo -e "${CYAN}${BOLD}${skill_name}${NC}"
    echo ""
    echo -e "  ${BOLD}Description:${NC} ${desc:-None}"
    
    if skill_has_exe "$skill_name"; then
        echo -e "  ${BOLD}Executable:${NC}  ${GREEN}Yes${NC} → $skill_dir/$skill_name"
    else
        echo -e "  ${BOLD}Executable:${NC}  ${RED}No${NC} (documentation only)"
    fi
    
    echo -e "  ${BOLD}Location:${NC}    $skill_dir"
    
    # List scripts
    if [[ -d "$skill_dir/scripts" ]]; then
        local scripts=()
        for script in "$skill_dir/scripts"/*; do
            [[ -f "$script" ]] && scripts+=("$(basename "$script")")
        done
        
        if [[ ${#scripts[@]} -gt 0 ]]; then
            echo ""
            echo -e "  ${BOLD}Scripts:${NC}"
            for script in "${scripts[@]}"; do
                echo -e "    ${GREEN}•${NC} $script"
            done
        fi
    fi
    
    # List subdirectories
    local subdirs=()
    for subdir in "$skill_dir"/*/; do
        [[ -d "$subdir" ]] || continue
        local subname=$(basename "$subdir")
        [[ "$subname" != "scripts" ]] && subdirs+=("$subname")
    done
    
    if [[ ${#subdirs[@]} -gt 0 ]]; then
        echo ""
        echo -e "  ${BOLD}Contents:${NC}"
        for subdir in "${subdirs[@]}"; do
            echo -e "    ${BLUE}📁${NC} $subdir/"
        done
    fi
}

cmd_docs() {
    local skill_name="${1:-}"
    [[ -z "$skill_name" ]] && error "Usage: nemo docs <skill>"
    
    skill_exists "$skill_name" || error "Skill '$skill_name' not found"
    
    local skill_md="$SKILLS_DIR/$skill_name/SKILL.md"
    
    # Strip YAML frontmatter and display
    sed '1{/^---$/!b;:a;N;/\n---$/!ba;d}' "$skill_md" | cat
}

cmd_search() {
    local query="${1:-}"
    [[ -z "$query" ]] && error "Usage: nemo search <query>"
    
    echo -e "${CYAN}Search results for '${BOLD}$query${NC}${CYAN}':${NC}"
    echo ""
    
    local found=false
    _cache_skills
    
    for skill_name in "${SKILL_CACHE[@]}"; do
        local skill_md="$SKILLS_DIR/$skill_name/SKILL.md"
        
        if grep -qi "$query" "$skill_md" 2>/dev/null; then
            local desc=$(get_skill_desc "$skill_name")
            local exe_marker=$(skill_has_exe "$skill_name" && echo "${GREEN}⚡${NC}" || echo "${GRAY}○${NC}")
            printf "  %b %-20s %s\n" "$exe_marker" "$skill_name" "${desc:-}"
            found=true
        fi
    done
    
    if ! $found; then
        echo -e "  ${GRAY}No skills found matching '$query'${NC}"
        echo ""
        echo -e "  ${GRAY}Try: nemo list | grep -i $query${NC}"
    fi
}

cmd_exec() {
    local skill_name="${1:-}"
    local script_name="${2:-}"
    
    [[ -z "$skill_name" ]] && error "Usage: nemo exec <skill> <script>"
    [[ -z "$script_name" ]] && error "Usage: nemo exec $skill_name <script>"
    
    skill_exists "$skill_name" || error "Skill '$skill_name' not found"
    
    local script_path="$SKILLS_DIR/$skill_name/scripts/$script_name"
    
    [[ -f "$script_path" ]] || error "Script '$script_name' not found in skill '$skill_name'"
    [[ -x "$script_path" ]] || error "Script '$script_name' is not executable (chmod +x?)"
    
    shift 2
    exec "$script_path" "$@"
}

cmd_help_skill() {
    local skill_name="${1:-}"
    [[ -z "$skill_name" ]] && error "Usage: nemo help <skill>"
    
    skill_exists "$skill_name" || error "Skill '$skill_name' not found"
    
    local skill_exe="$SKILLS_DIR/$skill_name/$skill_name"
    
    if [[ -x "$skill_exe" ]]; then
        # Try common help flags
        if "$skill_exe" --help &>/dev/null; then
            "$skill_exe" --help
        elif "$skill_exe" -h &>/dev/null; then
            "$skill_exe" -h
        elif "$skill_exe" help &>/dev/null; then
            "$skill_exe" help
        else
            echo -e "${YELLOW}Skill '$skill_name' doesn't provide built-in help${NC}"
            echo ""
            echo "Try: nemo docs $skill_name"
        fi
    else
        echo -e "${YELLOW}Skill '$skill_name' has no executable${NC}"
        echo ""
        echo "Documentation: nemo docs $skill_name"
    fi
}

cmd_run() {
    local skill_name="$1"
    shift
    
    skill_exists "$skill_name" || error "Unknown command or skill: '$skill_name'\n\nRun 'nemo list' to see available skills."
    
    local skill_exe="$SKILLS_DIR/$skill_name/$skill_name"
    
    [[ -f "$skill_exe" ]] || error "Skill '$skill_name' has no executable\n\nThis skill is documentation-only. Try: nemo docs $skill_name"
    [[ -x "$skill_exe" ]] || error "Skill '$skill_name' exists but is not executable\n\nTry: chmod +x $skill_exe"
    
    exec "$skill_exe" "$@"
}

cmd_sync() {
    # Auto-manage symlinks in bin/ directory
    local bin_dir="$(dirname "$SKILLS_DIR")/bin"
    local created=0 removed=0
    
    # Ensure bin directory exists
    [[ -d "$bin_dir" ]] || mkdir -p "$bin_dir"
    
    _cache_skills
    
    # Create symlinks for skills with executables
    for skill_name in "${SKILL_CACHE[@]}"; do
        local skill_exe="$SKILLS_DIR/$skill_name/$skill_name"
        local symlink="$bin_dir/$skill_name"
        
        if [[ -x "$skill_exe" ]]; then
            if [[ ! -e "$symlink" ]]; then
                ln -s "$skill_exe" "$symlink"
                ((created++)) || true
                $QUIET || echo -e "${GREEN}+${NC} $skill_name"
            fi
        fi
    done
    
    # Remove stale symlinks (pointing to non-existent skills)
    for symlink in "$bin_dir"/*; do
        [[ -L "$symlink" ]] || continue
        
        local target=$(readlink "$symlink")
        local skill_name=$(basename "$symlink")
        
        # Check if target is a skill executable
        if [[ "$target" == "$SKILLS_DIR"/* ]] && [[ "$target" == *"/$skill_name/$skill_name" ]]; then
            if [[ ! -f "$target" ]]; then
                rm "$symlink"
                ((removed++)) || true
                $QUIET || echo -e "${RED}-${NC} $skill_name (stale)"
            fi
        fi
    done
    
    $QUIET || echo ""
    success "Synced: $created created, $removed removed"
}

cmd_completion() {
    local shell="bash"
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--shell) shell="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    
    case "$shell" in
        bash)
            cat << 'EOF'
_nemo_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    
    local commands="list info docs search exec help version completion"
    local skills=""
    
    if [[ -d "$SKILLS_DIR" ]]; then
        for d in "$SKILLS_DIR"/*/; do
            [[ -d "$d" ]] || continue
            [[ -f "$d/SKILL.md" ]] && skills="$skills $(basename "$d")"
        done
    fi
    
    case "$COMP_CWORD" in
        1)
            COMPREPLY=($(compgen -W "$commands $skills" -- "$cur"))
            ;;
        2)
            case "$prev" in
                info|docs|help|exec)
                    COMPREPLY=($(compgen -W "$skills" -- "$cur"))
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            ;;
        *)
            COMPREPLY=()
            ;;
    esac
}

complete -F _nemo_completion nemo
EOF
            ;;
        zsh)
            cat << 'EOF'
#compdef nemo

_nemo() {
    local curcontext="$curcontext" state line
    typeset -A opt_args
    
    local -a commands=(list info docs search exec help version completion)
    local -a skills=(${(f)"$(find "$SKILLS_DIR" -maxdepth 1 -name '*.md' -prune -o -type d -print 2>/dev/null | grep -v '^$' | xargs -n1 basename 2>/dev/null)"})
    
    _arguments -C \
        '1: :->command' \
        '2: :->skill' \
        '*:: :->args'
    
    case "$state" in
        command)
            _describe -t commands 'command' commands
            _describe -t skills 'skill' skills
            ;;
        skill)
            case "$line[1]" in
                info|docs|help|exec)
                    _describe -t skills 'skill' skills
                    ;;
            esac
            ;;
    esac
}

compdef _nemo nemo
EOF
            ;;
        fish)
            cat << 'EOF'
complete -c nemo -f
complete -c nemo -n "__fish_use_subcommand" -a "list info docs search exec help version completion"
complete -c nemo -n "__fish_seen_subcommand_from info docs help exec" -a "(ls $SKILLS_DIR 2>/dev/null)"
EOF
            ;;
        *)
            error "Unknown shell: $shell\nSupported: bash, zsh, fish"
            ;;
    esac
}

#───────────────────────────────────────────────────────────────────────────────
# Main Entry Point
#───────────────────────────────────────────────────────────────────────────────

main() {
    # Parse global options
    declare -a ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cmd_usage
                exit 0
                ;;
            -q|--quiet)
                QUIET=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -j|--json)
                JSON=true
                shift
                ;;
            --version)
                cmd_version
                exit 0
                ;;
            -*)
                ARGS+=("$1")
                shift
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done
    
    set -- "${ARGS[@]}"
    
    # No arguments = list skills
    if [[ $# -eq 0 ]]; then
        cmd_list
        exit 0
    fi
    
    # Dispatch to command handler
    case "$1" in
        list)       shift; cmd_list "$@" ;;
        info)       shift; cmd_info "$1" ;;
        docs)       shift; cmd_docs "$1" ;;
        search)     shift; cmd_search "$1" ;;
        exec)       shift; cmd_exec "$@" ;;
        help)       shift; cmd_help_skill "$1" ;;
        sync)       shift; cmd_sync "$@" ;;
        version)    cmd_version ;;
        completion) shift; cmd_completion "$@" ;;
        *)          cmd_run "$@" ;;
    esac
}

main "$@"
