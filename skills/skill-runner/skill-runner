# ─────────────────────────────────────────────────────────────────────────────

def load_tasks() -> List[Dict]:
    """Load tasks from JSON file."""
    if not TASKS_FILE.exists():
        return []
    try:
        with open(TASKS_FILE) as f:
            return json.load(f).get("tasks", [])
    except:
        return []

def save_tasks(tasks: List[Dict]) -> None:
    """Save tasks to JSON file."""
    with open(TASKS_FILE, "w") as f:
        json.dump({"tasks": tasks}, f, indent=2)

def cmd_track(args: List[str]) -> int:
    """Minimalist daily task tracker."""
    if not args:
        args = ["list"]
    
    command = args[0]
    tasks = load_tasks()
    today = datetime.now().strftime("%Y-%m-%d")
    
    if command == "add":
        if len(args) < 2:
            print("Usage: nemo track add <task description>")
            return 1
        
        task_text = " ".join(args[1:])
        task = {
            "id": len(tasks) + 1,
            "text": task_text,
            "created": today,
            "done": False,
            "done_date": None
        }
        tasks.append(task)
        save_tasks(tasks)
        print(f"  + Task #{task['id']}: {task_text}")
        
    elif command == "done":
        if len(args) < 2:
            print("Usage: nemo track done <task-id>")
            return 1
        
        try:
            task_id = int(args[1])
            for task in tasks:
                if task["id"] == task_id:
                    task["done"] = True
                    task["done_date"] = today
                    save_tasks(tasks)
                    print(f"  ✓ Task #{task_id} completed")
                    return 0
            print(f"  ✗ Task #{task_id} not found")
        except ValueError:
            print("  ✗ Task ID must be a number")
            
    elif command == "rm":
        if len(args) < 2:
            print("Usage: nemo track rm <task-id>")
            return 1
        
        try:
            task_id = int(args[1])
            tasks = [t for t in tasks if t["id"] != task_id]
            save_tasks(tasks)
            print(f"  − Removed task #{task_id}")
        except ValueError:
            print("  ✗ Task ID must be a number")
            
    elif command == "list":
        pending = [t for t in tasks if not t["done"]]
        completed = [t for t in tasks if t["done"]]
        
        print(f"\n  ──────── Tasks ────────")
        if pending:
            print(f"  Pending ({len(pending)}):")
            for task in pending:
                print(f"    {task['id']:>3}. {task['text']}")
        else:
            print("  No pending tasks")
        
        if completed:
            print(f"\n  Completed ({len(completed)}):")
            for task in completed[-5:]:  # Show last 5
                print(f"    ✓ {task['text']}")
        print(f"  ──────────────────────\n")
        
    else:
        print(f"Unknown command: {command}")
        print("Usage: nemo track [add|done|list|rm]")
        return 1
    
    return 0

