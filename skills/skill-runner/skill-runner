# SKILL DISCOVERY & EXECUTION
# ─────────────────────────────────────────────────────────────────────────────

def discover_skills() -> Dict[str, Path]:
    """Discover all available skills from skill directories."""
    skills = {}
    
    for skill_path in SKILL_PATHS:
        if not skill_path.exists():
            continue
        
        for item in skill_path.iterdir():
            if item.is_dir() and not item.name.startswith("."):
                # Look for executable with same name as directory
                executable = item / item.name
                if executable.exists() and os.access(executable, os.X_OK):
                    skills[item.name] = executable
                else:
                    # Look for any executable in the directory
                    for subitem in item.iterdir():
                        if subitem.is_file() and os.access(subitem, os.X_OK) and not subitem.name.startswith("."):
                            skills[item.name] = subitem
                            break
    
    return skills

def run_skill(skill_path: Path, args: List[str]) -> int:
    """Execute a skill with given arguments."""
    try:
        result = subprocess.run([str(skill_path)] + args, check=False)
        return result.returncode
    except Exception as e:
        print(f"  ✗ Error running skill: {e}")
        return 1

