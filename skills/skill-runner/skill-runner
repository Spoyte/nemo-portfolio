def show_help():
    """Display help information."""
    print("""
  nemo — Unified workspace CLI

  Commands:
    focus [min] [msg]    Start focus timer (default: 25 min)
    track [cmd]          Task tracking (add/done/list/rm)
    ci [cmd]             CI cycle tracking (visualize/log/stats)
    diary [text]         Quick diary entry
    memory [cmd]         Browse/search daily notes (list/show/search/stats/random)
    work [cmd]           Project context (on/add/rm/log/here/status)
    list                 List all available commands and skills
    <skill> [args...]    Run any skill from skills/

  Examples:
    nemo focus 45 "deep work"
    nemo track add "Review PR #123"
    nemo ci log refactor "Cleaned up utils"
    nemo diary "Shipped the feature"
    nemo work here         # Use current dir as project
    nemo work on portfolio # Switch context
    nemo list              # See all skills
    nemo art-audit         # Run art-audit skill
    """)

def main():
    args = sys.argv[1:]
    
    if not args:
        show_help()
        return 0
    
    command = args[0]
    command_args = args[1:]
    
    if command in ("-h", "--help", "help"):
        show_help()
        return 0
    
    # Built-in commands
    builtins = {
        "focus": cmd_focus,
        "track": cmd_track,
        "ci": cmd_ci,
        "diary": cmd_diary,
        "memory": cmd_memory,
        "work": cmd_work,
        "list": cmd_list,
    }
    
    if command in builtins:
        return builtins[command](command_args)
    
    # Try to run as a skill
    skills = discover_skills()
    if command in skills:
        return run_skill(skills[command], command_args)
    
    # Unknown command
    print(f"Unknown command: {command}")
    print(f"\nDid you mean one of these?")
    print(f"  Built-in: {', '.join(builtins.keys())}")
    if skills:
        print(f"  Skills: {', '.join(sorted(skills.keys())[:10])}")
        if len(skills) > 10:
            print(f"  ... and {len(skills) - 10} more (run 'nemo list' to see all)")
    return 1

if __name__ == "__main__":
    sys.exit(main())
