def cmd_memory(args: List[str]) -> int:
    """Memory manager — browse, search, and reflect on daily notes."""
    if not args:
        return cmd_memory_list([])
    
    command = args[0]
    command_args = args[1:]
    
    commands = {
        'list': cmd_memory_list,
        'show': cmd_memory_show,
        'search': cmd_memory_search,
        'stats': cmd_memory_stats,
        'random': cmd_memory_random,
    }
    
    if command in commands:
        return commands[command](command_args)
    else:
        print(f"  Unknown command: {command}")
        print(f"  Available: {', '.join(commands.keys())}")
        return 1

