#!/usr/bin/env bash
#
# skill-runner — Unified skill interface
# One command to discover and run all workspace skills
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# Config
SKILLS_DIR="${SKILLS_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
QUIET=false
JSON=false

# Show usage
usage() {
    cat << 'EOF'
nemo — Unified skill interface

Usage:
  nemo list [options]          List all skills
  nemo <skill> [args...]       Run a skill
  nemo info <skill>            Show skill details
  nemo docs <skill>            Read full documentation
  nemo search <query>          Find skills by keyword
  nemo exec <skill> <script>   Run specific script from skill
  nemo completion -s <shell>   Generate shell completion

Options:
  -q, --quiet       Quiet mode (names only)
  -v, --verbose     Verbose mode (with descriptions)
  -j, --json        JSON output
  -h, --help        Show this help

Examples:
  nemo list                    # List all skills
  nemo list -v                 # With descriptions
  nemo art-new flow "Flow"     # Run art-new skill
  nemo info backup-restore     # Show skill info
  nemo search git              # Find git-related skills
EOF
}

# Print error and exit
error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

# Print warning
warn() {
    $QUIET || echo -e "${YELLOW}Warning:${NC} $1" >&2
}

# Print info
info() {
    $QUIET || echo -e "$1"
}

# List all skills
list_skills() {
    local verbose=false
    local quiet=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose) verbose=true ;;
            -q|--quiet) quiet=true ;;
            -j|--json) JSON=true ;;
            *) ;;
        esac
        shift
    done
    
    if $JSON; then
        echo "["
        local first=true
        for skill_dir in "$SKILLS_DIR"/*/; do
            [[ -d "$skill_dir" ]] || continue
            local skill_name=$(basename "$skill_dir")
            local skill_md="$skill_dir/SKILL.md"
            
            if [[ -f "$skill_md" ]]; then
                local desc=$(grep -E "^description:" "$skill_md" 2>/dev/null | head -1 | sed 's/description: *"*\([^"]*\)"*/\1/')
                local has_exe=$([[ -x "$skill_dir/$skill_name" ]] && echo "true" || echo "false")
                
                if $first; then
                    first=false
                else
                    echo ","
                fi
                echo -n "  {\"name\": \"$skill_name\", \"description\": \"${desc:-}\", \"executable\": $has_exe}"
            fi
        done
        echo ""
        echo "]"
        return 0
    fi
    
    if $quiet; then
        for skill_dir in "$SKILLS_DIR"/*/; do
            [[ -d "$skill_dir" ]] || continue
            local skill_name=$(basename "$skill_dir")
            [[ -f "$skill_dir/SKILL.md" ]] && echo "$skill_name"
        done
        return 0
    fi
    
    # Header
    if ! $QUIET; then
        if $verbose; then
            echo -e "${CYAN}Available Skills${NC}"
            echo ""
        fi
    fi
    
    local count=0
    for skill_dir in "$SKILLS_DIR"/*/; do
        [[ -d "$skill_dir" ]] || continue
        local skill_name=$(basename "$skill_dir")
        local skill_md="$skill_dir/SKILL.md"
        
        if [[ -f "$skill_md" ]]; then
            local desc=$(grep -E "^description:" "$skill_md" 2>/dev/null | head -1 | sed 's/description: *"*\([^"]*\)"*/\1/' | cut -d'.' -f1)
            local exe_marker=""
            [[ -x "$skill_dir/$skill_name" ]] && exe_marker="${GREEN}⚡${NC} " || exe_marker="${GRAY}○${NC} "
            
            if $verbose; then
                printf "  %b%-20s${NC} %s\n" "$exe_marker" "$skill_name" "${desc:-No description}"
            else
                printf "  %b%s${NC}\n" "$exe_marker" "$skill_name"
            fi
            ((count++)) || true
        fi
    done
    
    if ! $QUIET && ! $verbose; then
        echo ""
        echo -e "${GRAY}Run 'nemo list -v' for descriptions${NC}"
        echo -e "${GRAY}Run 'nemo info <skill>' for details${NC}"
    fi
    
    if ! $QUIET; then
        echo ""
        echo -e "${GRAY}$count skills available${NC}"
    fi
}

# Show skill info
show_info() {
    local skill_name="$1"
    local skill_dir="$SKILLS_DIR/$skill_name"
    local skill_md="$skill_dir/SKILL.md"
    
    [[ -d "$skill_dir" ]] || error "Skill '$skill_name' not found"
    [[ -f "$skill_md" ]] || error "Skill '$skill_name' has no SKILL.md"
    
    local name=$(grep -E "^name:" "$skill_md" 2>/dev/null | head -1 | sed 's/name: *//')
    local desc=$(grep -E "^description:" "$skill_md" 2>/dev/null | head -1 | sed 's/description: *"*\([^"]*\)"*/\1/')
    local has_exe=$([[ -x "$skill_dir/$skill_name" ]] && echo -e "${GREEN}Yes${NC}" || echo -e "${RED}No${NC}")
    
    echo -e "${CYAN}$skill_name${NC}"
    echo ""
    echo -e "  Description: ${desc:-None}"
    echo -e "  Executable:  $has_exe"
    echo -e "  Location:    $skill_dir"
    
    # List available scripts
    if [[ -d "$skill_dir/scripts" ]]; then
        echo ""
        echo "Scripts:"
        for script in "$skill_dir/scripts"/*; do
            [[ -f "$script" ]] || continue
            local script_name=$(basename "$script")
            echo -e "  ${GREEN}•${NC} $script_name"
        done
    fi
}

# Show skill docs
show_docs() {
    local skill_name="$1"
    local skill_dir="$SKILLS_DIR/$skill_name"
    local skill_md="$skill_dir/SKILL.md"
    
    [[ -d "$skill_dir" ]] || error "Skill '$skill_name' not found"
    [[ -f "$skill_md" ]] || error "Skill '$skill_name' has no SKILL.md"
    
    # Strip frontmatter and display
    sed '1{/^---$/!b;:a;N;/\n---$/!ba;d}' "$skill_md" | cat
}

# Search skills
search_skills() {
    local query="$1"
    local found=false
    
    echo -e "${CYAN}Search results for '$query':${NC}"
    echo ""
    
    for skill_dir in "$SKILLS_DIR"/*/; do
        [[ -d "$skill_dir" ]] || continue
        local skill_name=$(basename "$skill_dir")
        local skill_md="$skill_dir/SKILL.md"
        
        if [[ -f "$skill_md" ]]; then
            if grep -qi "$query" "$skill_md" 2>/dev/null; then
                local desc=$(grep -E "^description:" "$skill_md" 2>/dev/null | head -1 | sed 's/description: *"*\([^"]*\)"*/\1/' | cut -d'.' -f1)
                printf "  ${GREEN}•${NC} %-20s %s\n" "$skill_name" "${desc:-}"
                found=true
            fi
        fi
    done
    
    if ! $found; then
        echo -e "  ${GRAY}No skills found matching '$query'${NC}"
    fi
}

# Execute a skill
run_skill() {
    local skill_name="$1"
    shift
    local skill_dir="$SKILLS_DIR/$skill_name"
    local skill_exe="$skill_dir/$skill_name"
    
    [[ -d "$skill_dir" ]] || error "Skill '$skill_name' not found"
    [[ -f "$skill_exe" ]] || error "Skill '$skill_name' has no executable"
    [[ -x "$skill_exe" ]] || error "Skill '$skill_name' executable is not runnable"
    
    exec "$skill_exe" "$@"
}

# Execute a specific script from a skill
exec_script() {
    local skill_name="$1"
    local script_name="$2"
    shift 2
    local skill_dir="$SKILLS_DIR/$skill_name"
    local script_path="$skill_dir/scripts/$script_name"
    
    [[ -d "$skill_dir" ]] || error "Skill '$skill_name' not found"
    [[ -f "$script_path" ]] || error "Script '$script_name' not found in skill '$skill_name'"
    [[ -x "$script_path" ]] || error "Script '$script_name' is not executable"
    
    exec "$script_path" "$@"
}

# Generate shell completion
generate_completion() {
    local shell="${1:-bash}"
    
    case "$shell" in
        bash)
            cat << 'EOF'
_nemo_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    
    # Commands
    local commands="list info docs search exec completion"
    
    # Skills
    local skills=""
    if [[ -d "$SKILLS_DIR" ]]; then
        for d in "$SKILLS_DIR"/*/; do
            [[ -d "$d" ]] || continue
            skills="$skills $(basename "$d")"
        done
    fi
    
    case "$COMP_CWORD" in
        1)
            COMPREPLY=($(compgen -W "$commands $skills" -- "$cur"))
            ;;
        2)
            case "$prev" in
                info|docs)
                    COMPREPLY=($(compgen -W "$skills" -- "$cur"))
                    ;;
                exec)
                    COMPREPLY=($(compgen -W "$skills" -- "$cur"))
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            ;;
        *)
            COMPREPLY=()
            ;;
    esac
}

complete -F _nemo_completion nemo
EOF
            ;;
        zsh)
            cat << 'EOF'
#compdef nemo

_nemo() {
    local curcontext="$curcontext" state line
    typeset -A opt_args
    
    _arguments -C \
        '1: :->command' \
        '2: :->skill' \
        '*:: :->args'
    
    case "$state" in
        command)
            local commands=(list info docs search exec completion)
            local skills=(${(f)"$(ls "$SKILLS_DIR" 2>/dev/null)"})
            _describe -t commands 'command' commands
            _describe -t skills 'skill' skills
            ;;
        skill)
            case "$line[1]" in
                info|docs|exec)
                    local skills=(${(f)"$(ls "$SKILLS_DIR" 2>/dev/null)"})
                    _describe -t skills 'skill' skills
                    ;;
            esac
            ;;
    esac
}

compdef _nemo nemo
EOF
            ;;
        *)
            error "Unknown shell: $shell (supported: bash, zsh)"
            ;;
    esac
}

# Main
declare -a ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -j|--json)
            JSON=true
            shift
            ;;
        -*)
            ARGS+=("$1")
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# Restore ARGS
set -- "${ARGS[@]}"

# No arguments = list skills
if [[ $# -eq 0 ]]; then
    list_skills
    exit 0
fi

case "$1" in
    list)
        shift
        list_skills "$@"
        ;;
    info)
        [[ $# -lt 2 ]] && error "Usage: nemo info <skill>"
        show_info "$2"
        ;;
    docs)
        [[ $# -lt 2 ]] && error "Usage: nemo docs <skill>"
        show_docs "$2"
        ;;
    search)
        [[ $# -lt 2 ]] && error "Usage: nemo search <query>"
        search_skills "$2"
        ;;
    exec)
        [[ $# -lt 3 ]] && error "Usage: nemo exec <skill> <script>"
        exec_script "$2" "$3" "${@:4}"
        ;;
    completion)
        shift
        local shell="bash"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -s|--shell) shell="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        generate_completion "$shell"
        ;;
    *)
        # Try to run as skill
        run_skill "$@"
        ;;
esac
