PROJECTS_FILE = NEMO_DIR / "projects.json"
WORK_LOG = NEMO_DIR / "work-sessions.jsonl"

def load_projects() -> Dict:
    """Load project configuration."""
    if not PROJECTS_FILE.exists():
        return {"projects": {}, "current": None}
    try:
        with open(PROJECTS_FILE) as f:
            return json.load(f)
    except:
        return {"projects": {}, "current": None}

def save_projects(projects: Dict) -> None:
    """Save project configuration."""
    with open(PROJECTS_FILE, "w") as f:
        json.dump(projects, f, indent=2)

def load_work_sessions() -> List[Dict]:
    """Load work session history."""
    sessions = []
    if WORK_LOG.exists():
        with open(WORK_LOG) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        sessions.append(json.loads(line))
                    except:
                        pass
    return sessions

def log_work_session(project: str, duration_min: int, note: str = "") -> None:
    """Log a work session."""
    session = {
        "id": hashlib.md5(str(time.time()).encode()).hexdigest()[:8],
        "timestamp": datetime.now().isoformat(),
        "project": project,
        "duration_min": duration_min,
        "note": note
    }
    with open(WORK_LOG, "a") as f:
        f.write(json.dumps(session) + "\n")

def get_project_time_today(project: str) -> int:
    """Get total minutes worked on project today."""
    today = datetime.now().strftime("%Y-%m-%d")
    sessions = load_work_sessions()
    total = 0
    for s in sessions:
        session_date = datetime.fromisoformat(s["timestamp"].replace("Z", "+00:00") if s["timestamp"].endswith("Z") else s["timestamp"]).strftime("%Y-%m-%d")
        if session_date == today and s["project"] == project:
            total += s.get("duration_min", 0)
    return total

def cmd_work(args: List[str]) -> int:
    """Project context management."""
    projects = load_projects()
    
    if not args or args[0] == "status":
        # Show current status
        print("\n  ──────── Work Context ────────")
        if projects.get("current"):
            current = projects["current"]
            proj = projects["projects"].get(current, {})
            today_min = get_project_time_today(current)
            print(f"  Current: {current}")
            if proj.get("path"):
                print(f"  Path: {proj['path']}")
            print(f"  Today: {today_min} min")
            if proj.get("description"):
                print(f"  Note: {proj['description']}")
        else:
            print("  No active project")
        
        # List all projects
        if projects["projects"]:
            print(f"\n  Projects ({len(projects['projects'])}):")
            for name, info in projects["projects"].items():
                marker = "▸ " if name == projects.get("current") else "  "
                today = get_project_time_today(name)
                print(f"    {marker}{name:<20} {today:>3}m today")
        print(f"  ─────────────────────────────\n")
        
    elif args[0] == "on":
        if len(args) < 2:
            print("Usage: nemo work on <project-name>")
            return 1
        
        name = args[1]
        if name not in projects["projects"]:
            print(f"  Project '{name}' not found. Create it with: nemo work add {name} <path>")
            return 1
        
        projects["current"] = name
        save_projects(projects)
        proj = projects["projects"][name]
        print(f"  ▶ Switched to '{name}'")
        if proj.get("path"):
            print(f"    cd {proj['path']}")
            
    elif args[0] == "add":
        if len(args) < 3:
            print("Usage: nemo work add <name> <path> [description]")
            return 1
        
        name = args[1]
        path = args[2]
        desc = " ".join(args[3:]) if len(args) > 3 else ""
        
        # Expand path
        path = os.path.expanduser(path)
        if not os.path.isabs(path):
            path = os.path.abspath(path)
        
        projects["projects"][name] = {
            "path": path,
            "description": desc,
            "created": datetime.now().isoformat()
        }
        save_projects(projects)
        print(f"  + Added project '{name}' → {path}")
        
    elif args[0] == "rm":
        if len(args) < 2:
            print("Usage: nemo work rm <name>")
            return 1
        
        name = args[1]
        if name in projects["projects"]:
            del projects["projects"][name]
            if projects.get("current") == name:
                projects["current"] = None
            save_projects(projects)
            print(f"  − Removed project '{name}'")
        else:
            print(f"  ✗ Project '{name}' not found")
            
    elif args[0] == "log":
        if len(args) < 3:
            print("Usage: nemo work log <project> <minutes> [note]")
            return 1
        
        project = args[1]
        try:
            minutes = int(args[2])
        except ValueError:
            print("  ✗ Minutes must be a number")
            return 1
        
        note = " ".join(args[3:]) if len(args) > 3 else ""
        log_work_session(project, minutes, note)
        print(f"  ✓ Logged {minutes}m on '{project}'")
        
    elif args[0] == "here":
        # Set current directory as active project
        cwd = os.getcwd()
        # Find project matching this path
        found = None
        for name, info in projects["projects"].items():
            if info.get("path") == cwd or cwd.startswith(info.get("path", "")):
                found = name
                break
        
        if found:
            projects["current"] = found
            save_projects(projects)
            print(f"  ▶ Context: {found}")
        else:
            # Create new project from current dir
            name = os.path.basename(cwd)
            projects["projects"][name] = {
                "path": cwd,
                "description": "",
                "created": datetime.now().isoformat()
            }
            projects["current"] = name
            save_projects(projects)
            print(f"  + Created '{name}' from current directory")
            
    else:
        print(f"Unknown command: {args[0]}")
        print("Usage: nemo work [status|on|add|rm|log|here]")
        return 1
    
    return 0

def load_cycles() -> List[Dict]:
    """Load CI cycles from log file."""
    cycles = []
    if CI_LOG.exists():
        with open(CI_LOG) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        cycles.append(json.loads(line))
                    except:
                        pass
    return cycles

def log_cycle(activity: str, note: Optional[str] = None) -> None:
    """Log a completed improvement cycle."""
    cycle = {
        "id": hashlib.md5(str(time.time()).encode()).hexdigest()[:8],
        "timestamp": datetime.now().isoformat(),
        "activity": activity,
        "note": note or ""
    }
    with open(CI_LOG, "a") as f:
        f.write(json.dumps(cycle) + "\n")
    
    info = ACTIVITIES.get(activity, {})
    print(f"  ✓ Logged: {info.get('emoji', '○')} {info.get('label', activity)}")

def calculate_streak(cycles: List[Dict]) -> int:
    """Calculate consecutive days with cycles."""
    if not cycles:
        return 0
    
    dates = sorted(set([
        datetime.fromisoformat(c["timestamp"].replace("Z", "+00:00") if c["timestamp"].endswith("Z") else c["timestamp"]).date()
        for c in cycles
    ]), reverse=True)
    
    if not dates:
        return 0
    
    streak = 1
    today = datetime.now().date()
    
    if dates[0] != today and dates[0] != today - timedelta(days=1):
        return 0
    
    for i in range(len(dates) - 1):
        if dates[i] - dates[i + 1] == timedelta(days=1):
            streak += 1
        else:
            break
    
    return streak

def cmd_ci(args: List[str]) -> int:
    """Continuous improvement cycle tracker."""
    cycles = load_cycles()
    
    if not args or args[0] == "visualize":
        # Show momentum board
        by_activity = defaultdict(int)
        for c in cycles:
            by_activity[c.get("activity", "unknown")] += 1
        
        week_ago = datetime.now() - timedelta(days=7)
        recent = [c for c in cycles if datetime.fromisoformat(c["timestamp"].replace("Z", "+00:00") if c["timestamp"].endswith("Z") else c["timestamp"]) > week_ago]
        streak = calculate_streak(cycles)
        
        print("\n  ╔══════════════════════════════════════════════════╗")
        print("  ║     CONTINUOUS IMPROVEMENT MOMENTUM              ║")
        print("  ╠══════════════════════════════════════════════════╣")
        
        fire = "🔥🔥🔥" if streak >= 7 else "🔥🔥" if streak >= 3 else "🔥" if streak > 0 else "○"
        print(f"  ║  Streak: {streak} days {fire:>35}║")
        print(f"  ║  Total: {len(cycles)} cycles {' '*36}║")
        print(f"  ║  Last 7 days: {len(recent)} {' '*40}║")
        print("  ╠══════════════════════════════════════════════════╣")
        
        max_count = max(by_activity.values(), default=0) or 1
        
        for act_id, info in ACTIVITIES.items():
            count = by_activity.get(act_id, 0)
            bar = "█" * min(int((count / max_count) * 15), 15)
            label = info["label"][:15].ljust(15)
            print(f"  ║  {info['emoji']} {label} {bar:<15} {count:>3} ║")
        
        print("  ╚══════════════════════════════════════════════════╝")
        
        # Suggestion
        if by_activity:
            weakest = min(ACTIVITIES.keys(), key=lambda a: by_activity.get(a, 0))
            print(f"\n  💡 Consider: More {ACTIVITIES[weakest]['label'].lower()}")
        
    elif args[0] == "log":
        if len(args) < 2:
            print("Usage: nemo ci log <activity> [note]")
            print(f"Activities: {', '.join(ACTIVITIES.keys())}")
            return 1
        
        activity = args[1]
        note = " ".join(args[2:]) if len(args) > 2 else None
        
        if activity not in ACTIVITIES:
            print(f"Unknown activity: {activity}")
            print(f"Choose from: {', '.join(ACTIVITIES.keys())}")
            return 1
        
        log_cycle(activity, note)
        
    elif args[0] == "stats":
        by_activity = defaultdict(int)
        for c in cycles:
            by_activity[c.get("activity", "unknown")] += 1
        
        print(f"\n  Total cycles: {len(cycles)}")
        print(f"  Current streak: {calculate_streak(cycles)} days")
        print(f"\n  By activity:")
        for act_id, info in ACTIVITIES.items():
            count = by_activity.get(act_id, 0)
            print(f"    {info['emoji']} {info['label']}: {count}")
    
    return 0

