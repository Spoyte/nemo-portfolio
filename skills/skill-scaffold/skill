#!/usr/bin/env bash
#
# skill — Unified OpenClaw skill manager
#
# Usage: skill <command> [options]
#
# Commands:
#   new <name> "Description"   Create a new skill
#   list [-q|-j]               List all skills
#   delete [-y] <name>         Remove a skill (moves to .trash)
#   show <name>                Show skill details
#   edit <name>                Open skill in editor
#   help                       Show this help
#
# Examples:
#   skill new web-screenshot "Web Screenshot Utility"
#   skill list
#   skill delete -y old-skill
#   skill show memory-log

set -euo pipefail

# Colors (check if stdout is a terminal)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    GRAY='\033[0;90m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    GRAY=''
    NC=''
fi

# Configuration
SKILLS_DIR="${SKILLS_DIR:-$HOME/.openclaw/workspace/skills}"

# Helper functions
log() { echo -e "$@"; }
error() { log "${RED}Error: $*${NC}" >&2; }
success() { log "${GREEN}✓ $*${NC}"; }
info() { log "${BLUE}$*${NC}"; }
warn() { log "${YELLOW}⚠ $*${NC}"; }

# Show help
show_help() {
    cat << 'EOF'
┌─────────────────────────────────────────────────────┐
│  skill — Unified OpenClaw Skill Manager             │
├─────────────────────────────────────────────────────┤
│  Commands:                                          │
│                                                     │
│    new <name> "Description"    Create a new skill   │
│    list [-q|-j]                List all skills      │
│    show <name>                 Show skill details   │
│    edit <name>                 Open skill in editor │
│    delete [-y] <name>          Remove a skill       │
│    help                        Show this help       │
│                                                     │
├─────────────────────────────────────────────────────┤
│  Examples:                                          │
│                                                     │
│    skill new web-screenshot "Screenshot Tool"       │
│    skill list                                       │
│    skill list -q               # Names only         │
│    skill show memory-log                            │
│    skill edit git-workflow                          │
│    skill delete old-experiment                      │
│    skill delete -y temp-skill  # Skip confirm       │
│                                                     │
└─────────────────────────────────────────────────────┘
EOF
}

# Command: help
cmd_help() {
    show_help
}

# Command: new — Delegate to skill-new
cmd_new() {
    local skill_new_path="$SKILLS_DIR/skill-scaffold/skill-new"
    
    if [[ ! -x "$skill_new_path" ]]; then
        error "skill-new not found at $skill_new_path"
        log "Make sure skill-scaffold is installed."
        exit 1
    fi
    
    # Pass all arguments through
    exec "$skill_new_path" "$@"
}

# Command: list — Enhanced listing
cmd_list() {
    local quiet=false
    local json=false
    local show_all=false
    
    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            -q|--quiet) quiet=true; shift ;;
            -j|--json) json=true; shift ;;
            -a|--all) show_all=true; shift ;;
            *) shift ;;
        esac
    done
    
    if [[ ! -d "$SKILLS_DIR" ]]; then
        error "Skills directory not found: $SKILLS_DIR"
        exit 1
    fi
    
    # Collect skills
    declare -a SKILLS=()
    declare -a DESCRIPTIONS=()
    declare -a COMMANDS=()
    
    while IFS= read -r skill_md; do
        local skill_dir=$(dirname "$skill_md")
        local skill_name=$(basename "$skill_dir")
        
        # Skip hidden/internal
        [[ "$skill_name" == .* ]] && continue
        
        # Extract description
        local description=$(grep -m1 "^description:" "$skill_md" 2>/dev/null | sed 's/description: *"//;s/"$//' || echo "")
        [[ -z "$description" ]] && description="No description"
        
        # Count commands (executables in skill dir)
        local cmd_count=$(find "$skill_dir" -maxdepth 1 -type f -executable 2>/dev/null | wc -l)
        
        SKILLS+=("$skill_name")
        DESCRIPTIONS+=("$description")
        COMMANDS+=("$cmd_count")
    done < <(find "$SKILLS_DIR" -name "SKILL.md" -type f 2>/dev/null | sort)
    
    # JSON output
    if [[ "$json" == "true" ]]; then
        echo "["
        for i in "${!SKILLS[@]}"; do
            printf '  {"name": "%s", "description": "%s"}' "${SKILLS[$i]}" "${DESCRIPTIONS[$i]}"
            [[ $i -lt $((${#SKILLS[@]} - 1)) ]] && echo "," || echo
        done
        echo "]"
        return 0
    fi
    
    # Quiet output
    if [[ "$quiet" == "true" ]]; then
        for skill in "${SKILLS[@]}"; do
            echo "$skill"
        done
        return 0
    fi
    
    # Pretty output
    if [[ ${#SKILLS[@]} -eq 0 ]]; then
        warn "No skills found"
        log "Create one with: ${GREEN}skill new <name> \"Description\"${NC}"
        return 0
    fi
    
    info "Available Skills"
    log "${GRAY}$(printf '─%.0s' {1..60})${NC}"
    
    for i in "${!SKILLS[@]}"; do
        printf "  ${GREEN}%-22s${NC} %s\n" "${SKILLS[$i]}" "${DESCRIPTIONS[$i]}"
    done
    
    log "${GRAY}$(printf '─%.0s' {1..60})${NC}"
    log "  Total: ${#SKILLS[@]} skills"
    log ""
    log "${GRAY}Commands: skill new|list|show|edit|delete|help${NC}"
}

# Command: show — Display skill details
cmd_show() {
    local skill_name="${1:-}"
    
    if [[ -z "$skill_name" ]]; then
        error "No skill name provided"
        log "Usage: skill show <skill-name>"
        exit 1
    fi
    
    local skill_dir="$SKILLS_DIR/$skill_name"
    local skill_md="$skill_dir/SKILL.md"
    
    if [[ ! -d "$skill_dir" ]]; then
        error "Skill '$skill_name' not found"
        log ""
        log "Available skills:"
        cmd_list -q | sed 's/^/  /'
        exit 1
    fi
    
    info "Skill: $skill_name"
    log "${GRAY}$(printf '─%.0s' {1..50})${NC}"
    
    # Show SKILL.md content if exists
    if [[ -f "$skill_md" ]]; then
        log ""
        # Extract frontmatter
        local in_frontmatter=false
        local description=""
        while IFS= read -r line; do
            if [[ "$line" == "---" ]]; then
                in_frontmatter=!$in_frontmatter
                continue
            fi
            if [[ "$line" == description:* ]]; then
                description=$(echo "$line" | sed 's/description: *"//;s/"$//')
            fi
        done < "$skill_md"
        
        [[ -n "$description" ]] && log "Description: $description"
        log ""
        
        # Show files
        log "${BLUE}Files:${NC}"
        find "$skill_dir" -type f | while read -r f; do
            local size=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo "?")
            local size_human=""
            if [[ "$size" -lt 1024 ]]; then
                size_human="${size}B"
            elif [[ "$size" -lt 1048576 ]]; then
                size_human="$(echo "scale=1; $size/1024" | bc)K"
            else
                size_human="$(echo "scale=1; $size/1048576" | bc)M"
            fi
            printf "  %-30s %8s\n" "$(basename "$f")" "$size_human"
        done
        
        log ""
        log "${BLUE}Commands:${NC}"
        find "$skill_dir" -maxdepth 1 -type f -executable | while read -r cmd; do
            log "  • $(basename "$cmd")"
        done
        
        log ""
        log "${GRAY}Location: $skill_dir${NC}"
    else
        warn "No SKILL.md found"
        log "Directory contents:"
        ls -la "$skill_dir" | tail -n +4 | sed 's/^/  /'
    fi
}

# Command: edit — Open skill in editor
cmd_edit() {
    local skill_name="${1:-}"
    
    if [[ -z "$skill_name" ]]; then
        error "No skill name provided"
        log "Usage: skill edit <skill-name>"
        exit 1
    fi
    
    local skill_dir="$SKILLS_DIR/$skill_name"
    local skill_md="$skill_dir/SKILL.md"
    
    if [[ ! -d "$skill_dir" ]]; then
        error "Skill '$skill_name' not found"
        exit 1
    fi
    
    local editor="${EDITOR:-${VISUAL:-vi}}"
    
    if [[ -f "$skill_md" ]]; then
        info "Opening $skill_name/SKILL.md in $editor..."
        exec "$editor" "$skill_md"
    else
        info "Opening $skill_name directory in $editor..."
        exec "$editor" "$skill_dir"
    fi
}

# Command: delete — Delegate to skill-delete
cmd_delete() {
    local skill_delete_path="$SKILLS_DIR/skill-scaffold/skill-delete"
    
    if [[ ! -x "$skill_delete_path" ]]; then
        error "skill-delete not found at $skill_delete_path"
        exit 1
    fi
    
    # Pass all arguments through
    exec "$skill_delete_path" "$@"
}

# Main dispatch
main() {
    # No arguments — show help
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi
    
    local cmd="${1:-}"
    shift || true
    
    case "$cmd" in
        help|--help|-h)
            cmd_help
            ;;
        new|create|add)
            cmd_new "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        show|info|cat)
            cmd_show "$@"
            ;;
        edit|open)
            cmd_edit "$@"
            ;;
        delete|rm|remove)
            cmd_delete "$@"
            ;;
        *)
            error "Unknown command: $cmd"
            log ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
