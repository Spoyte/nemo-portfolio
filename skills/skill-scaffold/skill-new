#!/usr/bin/env bash
#
# skill-new — Scaffold a new OpenClaw skill
#
# Usage: skill-new <kebab-name> "Descriptive Name"
# Example: skill-new web-screenshot "Web Screenshot Utility"

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "skill-new — Scaffold a new OpenClaw skill"
    echo ""
    echo "Usage: skill-new <kebab-name> \"Descriptive Name\""
    echo ""
    echo "Examples:"
    echo "  skill-new web-screenshot \"Web Screenshot Utility\""
    echo "  skill-new pdf-merge \"PDF Merge Tool\""
    echo ""
    echo "Creates:"
    echo "  skills/<name>/"
    echo "    ├── SKILL.md       # Documentation"
    echo "    ├── <name>         # Executable script"
    echo "    └── install.sh     # Shell integration"
    exit 0
fi

# Validate arguments
if [[ $# -lt 2 ]]; then
    echo -e "${RED}Error: Missing arguments${NC}" >&2
    echo "Usage: skill-new <kebab-name> \"Descriptive Name\"" >&2
    exit 1
fi

SKILL_NAME="$1"
SKILL_DESC="$2"

# Validate kebab-case
if [[ ! "$SKILL_NAME" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    echo -e "${RED}Error: Skill name must be kebab-case (e.g., 'web-screenshot')${NC}" >&2
    exit 1
fi

# Setup paths
SKILLS_DIR="${SKILLS_DIR:-$HOME/.openclaw/workspace/skills}"
SKILL_DIR="$SKILLS_DIR/$SKILL_NAME"

# Check if already exists
if [[ -d "$SKILL_DIR" ]]; then
    echo -e "${RED}Error: Skill '$SKILL_NAME' already exists at $SKILL_DIR${NC}" >&2
    exit 1
fi

echo -e "${BLUE}Creating skill: $SKILL_NAME${NC}"
echo -e "${BLUE}Description: $SKILL_DESC${NC}"
echo ""

# Create directory
mkdir -p "$SKILL_DIR"

# Create SKILL.md
cat > "$SKILL_DIR/SKILL.md" << EOF
---
name: $SKILL_NAME
description: "$SKILL_DESC"
---

# $(echo "$SKILL_DESC" | sed 's/.*/\u&/')

Brief description of what this skill does and when to use it.

## Quick Commands

\`\`\`bash
# Main command
$SKILL_NAME [options] <args>

# Example:
$SKILL_NAME --help
\`\`\`

## What It Does

Describe the main functionality and outputs.

## Configuration

Environment variables, config files, etc.

## Design Principles

1. **Principle one** — Why this matters
2. **Principle two** — Another key idea

---

*Add your documentation here.*
EOF

# Create main executable
cat > "$SKILL_DIR/$SKILL_NAME" << 'EOF'
#!/usr/bin/env bash
#
# SKILL_NAME — SKILL_DESC
#
# Usage: SKILL_NAME [options] <args>

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "SKILL_NAME — SKILL_DESC"
    echo ""
    echo "Usage: SKILL_NAME [options] <args>"
    echo ""
    echo "Options:"
    echo "  -h, --help     Show this help"
    echo "  -q, --quiet    Suppress output"
    exit 0
fi

# Parse arguments
QUIET=false
ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}" >&2
            exit 1
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# Main logic
log() {
    [[ "$QUIET" == "true" ]] || echo "$@"
}

error() {
    echo -e "${RED}Error: $*${NC}" >&2
}

# TODO: Implement your skill logic here
log -e "${YELLOW}TODO: Implement SKILL_NAME${NC}"

exit 0
EOF

# Replace placeholders in executable
sed -i "s/SKILL_NAME/$SKILL_NAME/g" "$SKILL_DIR/$SKILL_NAME"
sed -i "s/SKILL_DESC/$SKILL_DESC/g" "$SKILL_DIR/$SKILL_NAME"
chmod +x "$SKILL_DIR/$SKILL_NAME"

# Create install script
cat > "$SKILL_DIR/install.sh" << EOF
#!/usr/bin/env bash
#
# Install $SKILL_NAME to shell PATH

set -euo pipefail

SKILL_NAME="$SKILL_NAME"
SKILL_DIR="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" \&\& pwd)"

# Detect shell
SHELL_RC=""
if [[ -n "\${ZSH_VERSION:-}" ]] || [[ "\$SHELL" == *"zsh"* ]]; then
    SHELL_RC="\$HOME/.zshrc"
elif [[ -n "\${BASH_VERSION:-}" ]] || [[ "\$SHELL" == *"bash"* ]]; then
    SHELL_RC="\$HOME/.bashrc"
else
    echo "Unknown shell. Please manually add to your shell config:"
    echo "  export PATH=\"\$SKILL_DIR:\$PATH\""
    exit 1
fi

# Check if already installed
if grep -q "# $SKILL_NAME skill" "\$SHELL_RC" 2>/dev/null; then
    echo "$SKILL_NAME is already installed in \$SHELL_RC"
    exit 0
fi

# Add to PATH
echo "" >> "\$SHELL_RC"
echo "# $SKILL_NAME skill" >> "\$SHELL_RC"
echo "export PATH=\"\$SKILL_DIR:\$PATH\"" >> "\$SHELL_RC"

echo "Installed $SKILL_NAME to \$SHELL_RC"
echo "Run: source \$SHELL_RC"
EOF

chmod +x "$SKILL_DIR/install.sh"

# Success output
echo -e "${GREEN}✓ Created skill: $SKILL_NAME${NC}"
echo ""
echo "Files created:"
echo "  $SKILL_DIR/SKILL.md"
echo "  $SKILL_DIR/$SKILL_NAME"
echo "  $SKILL_DIR/install.sh"
echo ""
echo -e "${YELLOW}Next steps:${NC}"
echo "  1. Edit SKILL.md — Add your documentation"
echo "  2. Implement $SKILL_NAME — Core functionality"
echo "  3. Run install.sh — Add to your PATH"
echo "  4. Test it — $SKILL_NAME --help"
echo "  5. Commit — git add . && git commit -m \"feat: add $SKILL_NAME skill\""

exit 0
EOF

# Make skill-new executable
chmod +x "$SKILL_DIR/skill-new"

# Install it immediately (add to PATH for current session)
export PATH="$SKILL_DIR:$PATH"

echo -e "${GREEN}✓ skill-new is ready${NC}"
echo ""
echo "To use it now:"
echo "  export PATH=\"$SKILL_DIR:\$PATH\""
echo "  skill-new my-skill \"My New Skill\""
