def parse_registry() -> Dict[str, int]:
    """Parse the unified registry to get current category counts."""
    if not REGISTRY_PATH.exists():
        return {}
    
    content = REGISTRY_PATH.read_text()
    categories = {}
    
    # Count entries by category
    category_pattern = r'category:\s*"(\w+)"'
    for match in re.finditer(category_pattern, content):
        cat = match.group(1)
        categories[cat] = categories.get(cat, 0) + 1
    
    return categories


def calculate_gaps(current: Dict[str, int]) -> List[Idea]:
    """Calculate which ideas would best fill portfolio gaps."""
    all_ideas = []
    for cat, ideas in IDEAS_DATABASE.items():
        current_count = current.get(cat, 0)
        total = sum(current.values()) if current else 1
        
        # Calculate category deficit (target ~12% per category on average)
        target_ratio = 0.12
        current_ratio = current_count / total if total > 0 else 0
        deficit = max(0, target_ratio - current_ratio)
        
        for idea in ideas:
            # Boost score for underrepresented categories
            adjusted_score = idea.score + (deficit * 2)
            all_ideas.append(Idea(
                idea.name, idea.description, idea.category,
                idea.reason, idea.command, adjusted_score
            ))
    
    # Sort by score descending
    all_ideas.sort(key=lambda x: x.score, reverse=True)
    return all_ideas


def format_idea(idea: Idea, rank: int) -> str:
    """Format an idea for display."""
    return f"""{rank}. {idea.description} ({idea.category})
   {idea.reason}
   → {idea.command}"""


def main():
    parser = argparse.ArgumentParser(
        description="Algorithm ideation engine — suggests what to create next",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  art-ideate              # Top 5 suggestions
  art-ideate --all        # Show all ideas
  art-ideate --random     # Pick one randomly (commitment mode)
  art-ideate --category   # Show category balance
  art-ideate --json       # JSON output for scripting
        """
    )
    parser.add_argument("--all", action="store_true", help="Show all ideas")
    parser.add_argument("--category", action="store_true", help="Show category balance")
    parser.add_argument("--random", action="store_true", help="Pick one random idea")
    parser.add_argument("--json", action="store_true", help="Output as JSON")
    parser.add_argument("--count", type=int, default=5, help="Number of ideas (default: 5)")
    
    args = parser.parse_args()
    
    # Parse current portfolio
    current = parse_registry()
    total = sum(current.values())
    
    if args.json:
        output = {
            "total_algorithms": total,
            "categories": current,
            "ideas": []
        }
        if args.category:
            print(json.dumps(output, indent=2))
            return
        
        gaps = calculate_gaps(current)
        count = len(gaps) if args.all else args.count
        for idea in gaps[:count]:
            output["ideas"].append({
                "name": idea.name,
                "description": idea.description,
                "category": idea.category,
                "reason": idea.reason,
                "command": idea.command,
                "score": round(idea.score, 2)
            })
        print(json.dumps(output, indent=2))
        return
    
    # Category balance view
    if args.category:
        print(f"\n🎨 Portfolio: {total} algorithms")
        print("\n📊 Category Balance")
        print("-" * 40)
        
        all_categories = set(current.keys()) | set(IDEAS_DATABASE.keys())
        for cat in sorted(all_categories):
            count = current.get(cat, 0)
            pct = (count / total * 100) if total > 0 else 0
            bar = "█" * int(pct / 3)
            print(f"  {cat:15} {bar:20} {count:3} ({pct:.0f}%)")
        return
    
    # Random mode
    if args.random:
        gaps = calculate_gaps(current)
        # Weight by score for better random picks
        weights = [idea.score for idea in gaps]
        idea = random.choices(gaps, weights=weights, k=1)[0]
        
        print(f"\n🎲 Random Selection")
        print("=" * 50)
        print(f"\n{idea.description} ({idea.category})")
        print(f"\n{idea.reason}")
        print(f"\n💡 Create it:")
        print(f"   {idea.command}")
        print(f"\n🚀 Next steps:")
        print(f"   1. Run the command above")
        print(f"   2. Implement the algorithm")
        print(f"   3. git add . && git commit -m 'feat(art): add {idea.name}'")
        return
    
    # Standard output
    print(f"\n🎨 Portfolio: {total} algorithms analyzed")
    
    gaps = calculate_gaps(current)
    count = len(gaps) if args.all else args.count
    
    print(f"\n💡 Top {count} Ideas")
    print("-" * 50)
    
    for i, idea in enumerate(gaps[:count], 1):
        print(f"\n{format_idea(idea, i)}")
    
    if not args.all:
        print(f"\n📋 Run 'art-ideate --all' to see all {len(gaps)} ideas")
        print("🎲 Run 'art-ideate --random' to pick one")


if __name__ == "__main__":
    main()
