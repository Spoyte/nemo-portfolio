python3 << PYTHON_SCRIPT
import re
from datetime import datetime

metadata_file = "$METADATA_FILE"
kebab_name = "$KEBAB_NAME"
category = "$CATEGORY"
display_name = "$DISPLAY_NAME"

with open(metadata_file, 'r') as f:
    content = f.read()

# Determine tags based on category
tag_map = {
    "mathematical": ["animated", "geometric", "detailed"],
    "natural": ["animated", "organic", "nature"],
    "physics": ["animated", "chaotic", "detailed"],
    "geometric": ["animated", "geometric", "ordered"],
    "abstract": ["animated", "chaotic", "abstract"],
    "traditional": ["animated", "detailed", "colorful"],
    "text": ["animated", "colorful", "futuristic"],
    "3d": ["animated", "3d", "detailed", "futuristic"],
    "interactive": ["animated", "interactive", "colorful"],
}
tags = tag_map.get(category, ["animated", "colorful"])
tags_str = ', '.join([f'"{t}"' for t in tags])

# Determine complexity
complexity_map = {
    "mathematical": "complex",
    "natural": "moderate",
    "physics": "complex",
    "geometric": "moderate",
    "abstract": "moderate",
    "traditional": "complex",
    "text": "moderate",
    "3d": "expert",
    "interactive": "complex",
}
complexity = complexity_map.get(category, "moderate")

today = datetime.now().strftime("%Y-%m-%d")

# Create new metadata entry
new_metadata = f'''  "{kebab_name}": {{
    category: "{category}",
    complexity: "{complexity}",
    tags: [{tags_str}],
    created: "{today}",
  }},'''

# Find the category section in metadata
# Look for // === CATEGORY === or similar
# Or find a good insertion point - after the last entry of the same category

# Find the end of ARTWORK_METADATA object
# Look for the pattern: }; (possibly with whitespace)
closing_match = re.search(r'\n};', content)
if closing_match:
    insert_pos = closing_match.start()
    new_content = content[:insert_pos] + "\n" + new_metadata + content[insert_pos:]
    
    with open(metadata_file, 'w') as f:
        f.write(new_content)
    print(f"Added metadata for {kebab_name}")
else:
    # Try alternative: find the last }; in the file
    last_close = content.rfind('};')
    if last_close != -1:
        insert_pos = last_close
        new_content = content[:insert_pos] + "\n" + new_metadata + content[insert_pos:]
        with open(metadata_file, 'w') as f:
            f.write(new_content)
        print(f"Added metadata for {kebab_name}")
    else:
        print("Could not find insertion point in metadata.ts")
PYTHON_SCRIPT

echo -e "${GREEN}✓ Updated metadata.ts${NC}"

# ============================================================================
# Update index.ts - Add static import
# ============================================================================
echo -e "${CYAN}→ Updating index.ts...${NC}"

python3 << PYTHON_SCRIPT
import re

index_file = "$INDEX_FILE"
kebab_name = "$KEBAB_NAME"
camel_name = "$CAMEL_NAME"
category = "$CATEGORY"

with open(index_file, 'r') as f:
    content = f.read()

# Find the category import section
# Pattern: // === CATEGORY (count) ===
category_pattern = rf"(// === {category.upper()} \([^)]+\) ===)"
match = re.search(category_pattern, content)

if match:
    # Find the end of imports in this section (next // === or the generators map)
    section_start = match.end()
    next_section = re.search(r"\n// === [A-Z]+|\n// =", content[section_start:])
    
    if next_section:
        insert_pos = section_start + next_section.start()
    else:
        # Find before the generators map comment
        gen_map = content.find("// ============================================================================")
        insert_pos = gen_map if gen_map != -1 else len(content)
    
    # Create import line
    import_line = f'import {{ {camel_name} }} from "./{kebab_name}";'
    
    # Insert
    new_content = content[:insert_pos] + "\n" + import_line + content[insert_pos:]
    
    with open(index_file, 'w') as f:
        f.write(new_content)
    
    print(f"Added import for {kebab_name}")
else:
    print(f"Category section not found in index.ts")
    # Add to end of imports section
    # Find the last import before the generators map
    gen_map = content.find("const rawGenerators")
    if gen_map != -1:
        # Find last import before this
        last_import = content.rfind("import {", 0, gen_map)
        if last_import != -1:
            # Find end of that line
            line_end = content.find("\n", last_import)
            import_line = f'import {{ {camel_name} }} from "./{kebab_name}";'
            new_content = content[:line_end+1] + import_line + "\n" + content[line_end+1:]
            with open(index_file, 'w') as f:
                f.write(new_content)
            print(f"Added import for {kebab_name} at end of imports")
PYTHON_SCRIPT

