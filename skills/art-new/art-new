#!/usr/bin/env bash
#
# art-new — Complete generative art scaffolding with automatic registry integration
# Usage: art-new <kebab-name> "Descriptive Name" [category]
#
# Automatically:
# 1. Creates generator file with proper template
# 2. Creates thumbnail variant
# 3. Updates unified-registry.ts with new entry
# 4. Updates metadata.ts with artwork metadata
# 5. Updates index.ts with static import
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Paths
ART_DIR="/root/.openclaw/workspace/nemo-portfolio/my-app/lib/art"
REGISTRY_FILE="$ART_DIR/unified-registry.ts"
METADATA_FILE="$ART_DIR/metadata.ts"
INDEX_FILE="$ART_DIR/index.ts"

# Category options
CATEGORIES=("mathematical" "natural" "physics" "geometric" "abstract" "traditional" "text" "3d" "interactive")

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo -e "${BLUE}art-new — Complete generative art scaffolding${NC}"
    echo ""
    echo "Usage:"
    echo "  art-new <kebab-name> \"Descriptive Name\" [category]"
    echo ""
    echo "Categories:"
    for i in "${!CATEGORIES[@]}"; do
        echo "  $((i+1))) ${CATEGORIES[$i]}"
    done
    echo ""
    echo "Examples:"
    echo "  art-new neural-flow \"Neural Flow Fields\" 5"
    echo "  art-new reaction-diffusion \"Reaction Diffusion Patterns\""
    exit 0
fi

# Validate arguments
if [[ $# -lt 2 ]]; then
    echo -e "${RED}Error: Missing arguments${NC}"
    echo "Usage: art-new <kebab-name> \"Descriptive Name\" [category]"
    exit 1
fi

KEBAB_NAME="$1"
DISPLAY_NAME="$2"
CATEGORY_INPUT="${3:-}"

# Convert kebab to camelCase for function names
CAMEL_NAME=$(echo "$KEBAB_NAME" | sed -E 's/-([a-z])/\U\1/g; s/^([A-Z])/\L\1/')
# Convert kebab to PascalCase for type names
PASCAL_NAME=$(echo "$KEBAB_NAME" | sed -E 's/(^|-)([a-z])/\U\2/g')
# Convert kebab to snake_case for render function
SNAKE_NAME=$(echo "$KEBAB_NAME" | tr '-' '_')

# Check if file already exists
if [[ -f "$ART_DIR/$KEBAB_NAME.ts" ]]; then
    echo -e "${RED}Error: $KEBAB_NAME.ts already exists${NC}"
    exit 1
fi

# Get category
if [[ -n "$CATEGORY_INPUT" && "$CATEGORY_INPUT" =~ ^[0-9]+$ ]]; then
    CATEGORY_IDX=$((CATEGORY_INPUT - 1))
    if [[ $CATEGORY_IDX -ge 0 && $CATEGORY_IDX -lt ${#CATEGORIES[@]} ]]; then
        CATEGORY="${CATEGORIES[$CATEGORY_IDX]}"
    else
        echo -e "${RED}Error: Invalid category number${NC}"
        exit 1
    fi
elif [[ -n "$CATEGORY_INPUT" ]]; then
    # Check if valid category name
    CATEGORY=""
    for cat in "${CATEGORIES[@]}"; do
        if [[ "$cat" == "$CATEGORY_INPUT" ]]; then
            CATEGORY="$cat"
            break
        fi
    done
    if [[ -z "$CATEGORY" ]]; then
        echo -e "${RED}Error: Invalid category '$CATEGORY_INPUT'${NC}"
        echo "Valid categories: ${CATEGORIES[*]}"
        exit 1
    fi
else
    # Interactive category selection
    echo -e "${BLUE}Select category:${NC}"
    for i in "${!CATEGORIES[@]}"; do
        echo "  $((i+1))) ${CATEGORIES[$i]}"
    done
    read -p "Enter number (1-${#CATEGORIES[@]}): " CATEGORY_NUM
    
    CATEGORY_IDX=$((CATEGORY_NUM - 1))
    if [[ $CATEGORY_IDX -ge 0 && $CATEGORY_IDX -lt ${#CATEGORIES[@]} ]]; then
        CATEGORY="${CATEGORIES[$CATEGORY_IDX]}"
    else
        echo -e "${RED}Invalid category${NC}"
        exit 1
    fi
fi

echo -e "${GREEN}Creating $DISPLAY_NAME ($KEBAB_NAME) in category: $CATEGORY${NC}"

# ============================================================================
# Create main generator file
# ============================================================================
cat > "$ART_DIR/$KEBAB_NAME.ts" << EOF
import { ArtGenerator, GeneratorContext, ExportOptions } from "./core";

export interface ${PASCAL_NAME}Params {
  // Visual parameters
  density: number;        // 10-100: Pattern density
  speed: number;          // 0.1-5: Animation speed
  colorScheme: "neon" | "pastel" | "monochrome" | "warm" | "cool";
  complexity: "simple" | "moderate" | "complex";
  animated: boolean;
}

export const ${CAMEL_NAME}DefaultParams: ${PASCAL_NAME}Params = {
  density: 50,
  speed: 1,
  colorScheme: "neon",
  complexity: "moderate",
  animated: true,
};

export function render${PASCAL_NAME}(
  ctx: CanvasRenderingContext2D,
  params: Partial<${PASCAL_NAME}Params> = {},
  time: number = 0
): void {
  const config = { ...${CAMEL_NAME}DefaultParams, ...params };
  const { width, height } = ctx.canvas;

  // Color palettes
  const palettes: Record<string, string[]> = {
    neon: ["#FF006E", "#FB5607", "#FFBE0B", "#8338EC", "#3A86FF"],
    pastel: ["#FFB5BA", "#FFDFBA", "#FFFFBA", "#BAFFC9", "#BAE1FF"],
    monochrome: ["#000000", "#333333", "#666666", "#999999", "#CCCCCC"],
    warm: ["#FF6B35", "#F7931E", "#FFD23F", "#EE4266", "#540D6E"],
    cool: ["#3B82F6", "#06B6D4", "#10B981", "#8B5CF6", "#6366F1"],
  };
  const colors = palettes[config.colorScheme] || palettes.neon;

  // Clear with dark background
  ctx.fillStyle = "#0a0a0a";
  ctx.fillRect(0, 0, width, height);

  // Center point
  const centerX = width / 2;
  const centerY = height / 2;
  const maxRadius = Math.min(width, height) * 0.45;

  // Animation time factor
  const t = config.animated ? time * config.speed * 0.001 : 0;

  // TODO: Implement your algorithm here
  // This is a starter pattern - replace with your creative vision!

  const numElements = Math.floor(config.density * 2);
  
  for (let i = 0; i < numElements; i++) {
    const angle = (i / numElements) * Math.PI * 2 + t;
    const radius = (i / numElements) * maxRadius * (0.5 + 0.5 * Math.sin(t + i * 0.1));
    
    const x = centerX + Math.cos(angle) * radius;
    const y = centerY + Math.sin(angle) * radius;
    
    const size = 3 + (i / numElements) * 15;
    
    ctx.beginPath();
    ctx.arc(x, y, size, 0, Math.PI * 2);
    ctx.fillStyle = colors[i % colors.length];
    ctx.globalAlpha = 0.7;
    ctx.fill();
    
    // Connect to center for complexity
    if (config.complexity !== "simple") {
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.lineTo(x, y);
      ctx.strokeStyle = colors[i % colors.length];
      ctx.globalAlpha = 0.2;
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  // Reset alpha
  ctx.globalAlpha = 1;
}

// Backward compatibility: ArtGenerator interface
export const ${CAMEL_NAME}: ArtGenerator = {
  id: "${KEBAB_NAME}",
  name: "${DISPLAY_NAME}",
  category: "${CATEGORY}",
  render: (ctx, params, time) => render${PASCAL_NAME}(ctx, params as ${PASCAL_NAME}Params, time),
  defaultParams: ${CAMEL_NAME}DefaultParams,
};

export default ${CAMEL_NAME};
EOF

echo -e "${GREEN}✓ Created $KEBAB_NAME.ts${NC}"

# ============================================================================
# Create thumbnail variant
# ============================================================================
cat > "$ART_DIR/$KEBAB_NAME-thumb.ts" << EOF
import { ArtGenerator } from "./core";
import { render${PASCAL_NAME}, ${CAMEL_NAME}DefaultParams } from "./${KEBAB_NAME}";

export function render${PASCAL_NAME}Thumb(
  ctx: CanvasRenderingContext2D,
  time: number = 0
): void {
  // Simplified version for thumbnails - static, faster rendering
  render${PASCAL_NAME}(ctx, { 
    ...${CAMEL_NAME}DefaultParams, 
    animated: false,
    density: 30,  // Reduced for performance
    complexity: "simple"
  }, time);
}

// ArtGenerator interface for thumbnail
export const ${CAMEL_NAME}Thumb: ArtGenerator = {
  id: "${KEBAB_NAME}-thumb",
  name: "${DISPLAY_NAME} (Thumbnail)",
  category: "${CATEGORY}",
  render: (ctx, _params, time) => render${PASCAL_NAME}Thumb(ctx, time),
  defaultParams: ${CAMEL_NAME}DefaultParams,
};

export default ${CAMEL_NAME}Thumb;
EOF

echo -e "${GREEN}✓ Created $KEBAB_NAME-thumb.ts${NC}"

# ============================================================================
# Update unified-registry.ts
# ============================================================================
echo -e "${CYAN}→ Updating unified-registry.ts...${NC}"

# Find the category section and add new entry
# We need to insert before the next category or at end of current category

# Create a temporary file with the new entry
NEW_ENTRY=$(cat << EOF
  {
    id: "${KEBAB_NAME}",
    name: "${DISPLAY_NAME}",
    description: "TODO: Add description for ${DISPLAY_NAME}",
    category: "${CATEGORY}",
    loader: () => import("./${KEBAB_NAME}"),
    renderFnName: "render${PASCAL_NAME}",
    importName: "${CAMEL_NAME}",
  },
EOF
)

# Use Python for reliable multi-line text manipulation
python3 << PYTHON_SCRIPT
import re

registry_file = "$REGISTRY_FILE"
kebab_name = "$KEBAB_NAME"
category = "$CATEGORY"
camel_name = "$CAMEL_NAME"
pascal_name = "$PASCAL_NAME"
display_name = "$DISPLAY_NAME"

with open(registry_file, 'r') as f:
    content = f.read()

# Find the category section
# Pattern: // === CATEGORY (count) ===
category_pattern = rf"(// === {category.upper()} \(\d+\) ===)"
match = re.search(category_pattern, content)

if match:
    # Find the end of this category section (next // === or end of array)
    section_start = match.end()
    next_section = re.search(r"\n// === [A-Z]+", content[section_start:])
    
    if next_section:
        insert_pos = section_start + next_section.start()
    else:
        # Find the last entry before the closing of the array
        # Look for the last }, before ]
        last_bracket = content.rfind("];")
        # Find the last }, before that
        last_entry = content.rfind("},", section_start, last_bracket)
        if last_entry != -1:
            insert_pos = last_entry + 2
        else:
            insert_pos = section_start
    
    # Create new entry
    new_entry = f'''  {{
    id: "{kebab_name}",
    name: "{display_name}",
    description: "TODO: Add description for {display_name}",
    category: "{category}",
    loader: () => import("./{kebab_name}"),
    renderFnName: "render{pascal_name}",
    importName: "{camel_name}",
  }},'''
    
    # Insert the new entry
    new_content = content[:insert_pos] + "\n" + new_entry + content[insert_pos:]
    
    # Update the count in the category header
    count_match = re.search(rf"// === {category.upper()} \((\d+)\) ===", new_content)
    if count_match:
        old_count = int(count_match.group(1))
        new_count = old_count + 1
        new_content = new_content[:count_match.start()] + f"// === {category.upper()} ({new_count}) ===" + new_content[count_match.end():]
    
    with open(registry_file, 'w') as f:
        f.write(new_content)
    
    print(f"Added {kebab_name} to {category} category")
else:
    print(f"Category {category} not found, adding to end")
    # Add to end before the closing bracket
    insert_pos = content.rfind("];")
    new_entry = f'''  {{
    id: "{kebab_name}",
    name: "{display_name}",
    description: "TODO: Add description for {display_name}",
    category: "{category}",
    loader: () => import("./{kebab_name}"),
    renderFnName: "render{pascal_name}",
    importName: "{camel_name}",
  }},'''
    new_content = content[:insert_pos] + new_entry + "\n" + content[insert_pos:]
    with open(registry_file, 'w') as f:
        f.write(new_content)
PYTHON_SCRIPT

echo -e "${GREEN}✓ Updated unified-registry.ts${NC}"

# ============================================================================
# Update metadata.ts
# ============================================================================
